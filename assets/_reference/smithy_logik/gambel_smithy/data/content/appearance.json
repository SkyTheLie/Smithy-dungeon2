			"ears": [
				"elf_long",
				"elf_short",
				"elf_flat"
			],
			"no_hair": false
		},
		"kleidung": "outfits: Kleidung (name, base = Basis-Figur; fixed = feste Figur einer bestimmten Person, z. B. Bruno und Gustav aus PixelLab: ohne Haar-/Augen-Teile und Farben, nicht im Charakter-Editor und nicht für Zufallsfiguren, Größe immer normal; battle_look = Baukasten-Werte, mit denen die Figur im Kampf gezeichnet wird, damit sie alle Kampf-Posen hat). clothes_colors: Farben für das Hauptkleidungsstück (5 Töne hell » dunkel), gilt für Kleidung mit Kleidungs-Marker (Tunika, Weste; die Schmiede-Schürze bleibt braun)."

[resource]
script = ExtResource("1_quest")
title = "Eine Axt für den Holzfäller"
giver_name = "Holger"
location = "Wald – an seiner Hütte (Dorfplatz » Süden » Dorftor » Kreuzung » Westen)"
description = "Holgers Axt ist zerbrochen. Schmiede ihm eine Holzfälleraxt aus Kupfer:
1. Kupferbarren am Gussofen (Reiter „Zubehör“) in die Gussform „Kupfer-Holzfälleraxtkopf“ gießen
2. Am Amboss zum Axtkopf schmieden, im Wassertrog abkühlen
3. An der Werkbank unter „Zubehör“ einen Holzstiel aus Holz schnitzen
4. An der Werkbank unter „Zubehör“ » Werkzeug Kopf und Stiel zur Holzfälleraxt verbinden
Eine zweite Holzfälleraxt kannst du dir selbst anlegen (Charakter-Fenster, Axt-Platz) und damit Bäume fällen."
requirement_name = "Holzfälleraxt"
required_item_id = "lumber_axe"
required_part_id = "copper_lumber_axe_head"
offer_text = "Meine alte Axt ist mir gestern zerbrochen. Die Schmiede in der Stadt wollen mehr Gold, als ich habe ... Kannst du mir eine Holzfälleraxt aus Kupfer schmieden? Bezahlen kann ich dich nicht, aber ich lass mir was einfallen."
reminder_text = "Ohne Axt kann ich kein Holz schlagen. Kupferbarren gießen, Axtkopf schmieden, Stiel schnitzen – du schaffst das!"
done_text = "Die ist ja großartig! Danke dir, Schmied. Ab jetzt bring ich dir jeden Morgen ein Stück Holz – du findest es in der Loot-Kiste vor deiner Schmiede.

Und wenn du mehr Holz brauchst: Von hier geht es nach Norden in den tiefen Wald, dort kannst du selbst Bäume fällen. Dafür brauchst du aber eine eigene Axt – schmied dir einfach noch so eine und leg sie im Charakter-Fenster an."
after_text = "Die Axt schlägt sich prächtig! Dein Holz liegt jeden Morgen in deiner Loot-Kiste. Mehr Holz gibt es im tiefen Wald im Norden – mit einer eigenen Axt."
rewards = Array[ExtResource("2_reward")]([SubResource("QuestReward_exp"), SubResource("QuestReward_wood")])
unlock_recipe_ids = Array[String]([])

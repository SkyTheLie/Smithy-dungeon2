{
	"_hilfe": {
		"info": "Sockel-Boni für Ausrüstung. Jedes Ausrüstungsteil kann bis zu 4 Sockel haben, in jedem steckt ein Bonus mit einer Stufe (1-9). Wie die Boni ins Item kommen, kommt später. Anleitung: docs/CONTENT.md, Abschnitt sockets.json. Dieser Block wird vom Spiel ignoriert.",
		"felder": {
			"name": "Name im Tooltip, z. B. 'Wucht' (dann steht dort 'Wucht 3: +12 % Stumpf-Schaden')",
			"effect": "Was der Bonus macht, siehe 'effekte'",
			"kind": "nur bei extra_damage und resistance: Schadensart (physical, stab, blunt, slash, fire, water, earth, air, dark, light, lightning, ice, poison, magic, true)",
			"attribute": "nur bei attribute: str, agi, con, int, wis, res",
			"levels": "Wert pro Stufe, 1 bis 9 Zahlen. [2, 4, 5, 6, 8] = Stufe 1 bis 5",
			"chances": "Gewicht pro Stufe, gleich viele Zahlen wie levels. [30, 20, 20, 20, 10] = 30 % Stufe 1, 10 % Stufe 5 (muss nicht 100 ergeben, wird umgerechnet)",
			"slots": "Wo der Bonus hinein darf: Item-Typen (weapon, shield, armor, helmet, shoulders, boots, gloves, cloak, legs, necklace, ring, shoes ...), Gruppen (armor_all = alle Rüstungsteile ohne Schild, jewelry = Halskette + Ring, hero_equipment = alles, was ein Held trägt) oder ein Waffentyp aus weapon_types.json mit 'weapon:', z. B. 'weapon:hammer'",
			"enchant": "true = kommt nur über Verzauberungstränke (Mörser, mortar.json) ins Item, nie zufällig in einen Sockel; Stufe = Seltenheit des Tranks (R1 = Stufe 1)"
		},
		"effekte": {
			"extra_damage": "Waffe: +Wert % des Waffenschadens zusätzlich als Schaden von 'kind'. Kupferschwert 10-15 Schnitt + Wucht 20 = 10-15 Schnitt und 2-3 Stumpf",
			"damage_percent": "Waffe: +Wert % Schaden (Schadensarten bleiben gleich)",
			"attribute": "+Wert Punkte im Attribut",
			"resistance": "+Wert Resistenz gegen 'kind'",
			"armor_percent": "+Wert % Rüstung des Teils",
			"magic_resistance": "+Wert Magieresistenz",
			"crit_chance": "+Wert % Krit-Chance",
			"crit_damage": "+Wert % Krit-Schaden",
			"attack_speed": "Waffe: +Wert % Angriffstempo (10 = 1,1-mal so schnell, z. B. Federtrank aus Harpyienfedern)"
		},

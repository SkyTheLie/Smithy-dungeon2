[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://scenes/ui/menus/calendar_menu.gd" id="1_menu"]
[ext_resource type="PackedScene" path="res://scenes/ui/window_title_bar.tscn" id="90_title_bar"]

[node name="CalendarMenu" type="CanvasLayer"]
script = ExtResource("1_menu")
title = "Kalender"

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -90.0
offset_top = 30.0
offset_right = 90.0
offset_bottom = 200.0
grow_horizontal = 2

[node name="VBox" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="TitleBar" parent="Panel/VBox" instance=ExtResource("90_title_bar")]
unique_name_in_owner = true
layout_mode = 2

[node name="Header" type="HBoxContainer" parent="Panel/VBox"]
layout_mode = 2

[node name="PreviousButton" type="Button" parent="Panel/VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = "<"

[node name="MonthLabel" type="Label" parent="Panel/VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 3
theme_override_colors/font_color = Color(0.95, 0.8, 0.5, 1)
horizontal_alignment = 1

[node name="NextButton" type="Button" parent="Panel/VBox/Header"]
unique_name_in_owner = true
layout_mode = 2
focus_mode = 0
text = ">"

[node name="Grid" type="GridContainer" parent="Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
size_flags_horizontal = 4
theme_override_constants/h_separation = 0
theme_override_constants/v_separation = 0

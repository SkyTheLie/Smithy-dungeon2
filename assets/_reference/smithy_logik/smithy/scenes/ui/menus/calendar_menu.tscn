[node name="NotesTitle" type="Label" parent="Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.6, 0.56, 1)
text = "Vermerke"

[node name="Scroll" type="ScrollContainer" parent="Panel/VBox"]
custom_minimum_size = Vector2(160, 40)
layout_mode = 2
horizontal_scroll_mode = 0

[node name="Notes" type="VBoxContainer" parent="Panel/VBox/Scroll"]

[gd_scene load_steps=4 format=3]

[ext_resource type="Script" path="res://scenes/ui/menus/guild_menu.gd" id="1_menu"]
[ext_resource type="PackedScene" path="res://scenes/ui/window_title_bar.tscn" id="90_title_bar"]

[node name="GuildMenu" type="CanvasLayer"]
script = ExtResource("1_menu")
title = "Abenteurergilde"

[node name="Panel" type="PanelContainer" parent="."]
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -130.0
offset_top = 24.0
offset_right = 130.0
offset_bottom = 150.0
grow_horizontal = 2

[node name="VBox" type="VBoxContainer" parent="Panel"]
layout_mode = 2
theme_override_constants/separation = 4

[node name="TitleBar" parent="Panel/VBox" instance=ExtResource("90_title_bar")]
unique_name_in_owner = true
layout_mode = 2

[node name="Intro" type="Label" parent="Panel/VBox"]
layout_mode = 2
theme_override_colors/font_color = Color(0.62, 0.6, 0.56, 1)
theme_override_font_sizes/font_size = 11
text = "Helden suchen Arbeit. Einmal bezahlen, dann kämpfen sie für dich."

[node name="HeroList" type="VBoxContainer" parent="Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_constants/separation = 4

[node name="MessageLabel" type="Label" parent="Panel/VBox"]
unique_name_in_owner = true
layout_mode = 2
theme_override_font_sizes/font_size = 11

class_name RecipeData
extends Resource
## A crafting recipe: ingredients -> result. Generated by ContentDB from the items (and
## recipes.json); `station` says where it is made (forge, anvil, workbench).

## Tab in structured station menus (forge). New tabs only at the end.
## ENCHANT = enchanting table (recipes for it come later).
enum Tab { WEAPON, ARMOR, JEWELRY, EXTRA, ENCHANT, ARROWS }

const TAB_NAMES: Array[String] = ["Waffe", "Rüstung", "Schmuck", "Zubehör", "Verzaubern", "Pfeile"]
## Tabs a station menu shows when it does not choose its own.
const DEFAULT_TABS: Array[Tab] = [Tab.WEAPON, Tab.ARMOR, Tab.JEWELRY, Tab.EXTRA]
const DEFAULT_CATEGORY: String = "Sonstiges"

## Unique name, e.g. "mold_iron_blade" (also used in save files).
@export var id: StringName
## Station that offers it: "forge", "anvil", "workbench" or "enchanting_table".
@export var station: StringName
## Optional name shown in menus (e.g. "Schwert" at the workbench). Empty = name of the result.
@export var display_name: String = "":
	get:
		return Language.translate(display_name)
@export var ingredients: Array[Ingredient] = []
@export var result: ItemData
@export var result_amount: int = 1
## true = the result comes out glowing (anvil) and must be cooled in the water trough.
@export var result_is_hot: bool = false
## Tab and category in structured station menus, e.g. WEAPON / "Schwerter".
@export var tab: Tab = Tab.WEAPON
## Category inside the tab. Empty = "Sonstiges". Categories appear as soon as a recipe uses them.
@export var category: String = ""
## false = must be unlocked first (e.g. as dungeon loot, see GameState.unlock_recipe).
@export var unlocked_by_default: bool = true
## Recipes with the same group are listed as one entry with this name (e.g. "Eisen-Zauberstab");
## the station window picks the recipe from the placed items (see AssemblyMenu).
@export var group: String = ""
## Name of the slot whose item differs between the recipes of a group (e.g. "Kristall").
@export var group_slot_name: String = ""


func get_display_name() -> String:
	return display_name if display_name != "" else result.display_name


## Name in lists that show a group as one entry: the group (e.g. "Eisen-Zauberstab"), else the name.
func get_list_name() -> String:
	return group if group != "" else get_display_name()


## The recipes with one entry per group (the first of each group stands for all, like the station
## windows do), e.g. the nine iron staffs of a new mold become "Eisen-Zauberstab".
static func collapse_groups(recipes: Array[RecipeData]) -> Array[RecipeData]:
	var list: Array[RecipeData] = []
	var groups: Array[String] = []
	for recipe in recipes:
		if recipe.group != "":
			if groups.has(recipe.group):
				continue
			groups.append(recipe.group)
		list.append(recipe)
	return list


func get_category() -> String:
	return category if category != "" else Language.translate(DEFAULT_CATEGORY)


## Forge recipes "mold_<part id>": the part the mold is for (e.g. copper_blade), otherwise null.
func get_mold_part() -> ItemData:
	if station != &"forge" or not String(id).begins_with("mold_"):
		return null
	var part_id: String = String(id).trim_prefix("mold_")
	return ContentDB.item(part_id) if ContentDB.has_item(part_id) else null


## Icon for lists (recipe book, rewards, shops): molds get their mold icon (ItemIcons.mold),
## everything else the icon of its result.
func get_icon() -> Texture2D:
	var part: ItemData = get_mold_part()
	if part:
		return ItemIcons.mold(part)
	return result.icon if result else null

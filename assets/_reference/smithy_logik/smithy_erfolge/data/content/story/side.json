	"side_tasks": {
		"hagen_sword": {
			"title": "Ein Schwert für Hagen",
			"text": "Hagen, ein Krieger in der Schmiedegasse von Leonheim (von der Einkaufsstraße nach Osten), hat in keiner Schmiede ein seltenes Eisenschwert bekommen. Schmiede ihm ein Schwert mit Eisenklinge in der Seltenheit Selten oder besser und bring es ihm im Inventar. Tipp: Ein Mondglanz-Trank (3 Mondlilien + Phiole im Mörser) hebt die Qualität um eine ganze Stufe.",
			"start_flag": "hagen_sword_accepted",
			"done_flag": "hagen_sword_paid",
			"complete_flag": "hagen_sword_given",
			"complete_text": "Hagen hat sein Schwert! Hol dir deinen Lohn bei ihm.",

		"bronze_question": {
			"title": "Was ist Bronze?",
			"text": "Du hast etwas aus Bronze bekommen und weißt nicht so recht, was das für ein Metall ist. Frag Gustav, den Bergmann vor der Mine (Dorfplatz » Süden » Dorftor » Südweg » Osten).",
			"start_flag": "bronze_found",
			"done_flag": "bronze_explained"
		},
		"bronze_delivery": {
			"title": "Ein Bronzebarren für Gustav",
			"text": "Bronze ist eine Legierung aus Kupfer und Eisen. Leg an der Schmelze unter Legieren einen Kupferbarren und einen Eisenbarren hinein und bring Gustav vor der Mine den Bronzebarren. Er zahlt 150 Gold.",
			"start_flag": "bronze_explained",
			"done_flag": "bronze_delivered",
			"show_items": "bronze_ingot"
		},
		"copper_set": {
			"title": "Ein Kupferset für die Gilde",
			"text": "Hedwig will ein komplettes Kupferset: eine Waffe, einen Helm, eine Rüstung, Handschuhe, einen Beinschutz, Stiefel und einen Schulterschutz, jeweils mit Kupfer geschmiedet. Die Rüstungs-Gussformen gibt es beim Gussform-Händler auf dem Markt oder als Beute aus den Dungeons. Die Rüstungsteile entstehen an der Werkbank aus der Kupferplatte und 1 Leder (Rattenfell an der Gerberbank gerben). Bring die Teile Hedwig in die Abenteurergilde (im Inventar, nicht an einem Helden): Erst was sie bekommen hat, ist abgehakt. Du kannst sie auch einzeln abgeben.",
			"start_flag": "copper_set_accepted",
			"done_flag": "copper_set_paid",
			"complete_flag": "copper_set_complete",
			"complete_text": "Alles abgegeben! Hol dir bei Hedwig deine Prämie.",
			"hand_in": true,
			"set_material": "copper",

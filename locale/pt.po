msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: pt\n"

msgid "%d Gold"
msgstr "%d de ouro"

msgid "%d Herzen"
msgstr "%d corações"

msgid "%d Skillpunkte"
msgstr "%d pontos de habilidade"

msgid "%s: ab Stufe %d"
msgstr "%s: a partir do nível %d"

msgid "%s: nach %s"
msgstr "%s: depois de %s"

msgid "3 % Chance auf R3 bei Egon."
msgstr "3 % de chance de R3 com o Egon."

msgid "300 Gold mehr sind in der Dose sicher."
msgstr "Mais 300 de ouro ficam seguros na lata."

msgid "5 % mehr Chance auf R2 bei Egon."
msgstr "5 % a mais de chance de R2 com o Egon."

msgid "Ab Spielerstufe %d"
msgstr "A partir do nível %d"

msgid "Ab Stufe %d"
msgstr "A partir do nível %d"

msgid "Ab jetzt liegen öfter Tränke auf meinem Tisch. Zum Freundschaftspreis, versteht sich."
msgstr "De agora em diante sempre haverá poções na minha mesa. A preço de amigo, claro."

msgid "Abbrechen"
msgstr "Cancelar"

msgid "Aber doch nicht so, ganz ohne Ausrüstung. Komm, schau dir erst meinen Laden an."
msgstr "Mas assim não, sem equipamento nenhum. Vem, dá uma olhada na minha loja primeiro."

msgid "Abgeben"
msgstr "Entregar"

msgid "Abschließbar. Theoretisch."
msgstr "Trancável. Em teoria."

msgid "Abstand"
msgstr "Espaço"

msgid "Ach ja, Schlüssel! Die findest du da unten, aber sie zerbrechen, sobald du den Dungeon verlässt."
msgstr "Ah, é, chaves! Você vai achar lá embaixo, mas elas quebram assim que você sai da masmorra."

msgid "Acht Bomben"
msgstr "Oito bombas"

msgid "Alle Items abgelegt"
msgstr "Todos os itens largados"

msgid "Alle Items ablegen"
msgstr "Largar todos os itens"

msgid "Alle Rucksäcke sind angebaut. Mehr gibt es im Skillbaum."
msgstr "Todas as mochilas estão presas. Há mais na árvore de habilidades."

msgid "Alle Werte ein bisschen hoch"
msgstr "Todos os atributos sobem um pouco"

msgid "Alle paar Besiegten heilst du ein halbes Herz"
msgstr "A cada poucos inimigos derrotados você cura meio coração"

msgid "Alles im Laden kostet die Hälfte"
msgstr "Tudo na loja custa metade"

msgid "Also lieber ausgeben, Partner. Am besten bei mir!"
msgstr "Então é melhor gastar, parceiro. De preferência comigo!"

msgid "Am Dungeon der Glut"
msgstr "Na Masmorra das Brasas"

msgid "Am Ende zerplatzt jeder Schuss in vier Funken"
msgstr "No fim cada tiro explode em quatro faíscas"

msgid "Am Frostgipfel"
msgstr "No Pico Gelado"

msgid "Am Glutschlund"
msgstr "Na Goela Ardente"

msgid "Am Moor der Irrlichter"
msgstr "No Pântano dos Fogos-Fátuos"

msgid "Am Seil rausgeklettert, wie ein Held! Aber… wo ist mein Rubin?"
msgstr "Saiu pela corda como um herói! Mas… cadê o meu rubi?"

msgid "Amethyst"
msgstr "Ametista"

msgid "An der Wispernden Wiese"
msgstr "No Prado Sussurrante"

msgid "Anführer: %s"
msgstr "Líder: %s"

msgid "Angriffstempo"
msgstr "Velocidade de ataque"

msgid "Ankauf"
msgstr "Compra"

msgid "Ans Licht"
msgstr "Rumo à luz"

msgid "Anzeige"
msgstr "Tela"

msgid "Arena-Amulett"
msgstr "Amuleto da arena"

msgid "Arenaherz"
msgstr "Coração da arena"

msgid "Asche"
msgstr "Cinza"

msgid "Audio"
msgstr "Áudio"

msgid "Auf der Wiese bewacht der Endboss einen Kristall. Er summt, sagt man. Bring ihn mir. Ich brauch was zum Summen. Ehrlich!"
msgstr "No prado o chefe final guarda um cristal. Dizem que ele zumbe. Traga para mim. Preciso de algo que zumba. Sério!"

msgid "Auf zur Wiese, Partner. Ich hab gehört, da wächst Gold. Oder Gras."
msgstr "Para o prado, parceiro. Dizem que lá cresce ouro. Ou capim."

msgid "Aufgeladene Riesenglut schlägt ein und explodiert"
msgstr "Brasas gigantes carregadas caem e explodem"

msgid "Aufladen, loslassen: ein gewaltiger Feuerstrahl"
msgstr "Carregue, solte: um raio de fogo enorme"

msgid "Aufwind"
msgstr "Corrente ascendente"

msgid "Aus"
msgstr "Desligado"

msgid "Aus dem Dungeon flüchten? Du nimmst alles mit, was du trägst."
msgstr "Fugir da masmorra? Você leva tudo o que carrega."

msgid "Aus der Beute der Banditen. Jetzt deine."
msgstr "Do saque dos bandidos. Agora é seu."

msgid "Ausgang"
msgstr "Saída"

msgid "Ausrüstung"
msgstr "Equipamento"

msgid "Ausweichen"
msgstr "Esquivar"

msgid "Axt statt Feuerbällen: schwerer Schwung, Gegner bluten"
msgstr "Um machado em vez de bolas de fogo: golpe pesado, inimigos sangram"

msgid "Bandit-Schildträger"
msgstr "Bandido escudeiro"

msgid "Bandit-Schütze"
msgstr "Bandido arqueiro"

msgid "Banditenlager"
msgstr "Acampamento bandido"

msgid "Beenden"
msgstr "Sair"

msgid "Behälter für %s"
msgstr "Recipiente para %s"

msgid "Beim Treffer zerplatzt der Schuss in vier Funken"
msgstr "Ao acertar, o tiro explode em quatro faíscas"

msgid "Beine"
msgstr "Pernas"

msgid "Belegt: %d/%d"
msgstr "Ocupado: %d/%d"

msgid "Belohnung: der nächste Dungeon und %d Gold"
msgstr "Recompensa: a próxima masmorra e %d de ouro"

msgid "Bergfalke"
msgstr "Falcão da montanha"

msgid "Bernstein"
msgstr "Âmbar"

msgid "Beschläge aus Kupfer, Platz für einen Rubin."
msgstr "Ferragens de cobre, cabe um rubi."

msgid "Besiege %d Gegner (%d / %d)"
msgstr "Derrote %d inimigos (%d / %d)"

msgid "Besiege: %s"
msgstr "Derrote: %s"

msgid "Besiegt: %d / %d"
msgstr "Derrotados: %d / %d"

msgid "Besiegte Gegner: %d"
msgstr "Inimigos derrotados: %d"

msgid "Betreten"
msgstr "Entrar"

msgid "Beute aus dem Dungeon bleibt hier. Ins Lager ziehen, auf den Tisch ziehen (verkaufen) oder wieder mitnehmen. Rucksäcke aus dem Lager an den Rand ziehen (R dreht)."
msgstr "O saque da masmorra fica aqui. Arraste para o depósito, para a mesa (vender) ou leve de novo. Arraste mochilas do depósito até a borda (R gira)."

msgid "Beute kaufe ich dir ab: Rechtsklick im Inventar, dann liegt sie oben bei meinem Ankauf. Faire Preise. Ehrlich!"
msgstr "Eu compro seu saque: clique com o botão direito no inventário e ele vai para a minha compra lá em cima. Preços justos. Sério!"

msgid "Beute kaufe ich dir ab: Zieh sie einfach auf meinen Tisch. Faire Preise. Ehrlich!"
msgstr "Eu compro seu saque: é só arrastar para a minha mesa. Preço justo. Sério!"

msgid "Beute: %s"
msgstr "Saque: %s"

msgid "Blasebalg"
msgstr "Fole"

msgid "Blau"
msgstr "Azul"

msgid "Blau wie Gletschereis."
msgstr "Azul como gelo de geleira."

msgid "Blaues Herz"
msgstr "Coração azul"

msgid "Blutphiole"
msgstr "Frasco de sangue"

msgid "Bogenschütze"
msgstr "Arqueiro"

msgid "Bombe"
msgstr "Bomba"

msgid "Bomben schießen beim Explodieren Feuerbälle"
msgstr "Bombas disparam bolas de fogo ao explodir"

msgid "Bomben zerplatzen in kleine Bomben"
msgstr "Bombas explodem em bombinhas"

msgid "Bombengürtel"
msgstr "Cinto de bombas"

msgid "Boss"
msgstr "Chefe"

msgid "Brakk der Brecher"
msgstr "Brakk, o Quebrador"

msgid "Brandöl"
msgstr "Óleo incendiário"

msgid "Braucht: %s"
msgstr "Precisa de: %s"

msgid "Brennend und langsam: mehr Schaden"
msgstr "Queimando e lento: mais dano"

msgid "Brennende, explodierende Schüsse"
msgstr "Tiros flamejantes que explodem"

msgid "Brennende, langsame Gegner und zwei blaue Herzen"
msgstr "Inimigos queimando e lentos, e dois corações azuis"

msgid "Brennt gut in jeder Esse."
msgstr "Queima bem em qualquer forja."

msgid "Bring Egon den Stein vom Endboss (Quests), dann öffnet sich der nächste Dungeon."
msgstr "Leve a Egon a pedra do chefe final (Missões) e a próxima masmorra se abre."

msgid "Bronze"
msgstr "Bronze"

msgid "Bronze-Beinschienen"
msgstr "Grevas de bronze"

msgid "Bronze-Bogen"
msgstr "Arco de bronze"

msgid "Bronze-Brustplatte"
msgstr "Peitoral de bronze"

msgid "Bronze-Handschuhe"
msgstr "Luvas de bronze"

msgid "Bronze-Helm"
msgstr "Elmo de bronze"

msgid "Bronze-Schwert"
msgstr "Espada de bronze"

msgid "Bronze-Stiefel"
msgstr "Botas de bronze"

msgid "Bronze-Zauberstab"
msgstr "Varinha de bronze"

msgid "Bronzebogen"
msgstr "Arco de bronze"

msgid "Bronzeschild"
msgstr "Escudo de bronze"

msgid "Brotkanone"
msgstr "Canhão de pão"

msgid "Brotregen"
msgstr "Chuva de pão"

msgid "Brust"
msgstr "Peito"

msgid "Bumerang-Haken"
msgstr "Gancho bumerangue"

msgid "Chancen auf dem Tisch:"
msgstr "Chances na mesa:"

msgid "Cyan"
msgstr "Ciano"

msgid "Da hinten geht's in den Dungeon der Glut. Manche kommen sogar wieder raus!"
msgstr "Ali atrás fica a entrada da Masmorra das Brasas. Alguns até saem de volta!"

msgid "Da passt das nicht hin, Partner. Mach erst Platz."
msgstr "Isso não cabe aí, parceiro. Abra espaço antes."

msgid "Dafür reicht dein Gold nicht"
msgstr "Seu ouro não dá para isso"

msgid "Dafür reicht dein Gold nicht, Partner. Leider, leider."
msgstr "Seu ouro não dá pra isso, parceiro. Que pena, que pena."

msgid "Dafür wird die Ware mit jedem Dreh besser. Steht auf dem Balken, ehrlich!"
msgstr "Mas a mercadoria melhora a cada giro. Está escrito na barra, sério!"

msgid "Daran hängt noch ein anderer Rucksack."
msgstr "Outra mochila ainda está presa nesta."

msgid "Darin steckt ein kleines Krabbeltier."
msgstr "Tem um bichinho preso dentro."

msgid "Darin tanzt ein kleines Licht. Egon will ihn haben."
msgstr "Uma luzinha dança lá dentro. Egon quer."

msgid "Darin wohnt fast ein ganzer Laden."
msgstr "Cabe quase uma loja inteira dentro."

msgid "Darüber… sagen wir, hier gibt es Ratten. Große Ratten. Mit Händen."
msgstr "Acima disso… digamos que aqui tem ratos. Ratos grandes. Com mãos."

msgid "Das Fell eines Riesen aus Eis."
msgstr "A pele de um gigante de gelo."

msgid "Das Gold des Runs. Stirbst du, ist es weg, außer im sicheren Platz."
msgstr "O ouro desta partida. Se você morrer, ele some, exceto no espaço seguro."

msgid "Das Gras raschelt. Das Gras raschelt immer. Bis es beißt."
msgstr "A grama farfalha. A grama sempre farfalha. Até morder."

msgid "Das Herz des Drachen"
msgstr "O coração do dragão"

msgid "Das Lager bekommt %d Spalten mehr. Für immer."
msgstr "O depósito ganha mais %d colunas. Para sempre."

msgid "Das kann man nicht anziehen, Partner. Glaub mir, ich hab's versucht."
msgstr "Isso não dá pra vestir, parceiro. Acredite, eu já tentei."

msgid "Das kostet zu viel Leben"
msgstr "Isso custa vida demais"

msgid "Das? Das kauf ich nicht. Das will ich geschenkt! Äh … als Quest."
msgstr "Isso? Não compro. Quero de presente! Ah… como missão."

msgid "Deckkraft"
msgstr "Opacidade"

msgid "Defensiv"
msgstr "Defensivo"

msgid "Dein Gold. Zu Hause sicher in der Dose; im Dungeon ist es beim Tod weg, außer im sicheren Platz."
msgstr "Seu ouro. Em casa, seguro na lata; na masmorra se perde ao morrer, exceto no espaço seguro."

msgid "Dein Relikt hat den Geist aufgegeben. Passiert. Ich hätte da zufällig ein neues… Freundschaftspreis!"
msgstr "Sua relíquia bateu as botas. Acontece. Por acaso eu tenho uma nova… preço de amigo!"

msgid "Dein ganzes Gold liegt rechts in deiner Dose. Bis 200 Gold ist es da sicher."
msgstr "Todo o seu ouro fica na sua lata, à direita. Até 200 de ouro está seguro."

msgid "Deine Feuerbälle zerstören Gegner-Schüsse"
msgstr "Suas bolas de fogo destroem os tiros inimigos"

msgid "Deine Items"
msgstr "Seus itens"

msgid "Deine Schüsse verfolgen Gegner"
msgstr "Seus tiros perseguem inimigos"

msgid "Den Quest-Stein hierher ziehen"
msgstr "Arraste a pedra da missão para cá"

msgid "Den Stein aus dem Lager auf den Quest-Platz oben rechts ziehen oder hier abgeben."
msgstr "Arraste a pedra do depósito para o lugar da missão no canto superior direito, ou entregue aqui."

msgid "Den ersten Boss besiegt und am Seil hinausgeklettert."
msgstr "Derrotou o primeiro chefe e escalou a corda para fora."

msgid "Den gibt's aufs Haus. Ein toter Kunde kauft ja nichts mehr. Ehrlich!"
msgstr "Essa é por conta da casa. Cliente morto não compra nada. Sério!"

msgid "Der Balken über dem Hebel zeigt, was drin sein kann: grau ist gewöhnlich, grün solide und so weiter. Je erfahrener du bist, desto bunter wird's."
msgstr "A barra acima da alavanca mostra o que pode vir: cinza é comum, verde sólido e assim por diante. Quanto mais experiente, mais colorido."

msgid "Der Boss hatte einen, ich weiß es! Bring ihn mir, wenn du einen findest. Ich warte. Ungeduldig."
msgstr "O chefe tinha um, eu sei! Traga para mim se achar um. Eu espero. Impaciente."

msgid "Der Endboss am Frostgipfel hat einen Frost-Aquamarin. Bring ihn Egon."
msgstr "O chefe final do Pico Gelado tem uma água-marinha gelada. Leve a Egon."

msgid "Der Endboss der Wispernden Wiese bewacht einen Wiesenkristall. Bring ihn Egon."
msgstr "O chefe final do Prado Sussurrante guarda um cristal do prado. Leve a Egon."

msgid "Der Endboss im Dungeon der Glut hütet einen Glutrubin. Bring ihn Egon."
msgstr "O chefe final da Masmorra das Brasas guarda um rubi de brasa. Leve a Egon."

msgid "Der Endboss im Moor der Irrlichter trägt einen Irrlicht-Opal. Bring ihn Egon."
msgstr "O chefe final do Pântano dos Fogos-Fátuos carrega uma opala fátua. Leve a Egon."

msgid "Der Feuerstrahl biegt sich zum Gegner"
msgstr "O raio de fogo se curva até o inimigo"

msgid "Der Glutrubin! Echt! Also … ich hab nie gezweifelt."
msgstr "O rubi de brasa! De verdade! Bem… eu nunca duvidei."

msgid "Der Händler im Dungeon zahlt 2 Gold mehr für jede Beute."
msgstr "O mercador da masmorra paga 2 de ouro a mais por cada espólio."

msgid "Der Händler kauft Beute: Tab, Rechtsklick"
msgstr "O mercador compra espólio: Tab, clique direito"

msgid "Der Opal! Er leuchtet! Fast so hell wie meine Zukunft."
msgstr "A opala! Ela brilha! Quase tanto quanto meu futuro."

msgid "Der Rubin gehört mir! … Gehörte."
msgstr "O rubi é meu! … Era."

msgid "Der Stein liegt in deinem Inventar!"
msgstr "A pedra está no seu inventário!"

msgid "Der Stein liegt in deinem Lager!"
msgstr "A pedra está no seu depósito!"

msgid "Der Stein nimmt dein Opfer an"
msgstr "A pedra aceita seu sacrifício"

msgid "Der Vulkandrache im Glutschlund hat ein Herz aus Glut. Bring es Egon."
msgstr "O dragão vulcânico da Goela Ardente tem um coração de brasa. Leve a Egon."

msgid "Der Weg nach unten ist frei!"
msgstr "O caminho para baixo está livre!"

msgid "Der Wildhüter"
msgstr "O Guarda-Caça"

msgid "Der einzige auch, aber das sagen wir keinem."
msgstr "O único também, mas isso a gente não conta pra ninguém."

msgid "Der sichere Platz wird eine Spalte breiter."
msgstr "O lugar seguro ganha uma coluna."

msgid "Diamant"
msgstr "Diamante"

msgid "Diamantherz"
msgstr "Coração de diamante"

msgid "Dick, weich und eiskalt."
msgstr "Grosso, macio e gelado."

msgid "Dicke"
msgstr "Espessura"

msgid "Dicke Haut"
msgstr "Pele grossa"

msgid "Die Blumen? Dekoration. Kosten aber extra, wenn du hinsiehst."
msgstr "As flores? Decoração. Mas custam extra se você olhar."

msgid "Die Fenstergröße gilt nur im Fenster-Modus."
msgstr "O tamanho da janela só vale no modo janela."

msgid "Die Mücken hier stechen nur Ehrliche. Siehst du? Mich lassen sie in Ru… *klatsch* …Ruhe."
msgstr "Aqui os mosquitos só picam gente honesta. Viu? Comigo eles me deixam em pa… *plaft* …paz."

msgid "Die Tür ist offen. Geh in den nächsten Raum."
msgstr "A porta está aberta. Vá para a próxima sala."

msgid "Die Waffe des Bogenschützen: Pfeile aufladen und loslassen, weit und stark"
msgstr "A arma do arqueiro: carregue flechas e solte, longe e forte"

msgid "Die Waffe des Kriegers: ein Schwertschwung trifft alle vor dir"
msgstr "A arma do guerreiro: um golpe de espada acerta todos à sua frente"

msgid "Die Waffe des Magiers: schießt Feuerbälle"
msgstr "A arma do mago: dispara bolas de fogo"

msgid "Diebeshand"
msgstr "Mão de ladrão"

msgid "Dietrich"
msgstr "Gazua"

msgid "Distelkrähe"
msgstr "Corvo-Cardo"

msgid "Doppelschuss"
msgstr "Tiro duplo"

msgid "Dornenpanzer"
msgstr "Armadura de espinhos"

msgid "Dose"
msgstr "Lata"

msgid "Dose: %d Gold. Bis %d ist es sicher."
msgstr "Lata: %d de ouro. Seguro até %d."

msgid "Dose: Gold hierher ziehen"
msgstr "Lata: arraste o ouro para cá"

msgid "Dose: hier liegt dein ganzes Gold"
msgstr "Lata: aqui está todo o seu ouro"

msgid "Drache"
msgstr "Dragão"

msgid "Drachenatem"
msgstr "Bafo de dragão"

msgid "Drachenhaut"
msgstr "Pele de dragão"

msgid "Drachenherz"
msgstr "Coração de dragão"

msgid "Drachenleder"
msgstr "Couro de dragão"

msgid "Drachenmantel"
msgstr "Manto de dragão"

msgid "Drei Funken folgen dir und schießen"
msgstr "Três faíscas te seguem e atiram"

msgid "Drei Schlüssel, Rabatt im Laden"
msgstr "Três chaves, desconto na loja"

msgid "Drei blaue Herzen"
msgstr "Três corações azuis"

msgid "Drei blaue Herzen und manchmal ausweichen"
msgstr "Três corações azuis e às vezes esquiva"

msgid "Dreifachschuss"
msgstr "Tiro triplo"

msgid "Dreizack-Rune"
msgstr "Runa do tridente"

msgid "Dreißig Münzen und zehn Schlüssel"
msgstr "Trinta moedas e dez chaves"

msgid "Du bist gefallen"
msgstr "Você caiu"

msgid "Du bist schon gesund"
msgstr "Você já está saudável"

msgid "Du brauchst einen Schlüssel"
msgstr "Você precisa de uma chave"

msgid "Du fliegst und bist nach Treffern länger geschützt"
msgstr "Você voa e fica protegido por mais tempo após golpes"

msgid "Du fliegst und schießt schneller"
msgstr "Você voa e atira mais rápido"

msgid "Du fliegst über Fallen und Abgründe, Schaden +1"
msgstr "Você voa sobre armadilhas e abismos, dano +1"

msgid "Du fliegst über Fallen und Abgründe, zwei blaue Herzen"
msgstr "Você voa sobre armadilhas e abismos, dois corações azuis"

msgid "Du fliegst, Schüsse fliegen schneller und weiter"
msgstr "Você voa, os tiros vão mais rápido e mais longe"

msgid "Du fliegst, Tempo hoch, Schüsse stoßen Gegner weg"
msgstr "Você voa, mais velocidade, os tiros empurram os inimigos"

msgid "Du hast den Dungeon bezwungen!"
msgstr "Você conquistou a masmorra!"

msgid "Du hast nicht genug Leben"
msgstr "Você não tem vida suficiente"

msgid "Du läufst schneller"
msgstr "Você corre mais rápido"

msgid "Du schießt Brotlaibe. Getroffene Gegner vergessen dich und rennen weg"
msgstr "Você atira pães. Inimigos atingidos esquecem você e fogem"

msgid "Du schießt auch nach hinten"
msgstr "Você também atira para trás"

msgid "Du schießt etwas schneller."
msgstr "Você atira um pouco mais rápido."

msgid "Du schießt schneller"
msgstr "Você atira mais rápido"

msgid "Du wirfst Bomben statt Feuerbällen"
msgstr "Você joga bombas em vez de bolas de fogo"

msgid "Du wirfst Wurfsterne, getroffene Gegner bluten"
msgstr "Você arremessa shurikens, inimigos atingidos sangram"

msgid "Du wirst größer: mehr Herzen und Schaden, leichter zu treffen"
msgstr "Você fica maior: mais corações e dano, mais fácil de acertar"

msgid "Du wirst kleiner und schneller"
msgstr "Você fica menor e mais rápido"

msgid "Du wirst kleiner: schwerer zu treffen, schneller"
msgstr "Você encolhe: mais difícil de acertar, mais rápido"

msgid "Du wirst viel größer und stärker, aber langsamer"
msgstr "Você fica muito maior e mais forte, porém mais lento"

msgid "Du wirst winzig und manchmal weichst du aus"
msgstr "Você fica minúsculo e às vezes esquiva"

msgid "Du wirst zu Nebel: du fliegst und weichst manchmal aus"
msgstr "Você vira névoa: voa e às vezes desvia"

msgid "Du wirst zum Geist: du schwebst durch Steine, deine Schüsse auch"
msgstr "Você vira um fantasma: flutua através das pedras, e seus tiros também"

msgid "Dungeon der Glut"
msgstr "Masmorra das Brasas"

msgid "Dungeon-Brett"
msgstr "Quadro de masmorras"

msgid "Dungeons"
msgstr "Masmorras"

msgid "Dunkle Flügel"
msgstr "Asas sombrias"

msgid "Dunkler Ritter"
msgstr "Cavaleiro sombrio"

msgid "Dunkler Schütze"
msgstr "Arqueiro sombrio"

msgid "Dunkler Zauberstab"
msgstr "Varinha sombria"

msgid "Durch Gegner hindurch und von Wand zu Wand"
msgstr "Através dos inimigos e de parede em parede"

msgid "Durch Steine, und manchmal fliehen Gegner"
msgstr "Através de pedras, e às vezes inimigos fogem"

msgid "Durchschlag, Abprallen und Zerplatzen"
msgstr "Perfura, ricocheteia e explode"

msgid "Dämon"
msgstr "Demônio"

msgid "Dünne Haut aus einem Fledermausflügel."
msgstr "Pele fina da asa de um morcego."

msgid "E: Bombe · Tab: Inventar · M: Karte · Esc: Pause"
msgstr "E: bomba · Tab: inventário · M: mapa · Esc: pausa"

msgid "EXP: +%d"
msgstr "EXP: +%d"

msgid "Ebene %d"
msgstr "Andar %d"

msgid "Ebene: %d"
msgstr "Andar: %d"

msgid "Effekte"
msgstr "Efeitos"

msgid "Egon Ehrlich, sehr erfreut. Ehrlich ist mein Name, ehrlich mein Geschäft. Ehrlich!"
msgstr "Egon Honesto, muito prazer. Honesto é meu nome, honesto é meu negócio. Sério!"

msgid "Egon hat gerade keinen Auftrag."
msgstr "Egon não tem nenhuma tarefa agora."

msgid "Egon hat gesagt, hier unten ist es sicher. Egon hat gelogen. – B."
msgstr "O Egon disse que aqui embaixo é seguro. O Egon mentiu. – B."

msgid "Egon könnte klauen!"
msgstr "O Egon pode roubar!"

msgid "Egon war nie hier, sagt er. Von wem sind dann die angesengten Stiefelspuren?"
msgstr "O Egon nunca esteve aqui, diz ele. Então de quem são essas pegadas de bota chamuscadas?"

msgid "Egons Augen werden ganz groß."
msgstr "Os olhos do Egon ficam enormes."

msgid "Egons Glutrubin"
msgstr "O rubi de brasa de Egon"


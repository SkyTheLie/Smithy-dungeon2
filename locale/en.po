"Content-Type: text/plain; charset=UTF-8\n"
"Language: en\n"

msgid "%d Gold"
msgstr "%d gold"

msgid "%d Herzen"
msgstr "%d hearts"

msgid "%d Skillpunkte"
msgstr "%d skill points"

msgid "%s: ab Stufe %d"
msgstr "%s: from level %d"

msgid "%s: nach %s"
msgstr "%s: after %s"

msgid "3 % Chance auf R3 bei Egon."
msgstr "3 % chance of R3 at Egon's."

msgid "300 Gold mehr sind in der Dose sicher."
msgstr "300 more gold is safe in the can."

msgid "5 % mehr Chance auf R2 bei Egon."
msgstr "5 % more chance of R2 at Egon's."

msgid "Ab Spielerstufe %d"
msgstr "From player level %d"

msgid "Ab Stufe %d"
msgstr "From level %d"

msgid "Ab jetzt liegen öfter Tränke auf meinem Tisch. Zum Freundschaftspreis, versteht sich."
msgstr "From now on there'll often be potions on my table. At a friendship price, of course."

msgid "Abbrechen"
msgstr "Cancel"

msgid "Aber doch nicht so, ganz ohne Ausrüstung. Komm, schau dir erst meinen Laden an."
msgstr "But not like that, without any equipment. Come, have a look at my shop first."

msgid "Abgeben"
msgstr "Hand in"

msgid "Abschließbar. Theoretisch."
msgstr "Lockable. In theory."

msgid "Abstand"
msgstr "Gap"

msgid "Ach ja, Schlüssel! Die findest du da unten, aber sie zerbrechen, sobald du den Dungeon verlässt."
msgstr "Oh right, keys! You'll find them down there, but they break as soon as you leave the dungeon."

msgid "Acht Bomben"
msgstr "Eight bombs"

msgid "Alle Items abgelegt"
msgstr "All items dropped"

msgid "Alle Items ablegen"
msgstr "Drop all items"

msgid "Alle Rucksäcke sind angebaut. Mehr gibt es im Skillbaum."
msgstr "All backpacks are attached. More in the skill tree."

msgid "Alle Werte ein bisschen hoch"
msgstr "All stats up a little"

msgid "Alle paar Besiegten heilst du ein halbes Herz"
msgstr "Every few kills heal half a heart"

msgid "Alles im Laden kostet die Hälfte"
msgstr "Everything in the shop costs half"

msgid "Also lieber ausgeben, Partner. Am besten bei mir!"
msgstr "So better spend it, partner. Preferably with me!"

msgid "Am Dungeon der Glut"
msgstr "At the Dungeon of Embers"

msgid "Am Ende zerplatzt jeder Schuss in vier Funken"
msgstr "At the end every shot bursts into four sparks"

msgid "Am Frostgipfel"
msgstr "At Frost Peak"

msgid "Am Glutschlund"
msgstr "At the Ember Maw"

msgid "Am Moor der Irrlichter"
msgstr "At the Moor of Wisps"

msgid "Am Seil rausgeklettert, wie ein Held! Aber… wo ist mein Rubin?"
msgstr "Climbed out on the rope like a hero! But… where's my ruby?"

msgid "Amethyst"
msgstr "Amethyst"

msgid "An der Wispernden Wiese"
msgstr "At the Whispering Meadow"

msgid "Anführer: %s"
msgstr "Leader: %s"

msgid "Angriffstempo"
msgstr "Attack speed"

msgid "Ankauf"
msgstr "Buying"

msgid "Ans Licht"
msgstr "Into the Light"

msgid "Anzeige"
msgstr "Display"

msgid "Arena-Amulett"
msgstr "Arena Amulet"

msgid "Arenaherz"
msgstr "Arena Heart"

msgid "Asche"
msgstr "Ash"

msgid "Audio"
msgstr "Audio"

msgid "Auf der Wiese bewacht der Endboss einen Kristall. Er summt, sagt man. Bring ihn mir. Ich brauch was zum Summen. Ehrlich!"
msgstr "On the meadow the final boss guards a crystal. It hums, they say. Bring it to me. I need something to hum. Honest!"

msgid "Auf zur Wiese, Partner. Ich hab gehört, da wächst Gold. Oder Gras."
msgstr "Off to the meadow, partner. I hear gold grows there. Or grass."

msgid "Aufgeladene Riesenglut schlägt ein und explodiert"
msgstr "Charged giant embers crash down and explode"

msgid "Aufladen, loslassen: ein gewaltiger Feuerstrahl"
msgstr "Charge, release: a mighty fire beam"

msgid "Aufwind"
msgstr "Updraft"

msgid "Aus"
msgstr "Off"

msgid "Aus dem Dungeon flüchten? Du nimmst alles mit, was du trägst."
msgstr "Flee the dungeon? You keep everything you carry."

msgid "Aus der Beute der Banditen. Jetzt deine."
msgstr "From the bandits' loot. Yours now."

msgid "Ausgang"
msgstr "Exit"

msgid "Ausrüstung"
msgstr "Equipment"

msgid "Ausweichen"
msgstr "Dodge"

msgid "Axt statt Feuerbällen: schwerer Schwung, Gegner bluten"
msgstr "An axe instead of fireballs: heavy swing, enemies bleed"

msgid "Bandit-Schildträger"
msgstr "Bandit Shieldbearer"

msgid "Bandit-Schütze"
msgstr "Bandit Archer"

msgid "Banditenlager"
msgstr "Bandit Camp"

msgid "Beenden"
msgstr "Quit"

msgid "Behälter für %s"
msgstr "Container for %s"

msgid "Beim Treffer zerplatzt der Schuss in vier Funken"
msgstr "On a hit the shot bursts into four sparks"

msgid "Beine"
msgstr "Legs"

msgid "Belegt: %d/%d"
msgstr "Filled: %d/%d"

msgid "Belohnung: der nächste Dungeon und %d Gold"
msgstr "Reward: the next dungeon and %d gold"

msgid "Bergfalke"
msgstr "Mountain Hawk"

msgid "Bernstein"
msgstr "Amber"

msgid "Beschläge aus Kupfer, Platz für einen Rubin."
msgstr "Copper fittings, room for a ruby."

msgid "Besiege %d Gegner (%d / %d)"
msgstr "Defeat %d enemies (%d / %d)"

msgid "Besiege: %s"
msgstr "Defeat: %s"

msgid "Besiegt: %d / %d"
msgstr "Beaten: %d / %d"

msgid "Besiegte Gegner: %d"
msgstr "Enemies defeated: %d"

msgid "Betreten"
msgstr "Enter"

msgid "Beute aus dem Dungeon bleibt hier. Ins Lager ziehen, auf den Tisch ziehen (verkaufen) oder wieder mitnehmen. Rucksäcke aus dem Lager an den Rand ziehen (R dreht)."
msgstr "Loot from the dungeon stays here. Drag it into the stash, onto the table (sell) or take it along again. Drag backpacks from the stash to the edge (R rotates)."

msgid "Beute kaufe ich dir ab: Rechtsklick im Inventar, dann liegt sie oben bei meinem Ankauf. Faire Preise. Ehrlich!"
msgstr "I buy your loot: right-click it in the inventory and it lands up at my buying spot. Fair prices. Honestly!"

msgid "Beute kaufe ich dir ab: Zieh sie einfach auf meinen Tisch. Faire Preise. Ehrlich!"
msgstr "I'll buy your loot: just drag it onto my table. Fair prices. Honest!"

msgid "Beute: %s"
msgstr "Loot: %s"

msgid "Blasebalg"
msgstr "Bellows"

msgid "Blau"
msgstr "Blue"

msgid "Blau wie Gletschereis."
msgstr "Blue as glacier ice."

msgid "Blaues Herz"
msgstr "Blue Heart"

msgid "Blutphiole"
msgstr "Blood Vial"

msgid "Bogenschütze"
msgstr "Archer"

msgid "Bombe"
msgstr "Bomb"

msgid "Bomben schießen beim Explodieren Feuerbälle"
msgstr "Bombs shoot fireballs when they explode"

msgid "Bomben zerplatzen in kleine Bomben"
msgstr "Bombs burst into little bombs"

msgid "Bombengürtel"
msgstr "Bomb Belt"

msgid "Boss"
msgstr "Boss"

msgid "Brakk der Brecher"
msgstr "Brakk the Breaker"

msgid "Brandöl"
msgstr "Fire Oil"

msgid "Braucht: %s"
msgstr "Needs: %s"

msgid "Brennend und langsam: mehr Schaden"
msgstr "Burning and slow: more damage"

msgid "Brennende, explodierende Schüsse"
msgstr "Burning, exploding shots"

msgid "Brennende, langsame Gegner und zwei blaue Herzen"
msgstr "Burning, slowed enemies and two blue hearts"

msgid "Brennt gut in jeder Esse."
msgstr "Burns well in any forge."

msgid "Bring Egon den Stein vom Endboss (Quests), dann öffnet sich der nächste Dungeon."
msgstr "Bring Egon the stone from the final boss (Quests) to open the next dungeon."

msgid "Bronze"
msgstr "Bronze"

msgid "Bronze-Beinschienen"
msgstr "Bronze Greaves"

msgid "Bronze-Bogen"
msgstr "Bronze Bow"

msgid "Bronze-Brustplatte"
msgstr "Bronze Breastplate"

msgid "Bronze-Handschuhe"
msgstr "Bronze Gloves"

msgid "Bronze-Helm"
msgstr "Bronze Helmet"

msgid "Bronze-Schwert"
msgstr "Bronze Sword"

msgid "Bronze-Stiefel"
msgstr "Bronze Boots"

msgid "Bronze-Zauberstab"
msgstr "Bronze Wand"

msgid "Bronzebogen"
msgstr "Bronze Bow"

msgid "Bronzeschild"
msgstr "Bronze Shield"

msgid "Brotkanone"
msgstr "Bread Cannon"

msgid "Brotregen"
msgstr "Bread Rain"

msgid "Brust"
msgstr "Chest"

msgid "Bumerang-Haken"
msgstr "Boomerang Hook"

msgid "Chancen auf dem Tisch:"
msgstr "Chances on the table:"

msgid "Cyan"
msgstr "Cyan"

msgid "Da hinten geht's in den Dungeon der Glut. Manche kommen sogar wieder raus!"
msgstr "Back there is the way into the Dungeon of Embers. Some even come back out!"

msgid "Da passt das nicht hin, Partner. Mach erst Platz."
msgstr "That won't fit there, partner. Make room first."

msgid "Dafür reicht dein Gold nicht"
msgstr "You don't have enough gold for that"

msgid "Dafür reicht dein Gold nicht, Partner. Leider, leider."
msgstr "You don't have enough gold for that, partner. Such a shame."

msgid "Dafür wird die Ware mit jedem Dreh besser. Steht auf dem Balken, ehrlich!"
msgstr "But the goods get better with every spin. It says so on the bar, honest!"

msgid "Daran hängt noch ein anderer Rucksack."
msgstr "Another backpack still hangs on this one."

msgid "Darin steckt ein kleines Krabbeltier."
msgstr "There is a tiny bug stuck inside."

msgid "Darin tanzt ein kleines Licht. Egon will ihn haben."
msgstr "A little light dances inside. Egon wants it."

msgid "Darin wohnt fast ein ganzer Laden."
msgstr "Almost a whole shop fits inside."

msgid "Darüber… sagen wir, hier gibt es Ratten. Große Ratten. Mit Händen."
msgstr "Above that… let's say there are rats here. Big rats. With hands."

msgid "Das Fell eines Riesen aus Eis."
msgstr "The pelt of a giant made of ice."

msgid "Das Gold des Runs. Stirbst du, ist es weg, außer im sicheren Platz."
msgstr "The gold of this run. If you die it is gone, unless it is in the safe slot."

msgid "Das Gras raschelt. Das Gras raschelt immer. Bis es beißt."
msgstr "The grass rustles. The grass always rustles. Until it bites."

msgid "Das Herz des Drachen"
msgstr "The Dragon's Heart"

msgid "Das Lager bekommt %d Spalten mehr. Für immer."
msgstr "The storage gets %d more columns. Forever."

msgid "Das kann man nicht anziehen, Partner. Glaub mir, ich hab's versucht."
msgstr "You can't wear that, partner. Trust me, I've tried."

msgid "Das kostet zu viel Leben"
msgstr "That costs too much life"

msgid "Das? Das kauf ich nicht. Das will ich geschenkt! Äh … als Quest."
msgstr "That? I'm not buying that. I want it as a gift! Er… as a quest."

msgid "Deckkraft"
msgstr "Opacity"

msgid "Defensiv"
msgstr "Defensive"

msgid "Dein Gold. Zu Hause sicher in der Dose; im Dungeon ist es beim Tod weg, außer im sicheren Platz."
msgstr "Your gold. Safe in the money box at home; in the dungeon it is lost when you die, except in the safe slot."

msgid "Dein Relikt hat den Geist aufgegeben. Passiert. Ich hätte da zufällig ein neues… Freundschaftspreis!"
msgstr "Your relic gave up the ghost. Happens. I just happen to have a new one… friendship price!"

msgid "Dein ganzes Gold liegt rechts in deiner Dose. Bis 200 Gold ist es da sicher."
msgstr "All your gold sits in your can on the right. Up to 200 gold it's safe there."

msgid "Deine Feuerbälle zerstören Gegner-Schüsse"
msgstr "Your fireballs destroy enemy shots"

msgid "Deine Items"
msgstr "Your items"

msgid "Deine Schüsse verfolgen Gegner"
msgstr "Your shots chase enemies"

msgid "Den Quest-Stein hierher ziehen"
msgstr "Drag the quest stone here"

msgid "Den Stein aus dem Lager auf den Quest-Platz oben rechts ziehen oder hier abgeben."
msgstr "Drag the stone from the stash onto the quest spot at the top right, or hand it in here."

msgid "Den ersten Boss besiegt und am Seil hinausgeklettert."
msgstr "Beat the first boss and climbed out on the rope."

msgid "Den gibt's aufs Haus. Ein toter Kunde kauft ja nichts mehr. Ehrlich!"
msgstr "This one's on the house. A dead customer doesn't buy anything. Honest!"

msgid "Der Balken über dem Hebel zeigt, was drin sein kann: grau ist gewöhnlich, grün solide und so weiter. Je erfahrener du bist, desto bunter wird's."
msgstr "The bar above the lever shows what can come: grey is common, green solid and so on. The more experienced you are, the more colourful it gets."

msgid "Der Boss hatte einen, ich weiß es! Bring ihn mir, wenn du einen findest. Ich warte. Ungeduldig."
msgstr "The boss had one, I know it! Bring it to me if you find one. I'll wait. Impatiently."

msgid "Der Endboss am Frostgipfel hat einen Frost-Aquamarin. Bring ihn Egon."
msgstr "The final boss of Frost Peak has a frost aquamarine. Bring it to Egon."

msgid "Der Endboss der Wispernden Wiese bewacht einen Wiesenkristall. Bring ihn Egon."
msgstr "The final boss of the Whispering Meadow guards a meadow crystal. Bring it to Egon."

msgid "Der Endboss im Dungeon der Glut hütet einen Glutrubin. Bring ihn Egon."
msgstr "The final boss of the Dungeon of Embers guards an ember ruby. Bring it to Egon."

msgid "Der Endboss im Moor der Irrlichter trägt einen Irrlicht-Opal. Bring ihn Egon."
msgstr "The final boss of the Moor of Wisps carries a wisp opal. Bring it to Egon."

msgid "Der Feuerstrahl biegt sich zum Gegner"
msgstr "The fire beam bends toward enemies"

msgid "Der Glutrubin! Echt! Also … ich hab nie gezweifelt."
msgstr "The ember ruby! For real! Well… I never doubted you."

msgid "Der Händler im Dungeon zahlt 2 Gold mehr für jede Beute."
msgstr "The merchant in the dungeon pays 2 gold more for each piece of loot."

msgid "Der Händler kauft Beute: Tab, Rechtsklick"
msgstr "The merchant buys loot: Tab, right click"

msgid "Der Opal! Er leuchtet! Fast so hell wie meine Zukunft."
msgstr "The opal! It glows! Almost as bright as my future."

msgid "Der Rubin gehört mir! … Gehörte."
msgstr "The ruby is mine! … Was."

msgid "Der Stein liegt in deinem Inventar!"
msgstr "The stone is in your inventory!"

msgid "Der Stein liegt in deinem Lager!"
msgstr "The stone is in your stash!"

msgid "Der Stein nimmt dein Opfer an"
msgstr "The stone accepts your sacrifice"

msgid "Der Vulkandrache im Glutschlund hat ein Herz aus Glut. Bring es Egon."
msgstr "The volcano dragon in the Ember Maw has a heart of embers. Bring it to Egon."

msgid "Der Weg nach unten ist frei!"
msgstr "The way down is open!"

msgid "Der Wildhüter"
msgstr "The Gamekeeper"

msgid "Der einzige auch, aber das sagen wir keinem."
msgstr "The only one too, but let's not tell anyone."

msgid "Der sichere Platz wird eine Spalte breiter."
msgstr "The safe spot gets one column wider."

msgid "Diamant"
msgstr "Diamond"

msgid "Diamantherz"
msgstr "Diamond Heart"

msgid "Dick, weich und eiskalt."
msgstr "Thick, soft and ice-cold."

msgid "Dicke"
msgstr "Thickness"

msgid "Dicke Haut"
msgstr "Thick skin"

msgid "Die Fenstergröße gilt nur im Fenster-Modus."
msgstr "The window size only applies in window mode."

msgid "Die Tür ist offen. Geh in den nächsten Raum."
msgstr "The door is open. Go into the next room."

msgid "Die Waffe des Bogenschützen: Pfeile aufladen und loslassen, weit und stark"
msgstr "The archer's weapon: charge arrows and let go, far and strong"

msgid "Die Waffe des Kriegers: ein Schwertschwung trifft alle vor dir"
msgstr "The warrior's weapon: a sword swing hits everyone in front of you"

msgid "Die Waffe des Magiers: schießt Feuerbälle"
msgstr "The mage's weapon: shoots fireballs"

msgid "Diebeshand"
msgstr "Thief's hand"

msgid "Dietrich"
msgstr "Lockpick"

msgid "Distelkrähe"
msgstr "Thistle Crow"

msgid "Doppelschuss"
msgstr "Double shot"

msgid "Dornenpanzer"
msgstr "Thorn Armor"

msgid "Dose"
msgstr "Money box"

msgid "Dose: %d Gold. Bis %d ist es sicher."
msgstr "Money box: %d gold. Safe up to %d."

msgid "Dose: Gold hierher ziehen"
msgstr "Money box: drag gold here"

msgid "Dose: hier liegt dein ganzes Gold"
msgstr "Can: all your gold is in here"

msgid "Drache"
msgstr "Dragon"

msgid "Drachenatem"
msgstr "Dragon Breath"

msgid "Drachenhaut"
msgstr "Dragon Hide"

msgid "Drachenherz"
msgstr "Dragon Heart"

msgid "Drachenleder"
msgstr "Dragon Leather"

msgid "Drachenmantel"
msgstr "Dragon Cloak"

msgid "Drei Funken folgen dir und schießen"
msgstr "Three sparks follow you and shoot"

msgid "Drei Schlüssel, Rabatt im Laden"
msgstr "Three keys, shop discount"

msgid "Drei blaue Herzen"
msgstr "Three blue hearts"

msgid "Drei blaue Herzen und manchmal ausweichen"
msgstr "Three blue hearts and sometimes dodge"

msgid "Dreifachschuss"
msgstr "Triple shot"

msgid "Dreizack-Rune"
msgstr "Trident Rune"

msgid "Dreißig Münzen und zehn Schlüssel"
msgstr "Thirty coins and ten keys"

msgid "Du bist gefallen"
msgstr "You have fallen"

msgid "Du bist schon gesund"
msgstr "You are already healthy"

msgid "Du brauchst einen Schlüssel"
msgstr "You need a key"

msgid "Du fliegst und bist nach Treffern länger geschützt"
msgstr "You fly and stay protected longer after hits"

msgid "Du fliegst und schießt schneller"
msgstr "You fly and shoot faster"

msgid "Du fliegst über Fallen und Abgründe, Schaden +1"
msgstr "You fly over traps and chasms, damage +1"

msgid "Du fliegst über Fallen und Abgründe, zwei blaue Herzen"
msgstr "You fly over traps and chasms, two blue hearts"

msgid "Du fliegst, Schüsse fliegen schneller und weiter"
msgstr "You fly, shots fly faster and farther"

msgid "Du fliegst, Tempo hoch, Schüsse stoßen Gegner weg"
msgstr "You fly, speed up, shots push enemies away"

msgid "Du hast den Dungeon bezwungen!"
msgstr "You have conquered the dungeon!"

msgid "Du hast nicht genug Leben"
msgstr "You don't have enough life"

msgid "Du läufst schneller"
msgstr "You run faster"

msgid "Du schießt Brotlaibe. Getroffene Gegner vergessen dich und rennen weg"
msgstr "You shoot loaves of bread. Hit enemies forget you and run away"

msgid "Du schießt auch nach hinten"
msgstr "You also shoot backwards"

msgid "Du schießt etwas schneller."
msgstr "You shoot a bit faster."

msgid "Du schießt schneller"
msgstr "You shoot faster"

msgid "Du wirfst Bomben statt Feuerbällen"
msgstr "You throw bombs instead of fireballs"

msgid "Du wirfst Wurfsterne, getroffene Gegner bluten"
msgstr "You throw shuriken, hit enemies bleed"

msgid "Du wirst größer: mehr Herzen und Schaden, leichter zu treffen"
msgstr "You grow bigger: more hearts and damage, easier to hit"

msgid "Du wirst kleiner und schneller"
msgstr "You get smaller and faster"

msgid "Du wirst kleiner: schwerer zu treffen, schneller"
msgstr "You shrink: harder to hit, faster"

msgid "Du wirst viel größer und stärker, aber langsamer"
msgstr "You grow much bigger and stronger, but slower"

msgid "Du wirst winzig und manchmal weichst du aus"
msgstr "You become tiny and sometimes dodge"

msgid "Du wirst zu Nebel: du fliegst und weichst manchmal aus"
msgstr "You turn into mist: you fly and sometimes dodge"

msgid "Du wirst zum Geist: du schwebst durch Steine, deine Schüsse auch"
msgstr "You become a ghost: you float through rocks, and so do your shots"

msgid "Dungeon der Glut"
msgstr "Dungeon of Embers"

msgid "Dungeon-Brett"
msgstr "Dungeon Board"

msgid "Dungeons"
msgstr "Dungeons"

msgid "Dunkle Flügel"
msgstr "Dark Wings"

msgid "Dunkler Ritter"
msgstr "Dark Knight"

msgid "Dunkler Schütze"
msgstr "Dark Archer"

msgid "Dunkler Zauberstab"
msgstr "Dark Wand"

msgid "Durch Gegner hindurch und von Wand zu Wand"
msgstr "Through enemies and from wall to wall"

msgid "Durch Steine, und manchmal fliehen Gegner"
msgstr "Through rocks, and sometimes enemies flee"

msgid "Durchschlag, Abprallen und Zerplatzen"
msgstr "Piercing, bouncing and bursting"

msgid "Dämon"
msgstr "Demon"

msgid "Dünne Haut aus einem Fledermausflügel."
msgstr "Thin skin from a bat's wing."

msgid "E: Bombe · Tab: Inventar · M: Karte · Esc: Pause"
msgstr "E: bomb · Tab: inventory · M: map · Esc: pause"

msgid "EXP: +%d"
msgstr "EXP: +%d"

msgid "Ebene %d"
msgstr "Floor %d"

msgid "Ebene: %d"
msgstr "Floor: %d"

msgid "Effekte"
msgstr "Effects"

msgid "Egon Ehrlich, sehr erfreut. Ehrlich ist mein Name, ehrlich mein Geschäft. Ehrlich!"
msgstr "Egon Honest, pleased to meet you. Honest is my name, honest is my business. Honestly!"

msgid "Egon hat gerade keinen Auftrag."
msgstr "Egon has no job for you right now."

msgid "Egon hat gesagt, hier unten ist es sicher. Egon hat gelogen. – B."
msgstr "Egon said it's safe down here. Egon lied. – B."

msgid "Egon könnte klauen!"
msgstr "Egon might steal!"

msgid "Egon war nie hier, sagt er. Von wem sind dann die angesengten Stiefelspuren?"
msgstr "Egon was never here, he says. Then whose are the scorched boot prints?"

msgid "Egons Augen werden ganz groß."
msgstr "Egon's eyes go very wide."

msgid "Egons Glutrubin"
msgstr "Egon's Ember Ruby"

msgid "Egons Laden"
msgstr "Egon's Shop"

msgid "Egons Laterne ging nach einer Stunde aus. Garantie: eine Stunde."
msgstr "Egon's lantern went out after an hour. Warranty: one hour."

msgid "Eigene"
msgstr "Custom"

msgid "Eigene Explosionen heilen dich"
msgstr "Your own explosions heal you"

msgid "Ein Anführer!"
msgstr "A leader!"

msgid "Ein Berg aus Eis, oben tobt der Sturm. Unterwegs Wölfe, Harpyien und ein Greif. Egon empfiehlt warme Socken."
msgstr "A mountain of ice with a storm raging at the top. On the way: wolves, harpies and a griffin. Egon recommends warm socks."

msgid "Ein Bernstein, drei Bomben, drei Schlüssel"
msgstr "An amber, three bombs, three keys"

msgid "Ein Fass ohne Boden. Fast ohne."
msgstr "A bottomless barrel. Almost."

msgid "Ein Feuerball kreist um dich und blockt Schüsse"
msgstr "A fireball circles you and blocks shots"

msgid "Ein Funke folgt dir und schießt"
msgstr "A spark follows you and shoots"

msgid "Ein Funke und ein Glutmond"
msgstr "A spark and an ember moon"

msgid "Ein Funke und mehr Glück"
msgstr "A spark and more luck"

msgid "Ein Funke, der nicht ausgehen will."
msgstr "A spark that won't go out."

msgid "Ein Geistervogel trägt dich: du fliegst, Glück +1"
msgstr "A ghost bird carries you: you fly, luck +1"

msgid "Ein Glutpakt hat sich geöffnet"
msgstr "An ember pact has opened"

msgid "Ein Golderz"
msgstr "A gold ore"

msgid "Ein Heiltrank! Frisch gebraut, fast ohne Nebenwirkungen."
msgstr "A healing potion! Freshly brewed, almost no side effects."

msgid "Ein Herz mehr"
msgstr "One more heart"

msgid "Ein Herz mehr, Glück hoch"
msgstr "One more heart, luck up"

msgid "Ein Herz mehr, Schaden hoch"
msgstr "One more heart, damage up"

msgid "Ein Herz mehr, heilt dich ganz"
msgstr "One more heart, heals you fully"

msgid "Ein Herz und ein blaues Herz"
msgstr "One heart and one blue heart"

msgid "Ein Herz, Dornen, Explosionen tun dir nichts"
msgstr "A heart, thorns, explosions don't hurt you"

msgid "Ein Herz, eine Bombe und ein Schlüssel"
msgstr "A heart, a bomb and a key"

msgid "Ein Herz, eine Münze, eine Bombe und ein Schlüssel"
msgstr "A heart, a coin, a bomb and a key"

msgid "Ein Herz, zwei blaue Herzen, Schaden hoch"
msgstr "A heart, two blue hearts, damage up"

msgid "Ein Händler! Geh hin und sprich ihn an."
msgstr "A merchant! Go over and talk to him."

msgid "Ein Kraut in Herzform. Egon kocht Tee daraus."
msgstr "A heart-shaped herb. Egon makes tea from it."

msgid "Ein Licht für Egon"
msgstr "A Light for Egon"

msgid "Ein Platz mehr im Rucksack."
msgstr "One more backpack slot."

msgid "Ein Portal öffnet sich!"
msgstr "A portal opens!"

msgid "Ein Relikt-Platz mehr an deiner Figur."
msgstr "One more relic slot on your hero."

msgid "Ein Rubin"
msgstr "A ruby"

msgid "Ein Rucksack mehr an deinem Inventar."
msgstr "One more backpack on your inventory."

msgid "Ein Rucksack mit 3×3 Feldern. Bei Egon an dein Inventar anbauen."
msgstr "A backpack with 3×3 cells. Attach it to your inventory at Egon's."

msgid "Ein Rucksack mit 4×2 Feldern. Bei Egon an dein Inventar anbauen."

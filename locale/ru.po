msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: ru\n"

msgid "%d Gold"
msgstr "%d золота"

msgid "%d Herzen"
msgstr "%d сердец"

msgid "Abbrechen"
msgstr "Отмена"

msgid "Aber doch nicht so, ganz ohne Ausrüstung. Komm, schau dir erst meinen Laden an."
msgstr "Но не так же, совсем без снаряжения. Пойдём, сначала глянь мою лавку."

msgid "Acht Bomben"
msgstr "Восемь бомб"

msgid "Alle Items abgelegt"
msgstr "Все предметы сброшены"

msgid "Alle Items ablegen"
msgstr "Сбросить все предметы"

msgid "Alle Werte ein bisschen hoch"
msgstr "Все характеристики немного выше"

msgid "Alle paar Besiegten heilst du ein halbes Herz"
msgstr "Каждые несколько побед лечат полсердца"

msgid "Alles im Laden kostet die Hälfte"
msgstr "Всё в лавке за полцены"

msgid "Also lieber ausgeben, Partner. Am besten bei mir!"
msgstr "Так что лучше трать, партнёр. Желательно у меня!"

msgid "Am Ende zerplatzt jeder Schuss in vier Funken"
msgstr "В конце каждый выстрел разлетается на четыре искры"

msgid "Amethyst"
msgstr "Аметист"

msgid "Angriffstempo"
msgstr "Скорость атаки"

msgid "Ankauf"
msgstr "Скупка"

msgid "Anzeige"
msgstr "Экран"

msgid "Arena-Amulett"
msgstr "Амулет арены"

msgid "Arenaherz"
msgstr "Сердце арены"

msgid "Audio"
msgstr "Звук"

msgid "Aufgeladene Riesenglut schlägt ein und explodiert"
msgstr "Заряженный огромный уголь врезается и взрывается"

msgid "Aufladen, loslassen: ein gewaltiger Feuerstrahl"
msgstr "Заряди, отпусти: мощный луч огня"

msgid "Aus dem Dungeon flüchten? Du nimmst alles mit, was du trägst."
msgstr "Сбежать из подземелья? Всё, что несёшь, останется у тебя."

msgid "Ausgang"
msgstr "Выход"

msgid "Ausrüstung"
msgstr "Снаряжение"

msgid "Ausweichen"
msgstr "Рывок"

msgid "Axt statt Feuerbällen: schwerer Schwung, Gegner bluten"
msgstr "Топор вместо огненных шаров: тяжёлый взмах, враги кровоточат"

msgid "Beenden"
msgstr "Выход"

msgid "Beim Treffer zerplatzt der Schuss in vier Funken"
msgstr "При попадании снаряд распадается на четыре искры"

msgid "Beine"
msgstr "Ноги"

msgid "Bernstein"
msgstr "Янтарь"

msgid "Besiege %d Gegner (%d / %d)"
msgstr "Победи %d врагов (%d / %d)"

msgid "Besiege: %s"
msgstr "Победи: %s"

msgid "Besiegte Gegner: %d"
msgstr "Побеждено врагов: %d"

msgid "Betreten"
msgstr "Войти"

msgid "Beute kaufe ich dir ab: Rechtsklick im Inventar, dann liegt sie oben bei meinem Ankauf. Faire Preise. Ehrlich!"
msgstr "Добычу я выкупаю: ПКМ в инвентаре — и она у моей скупки наверху. Честные цены. Честно!"

msgid "Blasebalg"
msgstr "Кузнечные мехи"

msgid "Blutphiole"
msgstr "Флакон крови"

msgid "Bogenschütze"
msgstr "Лучник"

msgid "Bombe"
msgstr "Бомба"

msgid "Bomben schießen beim Explodieren Feuerbälle"
msgstr "Бомбы при взрыве выпускают огненные шары"

msgid "Bomben zerplatzen in kleine Bomben"
msgstr "Бомбы разлетаются на маленькие бомбы"

msgid "Bombengürtel"
msgstr "Пояс с бомбами"

msgid "Brandöl"
msgstr "Горючее масло"

msgid "Braucht: %s"
msgstr "Нужно: %s"

msgid "Brennend und langsam: mehr Schaden"
msgstr "Горит и медлит: больше урона"

msgid "Brennende, explodierende Schüsse"
msgstr "Горящие взрывные выстрелы"

msgid "Brennende, langsame Gegner und zwei blaue Herzen"
msgstr "Горящие, медленные враги и два синих сердца"

msgid "Brennt gut in jeder Esse."
msgstr "Хорошо горит в любом горне."

msgid "Bronzebogen"
msgstr "Бронзовый лук"

msgid "Bronzeschild"
msgstr "Бронзовый щит"

msgid "Brotkanone"
msgstr "Хлебная пушка"

msgid "Brotregen"
msgstr "Хлебный дождь"

msgid "Brust"
msgstr "Грудь"

msgid "Bumerang-Haken"
msgstr "Крюк-бумеранг"

msgid "Chancen auf dem Tisch:"
msgstr "Шансы на столе:"

msgid "Da hinten geht's in den Dungeon der Glut. Manche kommen sogar wieder raus!"
msgstr "Вон там вход в Подземелье углей. Некоторые даже возвращаются!"

msgid "Dafür reicht dein Gold nicht, Partner. Leider, leider."
msgstr "На это золота не хватит, партнёр. Увы, увы."

msgid "Darin steckt ein kleines Krabbeltier."
msgstr "Внутри застрял маленький жучок."

msgid "Darüber… sagen wir, hier gibt es Ratten. Große Ratten. Mit Händen."
msgstr "Сверх того… скажем так, тут водятся крысы. Большие. С руками."

msgid "Das Gold des Runs. Stirbst du, ist es weg, außer im sicheren Platz."
msgstr "Золото этого забега. Если умрёшь, оно пропадёт, кроме лежащего в надёжной ячейке."

msgid "Das kann man nicht anziehen, Partner. Glaub mir, ich hab's versucht."
msgstr "Это не наденешь, партнёр. Поверь, я пробовал."

msgid "Das kostet zu viel Leben"
msgstr "Это стоит слишком много жизни"

msgid "Defensiv"
msgstr "Защита"

msgid "Dein Gold. Zu Hause sicher in der Dose; im Dungeon ist es beim Tod weg, außer im sicheren Platz."
msgstr "Твоё золото. Дома — в банке в безопасности; в подземелье при смерти пропадает, кроме надёжной ячейки."

msgid "Dein Relikt hat den Geist aufgegeben. Passiert. Ich hätte da zufällig ein neues… Freundschaftspreis!"
msgstr "Твоя реликвия приказала долго жить. Бывает. У меня случайно есть новая… цена для друзей!"

msgid "Dein ganzes Gold liegt rechts in deiner Dose. Bis 200 Gold ist es da sicher."
msgstr "Всё твоё золото лежит в твоей банке справа. До 200 золотых там безопасно."

msgid "Deine Feuerbälle zerstören Gegner-Schüsse"
msgstr "Твои огненные шары уничтожают выстрелы врагов"

msgid "Deine Items"
msgstr "Твои предметы"

msgid "Deine Schüsse verfolgen Gegner"
msgstr "Снаряды преследуют врагов"

msgid "Der Balken über dem Hebel zeigt, was drin sein kann: grau ist gewöhnlich, grün solide und so weiter. Je erfahrener du bist, desto bunter wird's."
msgstr "Полоска над рычагом показывает, что может выпасть: серое — обычное, зелёное — добротное и так далее. Чем ты опытнее, тем пестрее."

msgid "Der Feuerstrahl biegt sich zum Gegner"
msgstr "Луч огня изгибается к врагу"

msgid "Der Händler im Dungeon zahlt 2 Gold mehr für jede Beute."
msgstr "Торговец в подземелье платит на 2 золотых больше за каждую добычу."

msgid "Der Händler kauft Beute: Tab, Rechtsklick"
msgstr "Торговец покупает добычу: Tab, правый клик"

msgid "Der Stein nimmt dein Opfer an"
msgstr "Камень принимает твою жертву"

msgid "Der Weg nach unten ist frei!"
msgstr "Путь вниз открыт!"

msgid "Diamantherz"
msgstr "Алмазное сердце"

msgid "Dicke Haut"
msgstr "Толстая кожа"

msgid "Die Fenstergröße gilt nur im Fenster-Modus."
msgstr "Размер окна действует только в оконном режиме."

msgid "Die Waffe des Bogenschützen: Pfeile aufladen und loslassen, weit und stark"
msgstr "Оружие лучника: натяни стрелу и отпусти, далеко и сильно"

msgid "Die Waffe des Kriegers: ein Schwertschwung trifft alle vor dir"
msgstr "Оружие воина: взмах меча бьёт всех перед тобой"

msgid "Die Waffe des Magiers: schießt Feuerbälle"
msgstr "Оружие мага: стреляет огненными шарами"

msgid "Dietrich"
msgstr "Отмычка"

msgid "Doppelschuss"
msgstr "Двойной выстрел"

msgid "Dornenpanzer"
msgstr "Шипастая броня"

msgid "Dose"
msgstr "Банка"

msgid "Dose: %d Gold. Bis %d ist es sicher."
msgstr "Банка: %d золота. До %d в безопасности."

msgid "Dose: Gold hierher ziehen"
msgstr "Банка: перетащи золото сюда"

msgid "Dose: hier liegt dein ganzes Gold"
msgstr "Банка: здесь всё твоё золото"

msgid "Drachenatem"
msgstr "Дыхание дракона"

msgid "Drachenhaut"
msgstr "Шкура дракона"

msgid "Drachenleder"
msgstr "Драконья кожа"

msgid "Drachenmantel"
msgstr "Драконий плащ"

msgid "Drei Funken folgen dir und schießen"
msgstr "Три искры следуют за тобой и стреляют"

msgid "Drei Schlüssel, Rabatt im Laden"
msgstr "Три ключа, скидка в лавке"

msgid "Drei blaue Herzen"
msgstr "Три синих сердца"

msgid "Drei blaue Herzen und manchmal ausweichen"
msgstr "Три синих сердца и иногда уклонение"

msgid "Dreifachschuss"
msgstr "Тройной выстрел"

msgid "Dreizack-Rune"
msgstr "Руна трезубца"

msgid "Dreißig Münzen und zehn Schlüssel"
msgstr "Тридцать монет и десять ключей"

msgid "Du bist gefallen"
msgstr "Ты пал"

msgid "Du brauchst einen Schlüssel"
msgstr "Нужен ключ"

msgid "Du hast den Dungeon bezwungen!"
msgstr "Ты покорил подземелье!"

msgid "Du hast nicht genug Leben"
msgstr "У тебя мало жизни"

msgid "Du läufst schneller"
msgstr "Бегаешь быстрее"

msgid "Du schießt Brotlaibe. Getroffene Gegner vergessen dich und rennen weg"
msgstr "Стреляешь буханками. Задетые враги забывают о тебе и убегают"

msgid "Du schießt auch nach hinten"
msgstr "Ты стреляешь и назад"

msgid "Du schießt etwas schneller."
msgstr "Ты стреляешь чуть быстрее."

msgid "Du schießt schneller"
msgstr "Стреляешь быстрее"

msgid "Du wirfst Bomben statt Feuerbällen"
msgstr "Бросаешь бомбы вместо огненных шаров"

msgid "Du wirfst Wurfsterne, getroffene Gegner bluten"
msgstr "Ты метаешь сюрикены, подбитые враги кровоточат"

msgid "Du wirst größer: mehr Herzen und Schaden, leichter zu treffen"
msgstr "Ты растёшь: больше сердец и урона, в тебя легче попасть"

msgid "Du wirst kleiner und schneller"
msgstr "Ты становишься меньше и быстрее"

msgid "Du wirst kleiner: schwerer zu treffen, schneller"
msgstr "Ты уменьшаешься: труднее попасть, быстрее"

msgid "Du wirst viel größer und stärker, aber langsamer"
msgstr "Ты становишься намного больше и сильнее, но медленнее"

msgid "Du wirst winzig und manchmal weichst du aus"
msgstr "Ты крошечный и иногда уклоняешься"

msgid "Dungeon der Glut"
msgstr "Подземелье углей"

msgid "Dungeon-Brett"
msgstr "Доска подземелий"

msgid "Dungeons"
msgstr "Подземелья"

msgid "Dunkler Zauberstab"
msgstr "Тёмный жезл"

msgid "Durch Gegner hindurch und von Wand zu Wand"
msgstr "Сквозь врагов и от стены к стене"

msgid "Durch Steine, und manchmal fliehen Gegner"
msgstr "Сквозь камни, и иногда враги бегут"

msgid "Durchschlag, Abprallen und Zerplatzen"
msgstr "Пробивает, отскакивает и разлетается"

msgid "Dünne Haut aus einem Fledermausflügel."
msgstr "Тонкая кожа с крыла летучей мыши."

msgid "E: Bombe · Tab: Inventar · M: Karte · Esc: Pause"
msgstr "E: бомба · Tab: инвентарь · M: карта · Esc: пауза"

msgid "EXP: +%d"
msgstr "Опыт: +%d"

msgid "Ebene %d"
msgstr "Уровень %d"

msgid "Ebene: %d"
msgstr "Уровень: %d"

msgid "Effekte"
msgstr "Эффекты"

msgid "Egon Ehrlich, sehr erfreut. Ehrlich ist mein Name, ehrlich mein Geschäft. Ehrlich!"
msgstr "Эгон Честный, очень приятно. Честный — моё имя, честный — мой бизнес. Честно!"

msgid "Egon könnte klauen!"
msgstr "Эгон может стащить!"

msgid "Egons Laden"
msgstr "Лавка Эгона"

msgid "Eigene Explosionen heilen dich"
msgstr "Твои взрывы тебя лечат"

msgid "Ein Bernstein, drei Bomben, drei Schlüssel"
msgstr "Янтарь, три бомбы, три ключа"

msgid "Ein Feuerball kreist um dich und blockt Schüsse"
msgstr "Огненный шар кружит вокруг и блокирует выстрелы"

msgid "Ein Funke folgt dir und schießt"
msgstr "Искра следует за тобой и стреляет"

msgid "Ein Funke und ein Glutmond"
msgstr "Искра и луна жара"

msgid "Ein Funke und mehr Glück"
msgstr "Искра и больше удачи"

msgid "Ein Glutpakt hat sich geöffnet"
msgstr "Открылся пакт жара"

msgid "Ein Golderz"
msgstr "Золотая руда"

msgid "Ein Herz mehr"
msgstr "Ещё одно сердце"

msgid "Ein Herz mehr, Glück hoch"
msgstr "Ещё одно сердце, удача выше"

msgid "Ein Herz mehr, Schaden hoch"
msgstr "Ещё одно сердце, урон выше"

msgid "Ein Herz mehr, heilt dich ganz"
msgstr "Ещё одно сердце, полностью лечит"

msgid "Ein Herz und ein blaues Herz"
msgstr "Одно сердце и одно синее сердце"

msgid "Ein Herz, Dornen, Explosionen tun dir nichts"
msgstr "Сердце, шипы, взрывы не вредят"

msgid "Ein Herz, eine Bombe und ein Schlüssel"
msgstr "Сердце, бомба и ключ"

msgid "Ein Herz, eine Münze, eine Bombe und ein Schlüssel"
msgstr "Сердце, монета, бомба и ключ"

msgid "Ein Herz, zwei blaue Herzen, Schaden hoch"
msgstr "Сердце, два синих сердца, урон выше"

msgid "Ein Platz mehr im Rucksack."
msgstr "Ещё одна ячейка в рюкзаке."

msgid "Ein Relikt-Platz mehr an deiner Figur."
msgstr "Ещё одна ячейка реликвии у героя."

msgid "Ein Rubin"
msgstr "Рубин"

msgid "Ein Schnäppchen! Für mich. Äh… für dich! Ehrlich!"
msgstr "Выгодная сделка! Для меня. Э-э… для тебя! Честно!"

msgid "Ein Schrein hat sich geöffnet"
msgstr "Открылось святилище"

msgid "Ein Schuss mehr und mehr Schaden"
msgstr "Ещё один выстрел и больше урона"

msgid "Ein Schuss mehr, aber schwächer"
msgstr "Ещё один выстрел, но слабее"

msgid "Ein Silbererz, Glück hoch"
msgstr "Серебряная руда, удача выше"

msgid "Ein Stab mit Feuer-Spitze. Für Magier."
msgstr "Посох с огненным навершием. Для магов."

msgid "Ein Wolfsfell, drei Bomben, drei Schlüssel"
msgstr "Волчья шкура, три бомбы, три ключа"

msgid "Ein blaues Herz und Dornen"
msgstr "Синее сердце и шипы"

msgid "Ein blaues Herz, Schaden hoch"
msgstr "Одно синее сердце, урон выше"

msgid "Ein blaues Herz, länger sicher nach Treffern"
msgstr "Синее сердце, дольше защита после удара"

msgid "Ein blaues Herz, schneller laufen"
msgstr "Одно синее сердце, бег быстрее"

msgid "Ein einfacher Bogen. Für Bogenschützen."
msgstr "Простой лук. Для лучников."

msgid "Ein geheimer Raum!"
msgstr "Тайная комната!"

msgid "Ein halbes weißes Schild-Herz mehr zu Beginn jedes Runs."
msgstr "Ещё половина белого сердца-щита в начале каждого забега."

msgid "Ein rotes Herz mehr."
msgstr "Ещё одно красное сердце."

msgid "Ein sicherer Platz mehr im Rucksack."
msgstr "Ещё одна надёжная ячейка в рюкзаке."

msgid "Ein zweites Leben"
msgstr "Вторая жизнь"

msgid "Ein zweites Leben und ein Funke"
msgstr "Вторая жизнь и искра"

msgid "Ein zweites Leben!"
msgstr "Вторая жизнь!"

msgid "Eine ganze Bäckerei auf einmal"
msgstr "Целая пекарня разом"

msgid "Eine kurze Klinge. Für Krieger."
msgstr "Короткий клинок. Для воинов."

msgid "Einmal am Tag dreh ich den Tisch umsonst. Danach gibt's einen Freundschaftspreis. Wird jedes Mal ein bisschen freundschaftlicher."
msgstr "Раз в день я кручу стол бесплатно. Потом — цена для друзей. С каждым разом всё дружелюбнее."

msgid "Einstellungen"
msgstr "Настройки"

msgid "Eisenerz"
msgstr "Железная руда"

msgid "Eisenhaut"
msgstr "Железная кожа"

msgid "Eisfeder"
msgstr "Ледяное перо"

msgid "Eisspiegel"
msgstr "Ледяное зеркало"

msgid "Eisstab"
msgstr "Ледяной посох"

msgid "Elfenbrief"
msgstr "Эльфийское письмо"

msgid "Entdecke %d Items (%d / %d)"
msgstr "Найди %d предметов (%d / %d)"

msgid "Entdeckt: %d / %d"
msgstr "Найдено: %d / %d"

msgid "Episch"
msgstr "Эпический"

msgid "Erdstab"
msgstr "Посох земли"

msgid "Erreiche Ebene %d"
msgstr "Дойди до уровня %d"

msgid "Erst den Skill davor lernen"
msgstr "Сначала изучи предыдущий навык"

msgid "Erstglut"
msgstr "Первый жар"

msgid "Explosive Schüsse, langsamer schießen"
msgstr "Взрывные выстрелы, стрельба медленнее"

msgid "Fahre mit der Maus über ein Item"
msgstr "Наведи мышь на предмет"

msgid "Feenstaub"
msgstr "Пыльца фей"

msgid "Fein"
msgstr "Тонкий"

msgid "Fenster"
msgstr "Окно"

msgid "Fenstergröße"
msgstr "Размер окна"

msgid "Feuerfester Bomber"
msgstr "Огнеупорный подрывник"

msgid "Feuerhieb"
msgstr "Огненный удар"

msgid "Feuerkranz"
msgstr "Огненный венец"

msgid "Feuerlanze"
msgstr "Огненное копьё"

msgid "Feuerstab"
msgstr "Огненный посох"

msgid "Feuerstrahl statt Feuerbällen: Maustaste halten"
msgstr "Луч огня вместо шаров: держи кнопку мыши"

msgid "Feuerwerk"
msgstr "Фейерверк"

msgid "Flechtenleder"
msgstr "Лишайниковая кожа"

msgid "Flechtenmantel"
msgstr "Лишайниковый плащ"

msgid "Fledermaus"
msgstr "Летучая мышь"

msgid "Flinke Hände"
msgstr "Ловкие руки"

msgid "Flipper"
msgstr "Пинбол"

msgid "Fluchskelett"
msgstr "Проклятый скелет"

msgid "Flughaut"
msgstr "Перепонка"

msgid "Flüchten"
msgstr "Сбежать"

msgid "Flüstert leise, wenn es dunkel ist."
msgstr "Тихо шепчет в темноте."

msgid "Freigeschaltet: %s"
msgstr "Открыто: %s"

msgid "Frost und Feuer"
msgstr "Мороз и пламя"

msgid "Frostflechte"
msgstr "Морозный лишайник"

msgid "Frostkristall"
msgstr "Морозный кристалл"

msgid "Frostmähne"
msgstr "Морозная грива"

msgid "Funkenbüchse"
msgstr "Банка искр"

msgid "Funkenfänger"
msgstr "Ловец искр"

msgid "Funkenstein"
msgstr "Искровой камень"

msgid "Fängt den einen oder anderen Kratzer ab."
msgstr "Ловит царапину-другую."

msgid "Fängt in jedem Raum den ersten Treffer ab"
msgstr "Отражает первый удар в каждой комнате"

msgid "Fünf Bomben, und Explosionen tun dir nichts mehr"
msgstr "Пять бомб, и взрывы тебе больше не вредят"

msgid "Fünf Münzen, drei Bomben, drei Schlüssel"
msgstr "Пять монет, три бомбы, три ключа"

msgid "Fünf Schlüssel"
msgstr "Пять ключей"

msgid "Fünfzehn Münzen"
msgstr "Пятнадцать монет"

msgid "Für Schritte, die man lieber nicht hört."
msgstr "Для шагов, которых лучше не слышать."

msgid "Für dich: ein Kupfer-Zauberstab, ein Helm und eine Brustplatte. Der erste Einkauf geht aufs Haus!"
msgstr "Для тебя: медный посох, шлем и нагрудник. Первая покупка за счёт заведения!"

msgid "Füße"
msgstr "Ступни"

msgid "Gebiete: %s"
msgstr "Области: %s"

msgid "Geflüchtet!"
msgstr "Сбежал!"

msgid "Gegabelter Stab"
msgstr "Раздвоенный посох"

msgid "Gegner brennen, Schaden hoch"
msgstr "Враги горят, урон выше"

msgid "Gegner werden langsamer, Reichweite hoch"
msgstr "Враги замедляются, дальность выше"

msgid "Gegner, die dich berühren, nehmen Schaden"
msgstr "Враги, касающиеся тебя, получают урон"

msgid "Geheimtasche"
msgstr "Потайной карман"


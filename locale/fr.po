msgstr "Boîte"

msgid "Dose: %d Gold. Bis %d ist es sicher."
msgstr "Boîte : %d or. En sécurité jusqu'à %d."

msgid "Dose: Gold hierher ziehen"
msgstr "Boîte : glisse l'or ici"

msgid "Dose: hier liegt dein ganzes Gold"
msgstr "Boîte : tout ton or est ici"

msgid "Drachenatem"
msgstr "Souffle du dragon"

msgid "Drachenhaut"
msgstr "Peau de dragon"

msgid "Drachenleder"
msgstr "Cuir de dragon"

msgid "Drachenmantel"
msgstr "Cape de dragon"

msgid "Drei Funken folgen dir und schießen"
msgstr "Trois étincelles te suivent et tirent"

msgid "Drei Schlüssel, Rabatt im Laden"
msgstr "Trois clés, réduction au magasin"

msgid "Drei blaue Herzen"
msgstr "Trois cœurs bleus"

msgid "Drei blaue Herzen und manchmal ausweichen"
msgstr "Trois cœurs bleus et parfois esquiver"

msgid "Dreifachschuss"
msgstr "Tir triple"

msgid "Dreizack-Rune"
msgstr "Rune du trident"

msgid "Dreißig Münzen und zehn Schlüssel"
msgstr "Trente pièces et dix clés"

msgid "Du bist gefallen"
msgstr "Tu es tombé"

msgid "Du brauchst einen Schlüssel"
msgstr "Il te faut une clé"

msgid "Du hast den Dungeon bezwungen!"
msgstr "Tu as vaincu le donjon !"

msgid "Du hast nicht genug Leben"
msgstr "Tu n'as pas assez de vie"

msgid "Du läufst schneller"
msgstr "Tu cours plus vite"

msgid "Du schießt Brotlaibe. Getroffene Gegner vergessen dich und rennen weg"
msgstr "Tu tires des miches de pain. Les ennemis touchés t'oublient et s'enfuient"

msgid "Du schießt auch nach hinten"
msgstr "Tu tires aussi vers l'arrière"

msgid "Du schießt etwas schneller."
msgstr "Tu tires un peu plus vite."

msgid "Du schießt schneller"
msgstr "Tu tires plus vite"

msgid "Du wirfst Bomben statt Feuerbällen"
msgstr "Tu lances des bombes au lieu de boules de feu"

msgid "Du wirfst Wurfsterne, getroffene Gegner bluten"
msgstr "Tu lances des shurikens, les ennemis touchés saignent"

msgid "Du wirst größer: mehr Herzen und Schaden, leichter zu treffen"
msgstr "Tu grandis : plus de cœurs et de dégâts, plus facile à toucher"

msgid "Du wirst kleiner und schneller"
msgstr "Tu deviens plus petit et plus rapide"

msgid "Du wirst kleiner: schwerer zu treffen, schneller"
msgstr "Tu rétrécis : plus difficile à toucher, plus rapide"

msgid "Du wirst viel größer und stärker, aber langsamer"
msgstr "Tu deviens bien plus grand et fort, mais plus lent"

msgid "Du wirst winzig und manchmal weichst du aus"
msgstr "Tu deviens minuscule et esquives parfois"

msgid "Dungeon der Glut"
msgstr "Donjon des Braises"

msgid "Dungeon-Brett"
msgstr "Tableau des donjons"

msgid "Dungeons"
msgstr "Donjons"

msgid "Dunkler Zauberstab"
msgstr "Baguette sombre"

msgid "Durch Gegner hindurch und von Wand zu Wand"
msgstr "À travers les ennemis et de mur en mur"

msgid "Durch Steine, und manchmal fliehen Gegner"
msgstr "À travers les rochers, et parfois les ennemis fuient"

msgid "Durchschlag, Abprallen und Zerplatzen"
msgstr "Perce, rebondit et éclate"


msgstr "Gants en fer"

msgid "Eisen-Helm"
msgstr "Casque en fer"

msgid "Eisen-Schwert"
msgstr "Épée en fer"

msgid "Eisen-Stiefel"
msgstr "Bottes en fer"

msgid "Eisen-Zauberstab"
msgstr "Baguette en fer"

msgid "Eisenerz"
msgstr "Minerai de fer"

msgid "Eisenhaut"
msgstr "Peau de fer"

msgid "Eisfeder"
msgstr "Plume de glace"

msgid "Eishöhle"
msgstr "Grotte de glace"

msgid "Eisrobbe"
msgstr "Phoque des glaces"

msgid "Eisspiegel"
msgstr "Miroir de glace"

msgid "Eisstab"
msgstr "Bâton de glace"

msgid "Eiswolf"
msgstr "Loup des glaces"

msgid "Elfenbrief"
msgstr "Lettre elfique"


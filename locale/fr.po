msgid "Ein blaues Herz, Schaden hoch"
msgstr "Un cœur bleu, dégâts en hausse"

msgid "Ein blaues Herz, länger sicher nach Treffern"
msgstr "Un cœur bleu, plus longtemps à l'abri après un coup"

msgid "Ein blaues Herz, schneller laufen"
msgstr "Un cœur bleu, tu cours plus vite"

msgid "Ein einfacher Bogen. Für Bogenschützen."
msgstr "Un arc simple. Pour les archers."

msgid "Ein geheimer Raum!"
msgstr "Une salle secrète !"

msgid "Ein halbes weißes Schild-Herz mehr zu Beginn jedes Runs."
msgstr "Un demi-cœur-bouclier blanc de plus au début de chaque partie."

msgid "Ein rotes Herz mehr."
msgstr "Un cœur rouge de plus."

msgid "Ein sicherer Platz mehr im Rucksack."
msgstr "Un emplacement sûr de plus dans le sac."

msgid "Ein zweites Leben"
msgstr "Une seconde vie"

msgid "Ein zweites Leben und ein Funke"
msgstr "Une seconde vie et une étincelle"

msgid "Ein zweites Leben!"
msgstr "Une seconde vie !"

msgid "Eine ganze Bäckerei auf einmal"
msgstr "Une boulangerie entière d'un coup"

msgid "Eine kurze Klinge. Für Krieger."
msgstr "Une lame courte. Pour les guerriers."

msgid "Einmal am Tag dreh ich den Tisch umsonst. Danach gibt's einen Freundschaftspreis. Wird jedes Mal ein bisschen freundschaftlicher."
msgstr "Une fois par jour, je tourne la table gratuitement. Ensuite, prix d'ami. Un peu plus amical à chaque fois."


msgstr "Atteins l'étage %d"

msgid "Erst den Skill davor lernen"
msgstr "Apprends d'abord la compétence précédente"

msgid "Erstglut"
msgstr "Braise première"

msgid "Explosive Schüsse, langsamer schießen"
msgstr "Tirs explosifs, cadence plus lente"

msgid "Fahre mit der Maus über ein Item"
msgstr "Survole un objet avec la souris"


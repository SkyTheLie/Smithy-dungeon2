msgid "%d Gold"
msgstr "%d or"

msgid "%d Herzen"
msgstr "%d cœurs"

msgid "%s: ab Stufe %d"
msgstr "%s : dès le niveau %d"

msgid "%s: nach %s"
msgstr "%s : après %s"

msgid "3 % Chance auf R3 bei Egon."
msgstr "3 % de chance d'avoir du R3 chez Egon."

msgid "300 Gold mehr sind in der Dose sicher."
msgstr "300 pièces d'or de plus sont en sécurité dans la boîte."

msgid "5 % mehr Chance auf R2 bei Egon."
msgstr "5 % de chance en plus d'avoir du R2 chez Egon."

msgid "Ab jetzt liegen öfter Tränke auf meinem Tisch. Zum Freundschaftspreis, versteht sich."
msgstr "Désormais, il y aura souvent des potions sur ma table. Au prix d'ami, bien sûr."

msgid "Abbrechen"
msgstr "Annuler"

msgid "Aber doch nicht so, ganz ohne Ausrüstung. Komm, schau dir erst meinen Laden an."
msgstr "Mais pas comme ça, sans aucun équipement. Viens, jette d'abord un œil à ma boutique."

msgid "Ach ja, Schlüssel! Die findest du da unten, aber sie zerbrechen, sobald du den Dungeon verlässt."
msgstr "Ah oui, les clés ! Tu en trouveras en bas, mais elles se brisent dès que tu quittes le donjon."

msgid "Acht Bomben"
msgstr "Huit bombes"

msgid "Alle Items abgelegt"
msgstr "Tous les objets lâchés"

msgid "Alle Items ablegen"
msgstr "Lâcher tous les objets"

msgid "Alle Werte ein bisschen hoch"
msgstr "Toutes les stats un peu en hausse"

msgid "Alle paar Besiegten heilst du ein halbes Herz"
msgstr "Tous les quelques ennemis vaincus, tu soignes un demi-cœur"

msgid "Alles im Laden kostet die Hälfte"
msgstr "Tout coûte moitié prix au magasin"

msgid "Also lieber ausgeben, Partner. Am besten bei mir!"
msgstr "Alors dépense-le plutôt, partenaire. De préférence chez moi !"

msgid "Am Ende zerplatzt jeder Schuss in vier Funken"
msgstr "À la fin chaque tir éclate en quatre étincelles"

msgid "Am Seil rausgeklettert, wie ein Held! Aber… wo ist mein Rubin?"
msgstr "Sorti par la corde comme un héros ! Mais… où est mon rubis ?"

msgid "Amethyst"
msgstr "Améthyste"

msgid "Angriffstempo"
msgstr "Vitesse d'attaque"

msgid "Ankauf"
msgstr "Rachat"

msgid "Ans Licht"
msgstr "Vers la lumière"

msgid "Anzeige"
msgstr "Affichage"

msgid "Arena-Amulett"
msgstr "Amulette de l'arène"

msgid "Arenaherz"
msgstr "Cœur de l'arène"

msgid "Asche"
msgstr "Cendre"

msgid "Audio"
msgstr "Audio"

msgid "Aufgeladene Riesenglut schlägt ein und explodiert"
msgstr "Les braises géantes chargées s'écrasent et explosent"

msgid "Aufladen, loslassen: ein gewaltiger Feuerstrahl"
msgstr "Charge, relâche : un rayon de feu colossal"

msgid "Aus dem Dungeon flüchten? Du nimmst alles mit, was du trägst."
msgstr "Fuir le donjon ? Tu gardes tout ce que tu portes."

msgid "Aus der Beute der Banditen. Jetzt deine."
msgstr "Du butin des bandits. À toi maintenant."

msgid "Ausgang"
msgstr "Sortie"

msgid "Ausrüstung"
msgstr "Équipement"

msgid "Ausweichen"
msgstr "Esquive"

msgid "Axt statt Feuerbällen: schwerer Schwung, Gegner bluten"
msgstr "Une hache au lieu de boules de feu : coup lourd, les ennemis saignent"

msgid "Bandit-Schildträger"
msgstr "Bandit porte-bouclier"

msgid "Bandit-Schütze"
msgstr "Bandit archer"

msgid "Banditenlager"
msgstr "Camp des bandits"

msgid "Beenden"
msgstr "Quitter"

msgid "Beim Treffer zerplatzt der Schuss in vier Funken"
msgstr "À l'impact, le tir éclate en quatre étincelles"

msgid "Beine"
msgstr "Jambes"

msgid "Bergfalke"
msgstr "Faucon des montagnes"

msgid "Bernstein"
msgstr "Ambre"

msgid "Besiege %d Gegner (%d / %d)"
msgstr "Vaincs %d ennemis (%d / %d)"

msgid "Besiege: %s"
msgstr "Vaincs : %s"

msgid "Besiegte Gegner: %d"
msgstr "Ennemis vaincus : %d"

msgid "Betreten"
msgstr "Entrer"

msgid "Beute kaufe ich dir ab: Rechtsklick im Inventar, dann liegt sie oben bei meinem Ankauf. Faire Preise. Ehrlich!"
msgstr "Je rachète ton butin : clic droit dans l'inventaire et il arrive en haut, à mon rachat. Prix honnêtes. Honnêtement !"

msgid "Blasebalg"
msgstr "Soufflet"

msgid "Blau wie Gletschereis."
msgstr "Bleu comme la glace d'un glacier."

msgid "Blutphiole"
msgstr "Fiole de sang"

msgid "Bogenschütze"
msgstr "Archer"

msgid "Bombe"
msgstr "Bombe"

msgid "Bomben schießen beim Explodieren Feuerbälle"
msgstr "Les bombes tirent des boules de feu en explosant"

msgid "Bomben zerplatzen in kleine Bomben"
msgstr "Les bombes éclatent en petites bombes"

msgid "Bombengürtel"
msgstr "Ceinture de bombes"

msgid "Brakk der Brecher"
msgstr "Brakk le Briseur"

msgid "Brandöl"
msgstr "Huile de feu"

msgid "Braucht: %s"
msgstr "Nécessite : %s"

msgid "Brennend und langsam: mehr Schaden"
msgstr "En feu et ralenti : plus de dégâts"

msgid "Brennende, explodierende Schüsse"
msgstr "Tirs brûlants et explosifs"

msgid "Brennende, langsame Gegner und zwei blaue Herzen"
msgstr "Ennemis brûlés et ralentis, et deux cœurs bleus"

msgid "Brennt gut in jeder Esse."
msgstr "Brûle bien dans toute forge."

msgid "Bronze"
msgstr "Bronze"

msgid "Bronze-Beinschienen"
msgstr "Jambières en bronze"

msgid "Bronze-Bogen"
msgstr "Arc en bronze"

msgid "Bronze-Brustplatte"
msgstr "Plastron en bronze"

msgid "Bronze-Handschuhe"
msgstr "Gants en bronze"

msgid "Bronze-Helm"
msgstr "Casque en bronze"

msgid "Bronze-Schwert"
msgstr "Épée en bronze"

msgid "Bronze-Stiefel"
msgstr "Bottes en bronze"

msgid "Bronze-Zauberstab"
msgstr "Baguette en bronze"

msgid "Bronzebogen"
msgstr "Arc de bronze"

msgid "Bronzeschild"
msgstr "Bouclier de bronze"

msgid "Brotkanone"
msgstr "Canon à pain"

msgid "Brotregen"
msgstr "Pluie de pain"

msgid "Brust"
msgstr "Torse"

msgid "Bumerang-Haken"
msgstr "Crochet boomerang"

msgid "Chancen auf dem Tisch:"
msgstr "Chances sur la table :"

msgid "Da hinten geht's in den Dungeon der Glut. Manche kommen sogar wieder raus!"
msgstr "Là-derrière, c'est l'entrée du Donjon des Braises. Certains en ressortent même !"

msgid "Dafür reicht dein Gold nicht"
msgstr "Tu n'as pas assez d'or pour ça"

msgid "Dafür reicht dein Gold nicht, Partner. Leider, leider."
msgstr "Ton or ne suffit pas pour ça, partenaire. Hélas, hélas."

msgid "Dafür wird die Ware mit jedem Dreh besser. Steht auf dem Balken, ehrlich!"
msgstr "Mais la marchandise s'améliore à chaque tour. C'est écrit sur la barre, honnêtement !"

msgid "Darin steckt ein kleines Krabbeltier."
msgstr "Une petite bestiole est coincée dedans."

msgid "Darüber… sagen wir, hier gibt es Ratten. Große Ratten. Mit Händen."
msgstr "Au-delà… disons qu'il y a des rats ici. Des gros rats. Avec des mains."

msgid "Das Fell eines Riesen aus Eis."
msgstr "La fourrure d'un géant de glace."

msgid "Das Gold des Runs. Stirbst du, ist es weg, außer im sicheren Platz."
msgstr "L'or de cette partie. Si tu meurs, il est perdu, sauf dans l'emplacement sûr."

msgid "Das kann man nicht anziehen, Partner. Glaub mir, ich hab's versucht."
msgstr "Ça ne se porte pas, partenaire. Crois-moi, j'ai essayé."

msgid "Das kostet zu viel Leben"
msgstr "Cela coûte trop de vie"

msgid "Defensiv"
msgstr "Défensif"

msgid "Dein Gold. Zu Hause sicher in der Dose; im Dungeon ist es beim Tod weg, außer im sicheren Platz."
msgstr "Ton or. À la maison, en sécurité dans la boîte ; au donjon, il est perdu à ta mort, sauf dans l'emplacement sûr."

msgid "Dein Relikt hat den Geist aufgegeben. Passiert. Ich hätte da zufällig ein neues… Freundschaftspreis!"
msgstr "Ta relique a rendu l'âme. Ça arrive. J'en aurais justement une neuve… prix d'ami !"

msgid "Dein ganzes Gold liegt rechts in deiner Dose. Bis 200 Gold ist es da sicher."
msgstr "Tout ton or est dans ta boîte, à droite. Jusqu'à 200 pièces d'or, il y est en sécurité."

msgid "Deine Feuerbälle zerstören Gegner-Schüsse"
msgstr "Tes boules de feu détruisent les tirs ennemis"

msgid "Deine Items"
msgstr "Tes objets"

msgid "Deine Schüsse verfolgen Gegner"
msgstr "Tes tirs poursuivent les ennemis"

msgid "Den ersten Boss besiegt und am Seil hinausgeklettert."
msgstr "Vaincu le premier boss et sorti par la corde."

msgid "Den gibt's aufs Haus. Ein toter Kunde kauft ja nichts mehr. Ehrlich!"
msgstr "Celle-ci est offerte. Un client mort n'achète plus rien. Promis !"

msgid "Der Balken über dem Hebel zeigt, was drin sein kann: grau ist gewöhnlich, grün solide und so weiter. Je erfahrener du bist, desto bunter wird's."
msgstr "La barre au-dessus du levier montre ce qui peut tomber : gris commun, vert solide, etc. Plus tu as d'expérience, plus c'est coloré."

msgid "Der Boss hatte einen, ich weiß es! Bring ihn mir, wenn du einen findest. Ich warte. Ungeduldig."
msgstr "Le boss en avait un, je le sais ! Apporte-le-moi si tu en trouves un. J'attends. Avec impatience."

msgid "Der Feuerstrahl biegt sich zum Gegner"
msgstr "Le rayon de feu se courbe vers l'ennemi"

msgid "Der Händler im Dungeon zahlt 2 Gold mehr für jede Beute."
msgstr "Le marchand du donjon paie 2 pièces d'or de plus pour chaque butin."

msgid "Der Händler kauft Beute: Tab, Rechtsklick"
msgstr "Le marchand achète le butin : Tab, clic droit"

msgid "Der Stein nimmt dein Opfer an"
msgstr "La pierre accepte ton sacrifice"

msgid "Der Weg nach unten ist frei!"
msgstr "Le chemin vers le bas est ouvert !"

msgid "Der Wildhüter"
msgstr "Le Garde-Chasse"

msgid "Diamant"
msgstr "Diamant"

msgid "Diamantherz"
msgstr "Cœur de diamant"

msgid "Dick, weich und eiskalt."
msgstr "Épais, doux et glacé."

msgid "Dicke Haut"
msgstr "Peau épaisse"

msgid "Die Fenstergröße gilt nur im Fenster-Modus."
msgstr "La taille de la fenêtre ne s'applique qu'en mode fenêtré."

msgid "Die Waffe des Bogenschützen: Pfeile aufladen und loslassen, weit und stark"
msgstr "L'arme de l'archer : charge tes flèches et relâche, loin et fort"

msgid "Die Waffe des Kriegers: ein Schwertschwung trifft alle vor dir"
msgstr "L'arme du guerrier : un coup d'épée frappe tous ceux devant toi"

msgid "Die Waffe des Magiers: schießt Feuerbälle"
msgstr "L'arme du mage : lance des boules de feu"

msgid "Dietrich"
msgstr "Crochet"

msgid "Distelkrähe"
msgstr "Corneille des Chardons"

msgid "Doppelschuss"
msgstr "Tir double"

msgid "Dornenpanzer"
msgstr "Armure d'épines"

msgid "Dose"
msgstr "Boîte"

msgid "Dose: %d Gold. Bis %d ist es sicher."
msgstr "Boîte : %d or. En sécurité jusqu'à %d."

msgid "Dose: Gold hierher ziehen"
msgstr "Boîte : glisse l'or ici"

msgid "Dose: hier liegt dein ganzes Gold"
msgstr "Boîte : tout ton or est ici"

msgid "Drache"
msgstr "Dragon"

msgid "Drachenatem"
msgstr "Souffle du dragon"

msgid "Drachenhaut"
msgstr "Peau de dragon"

msgid "Drachenleder"
msgstr "Cuir de dragon"

msgid "Drachenmantel"
msgstr "Cape de dragon"

msgid "Drei Funken folgen dir und schießen"
msgstr "Trois étincelles te suivent et tirent"

msgid "Drei Schlüssel, Rabatt im Laden"
msgstr "Trois clés, réduction au magasin"

msgid "Drei blaue Herzen"
msgstr "Trois cœurs bleus"

msgid "Drei blaue Herzen und manchmal ausweichen"
msgstr "Trois cœurs bleus et parfois esquiver"

msgid "Dreifachschuss"
msgstr "Tir triple"

msgid "Dreizack-Rune"
msgstr "Rune du trident"

msgid "Dreißig Münzen und zehn Schlüssel"
msgstr "Trente pièces et dix clés"

msgid "Du bist gefallen"
msgstr "Tu es tombé"

msgid "Du bist schon gesund"
msgstr "Tu es déjà en pleine forme"

msgid "Du brauchst einen Schlüssel"
msgstr "Il te faut une clé"

msgid "Du hast den Dungeon bezwungen!"
msgstr "Tu as vaincu le donjon !"

msgid "Du hast nicht genug Leben"
msgstr "Tu n'as pas assez de vie"

msgid "Du läufst schneller"
msgstr "Tu cours plus vite"

msgid "Du schießt Brotlaibe. Getroffene Gegner vergessen dich und rennen weg"
msgstr "Tu tires des miches de pain. Les ennemis touchés t'oublient et s'enfuient"

msgid "Du schießt auch nach hinten"
msgstr "Tu tires aussi vers l'arrière"

msgid "Du schießt etwas schneller."
msgstr "Tu tires un peu plus vite."

msgid "Du schießt schneller"
msgstr "Tu tires plus vite"

msgid "Du wirfst Bomben statt Feuerbällen"
msgstr "Tu lances des bombes au lieu de boules de feu"

msgid "Du wirfst Wurfsterne, getroffene Gegner bluten"
msgstr "Tu lances des shurikens, les ennemis touchés saignent"

msgid "Du wirst größer: mehr Herzen und Schaden, leichter zu treffen"
msgstr "Tu grandis : plus de cœurs et de dégâts, plus facile à toucher"

msgid "Du wirst kleiner und schneller"
msgstr "Tu deviens plus petit et plus rapide"

msgid "Du wirst kleiner: schwerer zu treffen, schneller"
msgstr "Tu rétrécis : plus difficile à toucher, plus rapide"

msgid "Du wirst viel größer und stärker, aber langsamer"
msgstr "Tu deviens bien plus grand et fort, mais plus lent"

msgid "Du wirst winzig und manchmal weichst du aus"
msgstr "Tu deviens minuscule et esquives parfois"

msgid "Dungeon der Glut"
msgstr "Donjon des Braises"

msgid "Dungeon-Brett"
msgstr "Tableau des donjons"

msgid "Dungeons"
msgstr "Donjons"

msgid "Dunkler Ritter"
msgstr "Chevalier noir"

msgid "Dunkler Schütze"
msgstr "Archer noir"

msgid "Dunkler Zauberstab"
msgstr "Baguette sombre"

msgid "Durch Gegner hindurch und von Wand zu Wand"
msgstr "À travers les ennemis et de mur en mur"

msgid "Durch Steine, und manchmal fliehen Gegner"
msgstr "À travers les rochers, et parfois les ennemis fuient"

msgid "Durchschlag, Abprallen und Zerplatzen"
msgstr "Perce, rebondit et éclate"

msgid "Dämon"
msgstr "Démon"

msgid "Dünne Haut aus einem Fledermausflügel."
msgstr "Fine peau d'une aile de chauve-souris."

msgid "E: Bombe · Tab: Inventar · M: Karte · Esc: Pause"
msgstr "E : bombe · Tab : inventaire · M : carte · Échap : pause"

msgid "EXP: +%d"
msgstr "EXP : +%d"

msgid "Ebene %d"
msgstr "Étage %d"

msgid "Ebene: %d"
msgstr "Étage : %d"

msgid "Effekte"
msgstr "Effets"

msgid "Egon Ehrlich, sehr erfreut. Ehrlich ist mein Name, ehrlich mein Geschäft. Ehrlich!"
msgstr "Egon Honnête, enchanté. Honnête est mon nom, honnête est mon commerce. Honnêtement !"

msgid "Egon könnte klauen!"
msgstr "Egon pourrait voler !"

msgid "Egons Augen werden ganz groß."
msgstr "Les yeux d'Egon s'écarquillent."

msgid "Egons Laden"
msgstr "La boutique d'Egon"

msgid "Eigene Explosionen heilen dich"
msgstr "Tes propres explosions te soignent"

msgid "Ein Berg aus Eis, oben tobt der Sturm. Unterwegs Wölfe, Harpyien und ein Greif. Egon empfiehlt warme Socken."
msgstr "Une montagne de glace, au sommet gronde la tempête. En chemin : loups, harpies et un griffon. Egon conseille des chaussettes chaudes."

msgid "Ein Bernstein, drei Bomben, drei Schlüssel"
msgstr "Un ambre, trois bombes, trois clés"

msgid "Ein Feuerball kreist um dich und blockt Schüsse"
msgstr "Une boule de feu tourne autour de toi et bloque les tirs"

msgid "Ein Funke folgt dir und schießt"
msgstr "Une étincelle te suit et tire"

msgid "Ein Funke und ein Glutmond"
msgstr "Une étincelle et une lune de braise"

msgid "Ein Funke und mehr Glück"
msgstr "Une étincelle et plus de chance"

msgid "Ein Funke, der nicht ausgehen will."
msgstr "Une étincelle qui refuse de s'éteindre."

msgid "Ein Glutpakt hat sich geöffnet"
msgstr "Un pacte de braise s'est ouvert"

msgid "Ein Golderz"
msgstr "Un minerai d'or"

msgid "Ein Heiltrank! Frisch gebraut, fast ohne Nebenwirkungen."
msgstr "Une potion de soin ! Fraîchement brassée, presque sans effets secondaires."

msgid "Ein Herz mehr"
msgstr "Un cœur de plus"

msgid "Ein Herz mehr, Glück hoch"
msgstr "Un cœur de plus, chance en hausse"

msgid "Ein Herz mehr, Schaden hoch"
msgstr "Un cœur de plus, dégâts en hausse"

msgid "Ein Herz mehr, heilt dich ganz"
msgstr "Un cœur de plus, te soigne entièrement"

msgid "Ein Herz und ein blaues Herz"
msgstr "Un cœur et un cœur bleu"

msgid "Ein Herz, Dornen, Explosionen tun dir nichts"
msgstr "Un cœur, des épines, les explosions ne te blessent pas"

msgid "Ein Herz, eine Bombe und ein Schlüssel"
msgstr "Un cœur, une bombe et une clé"

msgid "Ein Herz, eine Münze, eine Bombe und ein Schlüssel"
msgstr "Un cœur, une pièce, une bombe et une clé"

msgid "Ein Herz, zwei blaue Herzen, Schaden hoch"
msgstr "Un cœur, deux cœurs bleus, dégâts en hausse"

msgid "Ein Händler! Geh hin und sprich ihn an."
msgstr "Un marchand ! Va lui parler."

msgid "Ein Kraut in Herzform. Egon kocht Tee daraus."
msgstr "Une herbe en forme de cœur. Egon en fait du thé."

msgid "Ein Platz mehr im Rucksack."
msgstr "Un emplacement de plus dans le sac."

msgid "Ein Portal öffnet sich!"
msgstr "Un portail s'ouvre !"

msgid "Ein Relikt-Platz mehr an deiner Figur."
msgstr "Un emplacement de relique de plus sur ton héros."

msgid "Ein Rubin"
msgstr "Un rubis"

msgid "Ein Schnäppchen! Für mich. Äh… für dich! Ehrlich!"
msgstr "Une affaire ! Pour moi. Euh… pour toi ! Honnêtement !"

msgid "Ein Schrein hat sich geöffnet"
msgstr "Un sanctuaire s'est ouvert"

msgid "Ein Schuss mehr und mehr Schaden"
msgstr "Un tir de plus et plus de dégâts"

msgid "Ein Schuss mehr, aber schwächer"
msgstr "Un tir de plus, mais plus faible"

msgid "Ein Seil fällt vom Himmel!"
msgstr "Une corde tombe du ciel !"

msgid "Ein Silbererz, Glück hoch"
msgstr "Un minerai d'argent, chance accrue"

msgid "Ein Stab mit Feuer-Spitze. Für Magier."
msgstr "Une baguette à pointe de feu. Pour les mages."

msgid "Ein Wolfsfell, drei Bomben, drei Schlüssel"
msgstr "Une peau de loup, trois bombes, trois clés"

msgid "Ein blaues Herz und Dornen"
msgstr "Un cœur bleu et des épines"

msgid "Ein blaues Herz, Schaden hoch"
msgstr "Un cœur bleu, dégâts en hausse"

msgid "Ein blaues Herz, länger sicher nach Treffern"
msgstr "Un cœur bleu, plus longtemps à l'abri après un coup"

msgid "Ein blaues Herz, schneller laufen"
msgstr "Un cœur bleu, tu cours plus vite"

msgid "Ein einfacher Bogen. Für Bogenschützen."
msgstr "Un arc simple. Pour les archers."

msgid "Ein geheimer Raum!"
msgstr "Une salle secrète !"

msgid "Ein halbes weißes Schild-Herz mehr zu Beginn jedes Runs."
msgstr "Un demi-cœur-bouclier blanc de plus au début de chaque partie."

msgid "Ein rotes Herz mehr."
msgstr "Un cœur rouge de plus."

msgid "Ein sicherer Platz mehr im Rucksack."
msgstr "Un emplacement sûr de plus dans le sac."

msgid "Ein zweites Leben"
msgstr "Une seconde vie"

msgid "Ein zweites Leben und ein Funke"
msgstr "Une seconde vie et une étincelle"

msgid "Ein zweites Leben!"
msgstr "Une seconde vie !"

msgid "Eine Sache mehr auf Egons Tisch."
msgstr "Un objet de plus sur la table d'Egon."

msgid "Eine Wiese, so hoch wie ein Zwerg. Im Gras raschelt es, und ein Jäger stellt Fallen. Egon verkauft Sensen. Leider keine."
msgstr "Une prairie haute comme un nain. Ça bruisse dans l'herbe, et un chasseur pose des pièges. Egon vend des faux. Hélas, plus en stock."

msgid "Eine ganze Bäckerei auf einmal"
msgstr "Une boulangerie entière d'un coup"

msgid "Eine kurze Klinge. Für Krieger."
msgstr "Une lame courte. Pour les guerriers."

msgid "Einmal am Tag dreh ich den Tisch umsonst. Danach gibt's einen Freundschaftspreis. Wird jedes Mal ein bisschen freundschaftlicher."
msgstr "Une fois par jour, je tourne la table gratuitement. Ensuite, prix d'ami. Un peu plus amical à chaque fois."

msgid "Einstellungen"
msgstr "Paramètres"

msgid "Eiselementar"
msgstr "Élémentaire de glace"


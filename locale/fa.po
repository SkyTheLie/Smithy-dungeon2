msgid "Ein Herz mehr"
msgstr "یک قلب بیشتر"

msgid "Ein Herz mehr, Glück hoch"
msgstr "یک قلب بیشتر، شانس بالاتر"

msgid "Ein Herz mehr, Schaden hoch"
msgstr "یک قلب بیشتر، آسیب بالاتر"

msgid "Ein Herz mehr, heilt dich ganz"
msgstr "یک قلب بیشتر، کاملاً درمانت می‌کند"

msgid "Ein Herz und ein blaues Herz"

msgid "%d Gold"
msgstr "%d طلا"

msgid "%d Herzen"
msgstr "%d قلب"

msgid "Abbrechen"
msgstr "لغو"

msgid "Aber doch nicht so, ganz ohne Ausrüstung. Komm, schau dir erst meinen Laden an."
msgstr "ولی نه این‌طوری، بدون هیچ تجهیزاتی. بیا، اول یه نگاهی به مغازه‌ام بنداز."

msgid "Acht Bomben"
msgstr "هشت بمب"

msgid "Alle Items abgelegt"
msgstr "همه آیتم‌ها رها شدند"

msgid "Alle Items ablegen"
msgstr "رها کردن همه آیتم‌ها"

msgid "Alle Werte ein bisschen hoch"
msgstr "همه ویژگی‌ها کمی بالاتر"

msgid "Alle paar Besiegten heilst du ein halbes Herz"
msgstr "هر چند دشمن که شکست دهی نیم قلب شفا می‌گیری"

msgid "Alles im Laden kostet die Hälfte"
msgstr "همه چیز در مغازه نصف قیمت است"

msgid "Am Ende zerplatzt jeder Schuss in vier Funken"
msgstr "هر تیر در پایان به چهار جرقه می‌ترکد"

msgid "Amethyst"
msgstr "آمتیست"

msgid "Angriffstempo"
msgstr "سرعت حمله"

msgid "Anzeige"
msgstr "نمایش"

msgid "Arena-Amulett"
msgstr "طلسم میدان"

msgid "Arenaherz"
msgstr "قلب میدان"

msgid "Audio"
msgstr "صدا"

msgid "Aufgeladene Riesenglut schlägt ein und explodiert"
msgstr "اخگر عظیم شارژشده فرود می‌آید و منفجر می‌شود"

msgid "Aufladen, loslassen: ein gewaltiger Feuerstrahl"
msgstr "شارژ کن، رها کن: یک پرتو آتش عظیم"

msgid "Aus dem Dungeon flüchten? Du nimmst alles mit, was du trägst."
msgstr "از سیاه‌چال فرار کنی؟ هرچه همراهت است را نگه می‌داری."

msgid "Ausgang"
msgstr "خروجی"

msgid "Ausrüstung"
msgstr "تجهیزات"

msgid "Ausweichen"
msgstr "جاخالی"

msgid "Axt statt Feuerbällen: schwerer Schwung, Gegner bluten"
msgstr "تبر به جای گلوله آتشین: ضربه سنگین، دشمنان خونریزی می‌کنند"

msgid "Beenden"
msgstr "خروج"

msgid "Beim Treffer zerplatzt der Schuss in vier Funken"
msgstr "هنگام برخورد، گلوله به چهار جرقه تبدیل می‌شود"

msgid "Beine"
msgstr "پاها"

msgid "Bernstein"
msgstr "کهربا"

msgid "Besiege %d Gegner (%d / %d)"
msgstr "%d دشمن را شکست بده (%d / %d)"

msgid "Besiege: %s"
msgstr "شکست بده: %s"

msgid "Besiegte Gegner: %d"
msgstr "دشمنان شکست‌خورده: %d"

msgid "Betreten"
msgstr "ورود"

msgid "Blasebalg"
msgstr "دم آهنگری"

msgid "Blutphiole"
msgstr "شیشه خون"

msgid "Bogenschütze"
msgstr "کماندار"

msgid "Bombe"
msgstr "بمب"

msgid "Bomben schießen beim Explodieren Feuerbälle"
msgstr "بمب‌ها هنگام انفجار گلوله آتشین شلیک می‌کنند"

msgid "Bomben zerplatzen in kleine Bomben"
msgstr "بمب‌ها به بمب‌های کوچک تقسیم می‌شوند"

msgid "Bombengürtel"
msgstr "کمربند بمب"

msgid "Brandöl"
msgstr "روغن آتش"

msgid "Brennend und langsam: mehr Schaden"
msgstr "سوزان و کند: آسیب بیشتر"

msgid "Brennende, explodierende Schüsse"
msgstr "تیرهای سوزان و منفجرشونده"

msgid "Brennende, langsame Gegner und zwei blaue Herzen"
msgstr "دشمنان سوزان و کند، و دو قلب آبی"

msgid "Brennt gut in jeder Esse."
msgstr "در هر کوره‌ای خوب می‌سوزد."

msgid "Bronzebogen"
msgstr "کمان برنزی"

msgid "Bronzeschild"
msgstr "سپر برنزی"

msgid "Brotkanone"
msgstr "توپ نان"

msgid "Brotregen"
msgstr "باران نان"

msgid "Brust"
msgstr "سینه"

msgid "Bumerang-Haken"
msgstr "قلاب بومرنگی"

msgid "Da hinten geht's in den Dungeon der Glut. Manche kommen sogar wieder raus!"
msgstr "اون پشت راه سیاه‌چال اخگره. بعضی‌ها حتی برمی‌گردن بیرون!"

msgid "Dafür reicht dein Gold nicht, Partner. Leider, leider."
msgstr "طلات برای این کافی نیست، رفیق. حیف، حیف."

msgid "Darin steckt ein kleines Krabbeltier."
msgstr "یک حشره‌ی کوچک داخلش گیر افتاده."

msgid "Das kann man nicht anziehen, Partner. Glaub mir, ich hab's versucht."
msgstr "این پوشیدنی نیست، رفیق. باور کن، امتحان کردم."

msgid "Das kostet zu viel Leben"
msgstr "این زندگی زیادی می‌گیرد"

msgid "Defensiv"
msgstr "دفاعی"

msgid "Deine Feuerbälle zerstören Gegner-Schüsse"
msgstr "گلوله‌های آتشین تو تیرهای دشمن را نابود می‌کنند"

msgid "Deine Items"
msgstr "آیتم‌های تو"

msgid "Deine Schüsse verfolgen Gegner"
msgstr "گلوله‌هایت دشمن را دنبال می‌کنند"

msgid "Der Feuerstrahl biegt sich zum Gegner"
msgstr "پرتو آتش به سمت دشمن خم می‌شود"

msgid "Der Stein nimmt dein Opfer an"
msgstr "سنگ قربانی تو را می‌پذیرد"

msgid "Der Weg nach unten ist frei!"
msgstr "راه پایین باز شد!"

msgid "Diamantherz"
msgstr "قلب الماس"

msgid "Die Fenstergröße gilt nur im Fenster-Modus."
msgstr "اندازه‌ی پنجره فقط در حالت پنجره‌ای اعمال می‌شود."

msgid "Die Waffe des Bogenschützen: Pfeile aufladen und loslassen, weit und stark"
msgstr "سلاح کماندار: تیر را پر کن و رها کن، دور و قوی"

msgid "Die Waffe des Kriegers: ein Schwertschwung trifft alle vor dir"
msgstr "سلاح جنگجو: یک ضربه‌ی شمشیر به همه‌ی جلوی تو می‌خورد"

msgid "Die Waffe des Magiers: schießt Feuerbälle"
msgstr "سلاح جادوگر: گلوله‌های آتشین شلیک می‌کند"

msgid "Dietrich"
msgstr "شاه‌کلید"

msgid "Doppelschuss"
msgstr "شلیک دوتایی"

msgid "Dornenpanzer"
msgstr "زره خاردار"

msgid "Drachenatem"
msgstr "نفس اژدها"

msgid "Drachenhaut"
msgstr "پوست اژدها"

msgid "Drachenleder"
msgstr "چرم اژدها"

msgid "Drachenmantel"
msgstr "ردای اژدها"

msgid "Drei Funken folgen dir und schießen"
msgstr "سه جرقه دنبالت می‌آیند و شلیک می‌کنند"

msgid "Drei Schlüssel, Rabatt im Laden"
msgstr "سه کلید، تخفیف در مغازه"

msgid "Drei blaue Herzen"
msgstr "سه قلب آبی"

msgid "Drei blaue Herzen und manchmal ausweichen"
msgstr "سه قلب آبی و گاهی جاخالی"

msgid "Dreifachschuss"
msgstr "شلیک سه‌تایی"

msgid "Dreizack-Rune"
msgstr "رون سه‌شاخه"

msgid "Dreißig Münzen und zehn Schlüssel"
msgstr "سی سکه و ده کلید"

msgid "Du bist gefallen"
msgstr "از پا افتادی"

msgid "Du brauchst einen Schlüssel"
msgstr "به یک کلید نیاز داری"

msgid "Du hast den Dungeon bezwungen!"
msgstr "سیاه‌چال را فتح کردی!"

msgid "Du hast nicht genug Leben"
msgstr "زندگی کافی نداری"

msgid "Du läufst schneller"
msgstr "سریع‌تر می‌دوی"

msgid "Du schießt Brotlaibe. Getroffene Gegner vergessen dich und rennen weg"
msgstr "نان شلیک می‌کنی. دشمنانِ خورده تو را فراموش می‌کنند و فرار می‌کنند"

msgid "Du schießt auch nach hinten"
msgstr "به عقب هم شلیک می‌کنی"

msgid "Du schießt schneller"
msgstr "سریع‌تر شلیک می‌کنی"

msgid "Du wirfst Bomben statt Feuerbällen"
msgstr "به جای گوی آتش بمب پرتاب می‌کنی"

msgid "Du wirfst Wurfsterne, getroffene Gegner bluten"
msgstr "ستاره پرتابی می‌اندازی، دشمنان آسیب‌دیده خونریزی می‌کنند"

msgid "Du wirst größer: mehr Herzen und Schaden, leichter zu treffen"
msgstr "بزرگ‌تر می‌شوی: قلب و آسیب بیشتر، راحت‌تر مورد اصابت"

msgid "Du wirst kleiner und schneller"
msgstr "کوچک‌تر و سریع‌تر می‌شوی"

msgid "Du wirst kleiner: schwerer zu treffen, schneller"
msgstr "کوچک می‌شوی: سخت‌تر مورد اصابت، سریع‌تر"

msgid "Du wirst viel größer und stärker, aber langsamer"
msgstr "خیلی بزرگ‌تر و قوی‌تر، اما کندتر می‌شوی"

msgid "Du wirst winzig und manchmal weichst du aus"
msgstr "ریز می‌شوی و گاهی جاخالی می‌دهی"

msgid "Dungeon der Glut"
msgstr "سیاه‌چال اخگر"

msgid "Dungeon-Brett"
msgstr "تابلوی سیاه‌چال‌ها"

msgid "Dungeons"
msgstr "سیاه‌چال‌ها"

msgid "Dunkler Zauberstab"
msgstr "عصای تاریک"

msgid "Durch Gegner hindurch und von Wand zu Wand"
msgstr "از میان دشمنان و از دیوار به دیوار"

msgid "Durch Steine, und manchmal fliehen Gegner"
msgstr "از میان سنگ‌ها، و گاهی دشمنان فرار می‌کنند"

msgid "Durchschlag, Abprallen und Zerplatzen"
msgstr "نفوذ، کمانه و ترکیدن"

msgid "Dünne Haut aus einem Fledermausflügel."
msgstr "پوست نازک بال خفاش."

msgid "E: Bombe · Tab: Inventar · M: Karte · Esc: Pause"
msgstr "E: بمب · Tab: کوله · M: نقشه · Esc: توقف"

msgid "Ebene %d"
msgstr "طبقه %d"

msgid "Ebene: %d"
msgstr "طبقه: %d"

msgid "Effekte"
msgstr "افکت‌ها"

msgid "Egon Ehrlich, sehr erfreut. Ehrlich ist mein Name, ehrlich mein Geschäft. Ehrlich!"
msgstr "اگون صادق، خوشوقتم. صادق اسم منه، صادق کسب‌وکار من. صادقانه!"

msgid "Egons Laden"
msgstr "مغازهٔ اگون"

msgid "Eigene Explosionen heilen dich"
msgstr "انفجارهای خودت تو را شفا می‌دهند"

msgid "Ein Feuerball kreist um dich und blockt Schüsse"
msgstr "یک گوی آتش دورت می‌چرخد و گلوله‌ها را دفع می‌کند"

msgid "Ein Funke folgt dir und schießt"
msgstr "جرقه‌ای دنبالت می‌آید و شلیک می‌کند"

msgid "Ein Funke und ein Glutmond"
msgstr "یک جرقه و یک ماه اخگر"

msgid "Ein Funke und mehr Glück"
msgstr "یک جرقه و شانس بیشتر"

msgid "Ein Glutpakt hat sich geöffnet"
msgstr "یک پیمان اخگر باز شد"

msgid "Ein Herz mehr"
msgstr "یک قلب بیشتر"

msgid "Ein Herz mehr, Glück hoch"
msgstr "یک قلب بیشتر، شانس بالاتر"

msgid "Ein Herz mehr, Schaden hoch"
msgstr "یک قلب بیشتر، آسیب بالاتر"

msgid "Ein Herz mehr, heilt dich ganz"
msgstr "یک قلب بیشتر، کاملاً درمانت می‌کند"

msgid "Ein Herz und ein blaues Herz"
msgstr "یک قلب و یک قلب آبی"

msgid "Ein Herz, Dornen, Explosionen tun dir nichts"
msgstr "یک قلب، خار، و انفجارها آسیبی نمی‌زنند"

msgid "Ein Herz, eine Münze, eine Bombe und ein Schlüssel"
msgstr "یک قلب، یک سکه، یک بمب و یک کلید"

msgid "Ein Herz, zwei blaue Herzen, Schaden hoch"
msgstr "یک قلب، دو قلب آبی، آسیب بالاتر"

msgid "Ein Schrein hat sich geöffnet"
msgstr "یک زیارتگاه باز شد"

msgid "Ein Schuss mehr und mehr Schaden"
msgstr "یک تیر بیشتر و آسیب بیشتر"

msgid "Ein Schuss mehr, aber schwächer"
msgstr "یک تیر بیشتر، اما ضعیف‌تر"

msgid "Ein Stab mit Feuer-Spitze. Für Magier."
msgstr "عصایی با نوک آتشین. برای جادوگران."

msgid "Ein blaues Herz und Dornen"
msgstr "یک قلب آبی و خار"

msgid "Ein blaues Herz, Schaden hoch"
msgstr "یک قلب آبی، آسیب بالاتر"

msgid "Ein blaues Herz, länger sicher nach Treffern"
msgstr "یک قلب آبی، بعد از ضربه مدت بیشتری امنی"

msgid "Ein blaues Herz, schneller laufen"
msgstr "یک قلب آبی، سریع‌تر راه می‌روی"

msgid "Ein einfacher Bogen. Für Bogenschützen."
msgstr "یک کمان ساده. برای کمانداران."

msgid "Ein geheimer Raum!"
msgstr "یک اتاق مخفی!"

msgid "Ein zweites Leben"
msgstr "زندگی دوم"

msgid "Ein zweites Leben und ein Funke"
msgstr "زندگی دوم و یک جرقه"

msgid "Ein zweites Leben!"
msgstr "زندگی دوم!"

msgid "Eine ganze Bäckerei auf einmal"
msgstr "یک نانوایی کامل یک‌جا"

msgid "Eine kurze Klinge. Für Krieger."
msgstr "یک تیغه کوتاه. برای جنگجویان."

msgid "Einmal am Tag dreh ich den Tisch umsonst. Danach gibt's einen Freundschaftspreis. Wird jedes Mal ein bisschen freundschaftlicher."
msgstr "روزی یه بار میز رو مجانی می‌چرخونم. بعدش قیمت دوستانه‌ست. هر بار یه کم دوستانه‌تر."

msgid "Einstellungen"
msgstr "تنظیمات"

msgid "Eisenerz"
msgstr "سنگ آهن"

msgid "Eisenhaut"
msgstr "پوست آهنین"


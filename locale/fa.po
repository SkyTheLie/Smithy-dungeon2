msgid "Gekauft! Das Relikt wartet zu Hause im Inventar."
msgstr "خریداری شد! یادگار در خانه در کوله‌پشتی منتظر است."

msgid "Gelb"
msgstr "زرد"

msgid "Geldbündel: %d Gold"
msgstr "دسته‌ی پول: %d طلا"

msgid "Gelernt"
msgstr "یاد گرفته شد"

msgid "Generalsklinge"
msgstr "تیغ ژنرال"

msgid "Gerettet (sicherer Platz): %d Beute"
msgstr "نجات‌یافته (جای امن): %d غنیمت"


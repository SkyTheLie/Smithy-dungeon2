msgstr "تاج آتش"

msgid "Feuerlanze"
msgstr "نیزه‌ی آتش"

msgid "Feuerstab"
msgstr "عصای آتش"

msgid "Feuerstrahl statt Feuerbällen: Maustaste halten"
msgstr "پرتو آتش به جای گوی آتش: دکمه را نگه دار"

msgid "Feuerwerk"
msgstr "آتش‌بازی"

msgid "Flechtenleder"
msgstr "چرم گلسنگ"

msgid "Flechtenmantel"
msgstr "ردای گلسنگ"

msgid "Fledermaus"
msgstr "خفاش"

msgid "Flipper"
msgstr "پین‌بال"

msgid "Fluchskelett"
msgstr "اسکلت نفرین‌شده"

msgid "Flughaut"
msgstr "پوست خفاش"

msgid "Flüchten"
msgstr "فرار"

msgid "Flüstert leise, wenn es dunkel ist."
msgstr "وقتی تاریک است آرام زمزمه می‌کند."

msgid "Freigeschaltet: %s"
msgstr "باز شد: %s"

msgid "Frost und Feuer"
msgstr "یخ و آتش"

msgid "Frostflechte"
msgstr "گلسنگ یخی"

msgid "Frostkristall"
msgstr "بلور یخ"

msgid "Frostmähne"
msgstr "یال یخی"

msgid "Funkenbüchse"
msgstr "قوطی جرقه"

msgid "Funkenfänger"
msgstr "شکارچی جرقه"

msgid "Funkenstein"
msgstr "سنگ جرقه"

msgid "Fängt den einen oder anderen Kratzer ab."
msgstr "یکی دو تا خراش رو می‌گیره."

msgid "Fängt in jedem Raum den ersten Treffer ab"
msgstr "در هر اتاق اولین ضربه را دفع می‌کند"

msgid "Fünf Bomben, und Explosionen tun dir nichts mehr"
msgstr "پنج بمب، و انفجارها دیگر به تو آسیب نمی‌زنند"

msgid "Fünf Münzen, drei Bomben, drei Schlüssel"
msgstr "پنج سکه، سه بمب، سه کلید"

msgid "Fünf Schlüssel"
msgstr "پنج کلید"

msgid "Fünfzehn Münzen"
msgstr "پانزده سکه"

msgid "Für Schritte, die man lieber nicht hört."
msgstr "برای قدم‌هایی که بهتره شنیده نشن."

msgid "Für dich: ein Kupfer-Zauberstab, ein Helm und eine Brustplatte. Der erste Einkauf geht aufs Haus!"
msgstr "برای تو: یه عصای مسی، یه کلاه‌خود و یه زره سینه. اولین خرید مهمون من!"

msgid "Füße"
msgstr "پاها (کفش)"

msgid "Gebiete: %s"
msgstr "مناطق: %s"

msgid "Geflüchtet!"
msgstr "فرار کردی!"

msgid "Gegabelter Stab"
msgstr "عصای دوشاخه"

msgid "Gegner brennen, Schaden hoch"
msgstr "دشمنان می‌سوزند، آسیب بالاتر"

msgid "Gegner werden langsamer, Reichweite hoch"
msgstr "دشمنان کند می‌شوند، برد بالاتر"

msgid "Gegner, die dich berühren, nehmen Schaden"
msgstr "دشمنانی که به تو برخورد کنند آسیب می‌بینند"

msgid "Geist"
msgstr "روح"

msgid "Geisterfürst"
msgstr "سرور ارواح"

msgid "Geisterglas"
msgstr "شیشه روح"

msgid "Geisterstab"
msgstr "عصای روح"

msgid "Geldbündel: %d Gold"
msgstr "دسته‌ی پول: %d طلا"

msgid "Generalsklinge"
msgstr "تیغ ژنرال"

msgid "Gerettet (sicherer Platz): %d Beute"
msgstr "نجات‌یافته (جای امن): %d غنیمت"

msgid "Geschafft!"
msgstr "موفق شدی!"

msgid "Gesperrt"
msgstr "قفل"

msgid "Gesprengte Fessel"
msgstr "زنجیر شکسته"

msgid "Getroffene Gegner brennen weiter"
msgstr "دشمنان آسیب‌دیده به سوختن ادامه می‌دهند"

msgid "Getroffene Gegner fliehen vor dir"
msgstr "دشمنان آسیب‌دیده از تو فرار می‌کنند"

msgid "Getroffene Gegner frieren ein"
msgstr "دشمنان آسیب‌دیده یخ می‌زنند"

msgid "Getroffene Gegner frieren kurz ein"
msgstr "دشمنان آسیب‌دیده لحظه‌ای یخ می‌زنند"

msgid "Getroffene Gegner torkeln herum"
msgstr "دشمنان آسیب‌دیده تلوتلو می‌خورند"

msgid "Getroffene Gegner werden langsam und vergiftet"
msgstr "دشمنان آسیب‌دیده کند و مسموم می‌شوند"

msgid "Getroffene Gegner werden langsamer"
msgstr "دشمنان آسیب‌دیده کند می‌شوند"

msgid "Getroffene Gegner werden vergiftet"
msgstr "دشمنان آسیب‌دیده مسموم می‌شوند"

msgid "Gewinne %d Runs"
msgstr "%d بار برنده شو"

msgid "Gewinne einen Run"
msgstr "یک بار برنده شو"

msgid "Gewinne in unter %d Minuten"
msgstr "در کمتر از %d دقیقه برنده شو"

msgid "Gewöhnlich"
msgstr "معمولی"

msgid "Ghul"
msgstr "غول"

msgid "Giftratte"
msgstr "موش سمی"

msgid "Giftstab"
msgstr "عصای زهر"

msgid "Giftzahn"
msgstr "دندان زهری"

msgid "Gleich hinter Egons Laden geht es hinunter. Ganz unten wartet ein Boss, und angeblich ein Schatz. Sagt Egon."
msgstr "درست پشت مغازهٔ اگون راه به پایین می‌رود. آن پایین یک غول منتظر است، و ظاهراً یک گنج. اگون این‌طور می‌گوید."

msgid "Glutkern"
msgstr "هسته‌ی اخگر"

msgid "Glutklinge"
msgstr "تیغ اخگر"

msgid "Glutmantel"
msgstr "ردای اخگر"


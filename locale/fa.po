msgid "Für dich: ein Kupfer-Zauberstab, ein Helm und eine Brustplatte. Der erste Einkauf geht aufs Haus!"
msgstr "برای تو: یه عصای مسی، یه کلاه‌خود و یه زره سینه. اولین خرید مهمون من!"

msgid "Füße"
msgstr "پاها (کفش)"

msgid "Ganz unten wartet ein Schatz, sagt Egon. Ganz unten wartet ein Lich, sag ich."
msgstr "اگون می‌گوید آن پایینِ پایین گنجی منتظر است. من می‌گویم آن پایین یک لیچ منتظر است."

msgid "Gebiete: %s"
msgstr "مناطق: %s"

msgid "Gebirge"
msgstr "کوهستان"

msgid "Geflüchtet!"
msgstr "فرار کردی!"

msgid "Gegabelter Stab"
msgstr "عصای دوشاخه"

msgid "Gegner"
msgstr "دشمنان"

msgid "Gegner brennen, Schaden hoch"
msgstr "دشمنان می‌سوزند، آسیب بالاتر"

msgid "Gegner werden langsamer, Reichweite hoch"
msgstr "دشمنان کند می‌شوند، برد بالاتر"

msgid "Gegner, die dich berühren, nehmen Schaden"
msgstr "دشمنانی که به تو برخورد کنند آسیب می‌بینند"

msgid "Gegner:"
msgstr "دشمنان:"

msgid "Geheimtasche"

msgid "Glutstab"
msgstr "عصای اخگر"

msgid "Glutstollen"
msgstr "تونل‌های اخگر"

msgid "Glänzt grünlich. Der Händler mag es."
msgstr "سبز می‌درخشد. تاجر دوستش دارد."

msgid "Glänzt sogar im Dunkeln."
msgstr "حتی در تاریکی می‌درخشد."

msgid "Glänzt wie der Mond. Der Händler wird ganz still."
msgstr "مثل ماه می‌درخشد. فروشنده کاملاً ساکت می‌شود."

msgid "Glück"
msgstr "شانس"

msgid "Glück +0,5: öfter Beute."
msgstr "شانس +۰٫۵: غنیمت بیشتر."

msgid "Glück hoch"
msgstr "شانس بالاتر"

msgid "Glück und Schaden hoch"
msgstr "شانس و آسیب بالاتر"

msgid "Glück viel höher"

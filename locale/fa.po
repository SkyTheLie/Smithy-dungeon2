msgstr "تیرهای انفجاری، شلیک کندتر"

msgid "Fahre mit der Maus über ein Item"
msgstr "ماوس را روی یک آیتم ببر"

msgid "Feenstaub"
msgstr "گرد پری"

msgid "Fein"
msgstr "ظریف"

msgid "Fenster"
msgstr "پنجره"

msgid "Fenstergröße"
msgstr "اندازه‌ی پنجره"


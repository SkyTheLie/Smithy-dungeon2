msgstr "سبز"

msgid "Grün wie das Moor, nur teurer."
msgstr "سبز مثل مرداب، فقط گران‌تر."

msgid "Gut gemacht! Jetzt ab in den Dungeon."
msgstr "آفرین! حالا برو داخل سیاه‌چال."

msgid "Gute Wahl! Ein Sammlerstück. Ehrlich!"
msgstr "انتخاب خوبی بود! یه تیکه‌ی کلکسیونی. صادقانه!"

msgid "Habe %d Herz-Container gleichzeitig"
msgstr "همزمان %d ظرف قلب داشته باش"

msgid "Habe %d Münzen gleichzeitig"
msgstr "همزمان %d سکه داشته باش"

msgid "Habe %d blaue Herzen gleichzeitig"
msgstr "همزمان %d قلب آبی داشته باش"

msgid "Halb Fell, halb Feder."
msgstr "نیمی پوست، نیمی پر."

msgid "Harpyie"
msgstr "هارپی"

msgid "Harpyien-Matriarchin"
msgstr "مادرسالار هارپی‌ها"

msgid "Harpyienfeder"
msgstr "پر هارپی"

msgid "Hauptmenü"
msgstr "منوی اصلی"

msgid "Heilen durch Besiegte, Schaden hoch"
msgstr "با شکست دشمنان شفا، آسیب بالاتر"

msgid "Heilerkräuter"
msgstr "گیاهان شفا"

msgid "Heilt %s Herzen"
msgstr "%s قلب را شفا می‌دهد"

msgid "Heilt dich ganz, schneller laufen"
msgstr "تو را کامل درمان می‌کند، سریع‌تر راه می‌روی"

msgid "Heilt drei Herzen. Doppelt so viel Kirsche, halb so viel Socke."
msgstr "سه قلب را شفا می‌دهد. دو برابر گیلاس، نصف جوراب."

msgid "Heilt zwei Herzen. Schmeckt nach Kirsche. Und ein bisschen nach Socke."
msgstr "دو قلب را شفا می‌دهد. طعم گیلاس می‌دهد. و کمی طعم جوراب."

msgid "Heiltrank"
msgstr "معجون شفا"

msgid "Heiß. Heiß. Heiß. Ich hätte Bäcker werden sollen."
msgstr "داغ. داغ. داغ. باید نانوا می‌شدم."

msgid "Heißer Sand"
msgstr "شن داغ"

msgid "Hereinspaziert! Frische Ware!"
msgstr "بفرمایید! جنس تازه!"

msgid "Herzblatt"
msgstr "برگ دل"

msgid "Herzen"
msgstr "قلب‌ها"

msgid "Herzen heilen doppelt"
msgstr "قلب‌ها دو برابر شفا می‌دهند"

msgid "Hexenkessel"
msgstr "دیگ جادوگر"

msgid "Hier klicken"
msgstr "اینجا کلیک کن"

msgid "Hier liegt, was nicht ins Lager passt. Mach Platz oder verkauf es."
msgstr "هرچه در انبار جا نشود اینجاست. جا باز کن یا بفروشش."

msgid "Hier passt eine ganze Ritterkompanie rein. Fast."
msgstr "یک گروه کامل شوالیه اینجا جا می‌شود. تقریباً."

msgid "Hier war Gundolf. Gundolf war nicht lange hier."
msgstr "گوندولف اینجا بود. گوندولف زیاد اینجا نماند."

msgid "Hinausgeklettert!"
msgstr "بیرون آمدی!"

msgid "Hinter dem Tor wartet etwas"
msgstr "چیزی پشت دروازه منتظر است"

msgid "Hinter dem Wald liegt ein Moor voller Lichter. Wer ihnen folgt, kommt nicht wieder. Sagt Egon. Er verkauft Laternen."
msgstr "پشت جنگل مردابی پر از نور است. هر کس دنبالشان برود برنمی‌گردد. این را اگون می‌گوید. او فانوس می‌فروشد."

msgid "Hippogreif"
msgstr "هیپوگریف"

msgid "Hohes Gras"
msgstr "علف بلند"

msgid "Holzstab"
msgstr "عصای چوبی"

msgid "Hydraschuppe"
msgstr "فلس هیدرا"

msgid "Hält für immer"
msgstr "برای همیشه می‌ماند"

msgid "Hält noch %d Dungeons"
msgstr "%d سیاه‌چال دیگر دوام می‌آورد"

msgid "Hält vier Runs, dann ist es hin. Wie alles Gute. Gratis! Diesmal wirklich."
msgstr "چهار دور دوام می‌آورد، بعد تمام. مثل همهٔ چیزهای خوب. مجانی! این بار واقعاً."

msgid "Hände"
msgstr "دست‌ها"

msgid "Höchstens ein halbes Herz pro Treffer, aber langsamer"
msgstr "حداکثر نیم قلب در هر ضربه، اما کندتر"

msgid "Höchstens ein halbes Herz pro Treffer, länger sicher"
msgstr "حداکثر نیم قلب در هر ضربه، مدت امن بیشتر"

msgid "Höhere Stufen kommen mit deiner Spielerstufe."
msgstr "سطوح بالاتر با سطح بازیکن می‌آیند."

msgid "Höhlentroll"
msgstr "ترول غار"

msgid "Höllenhund"
msgstr "سگ دوزخی"

msgid "Höllenhundfell"
msgstr "پوست سگ جهنمی"

msgid "Höllenleder"
msgstr "چرم جهنمی"

msgid "Höllenstab"
msgstr "عصای جهنمی"

msgid "Höllentor"
msgstr "دروازه دوزخ"

msgid "Höllenwächter"
msgstr "نگهبان دوزخ"

msgid "Hörst du das? Er summt! Das Geld … äh, das Glück summt mit."
msgstr "می‌شنوی؟ وزوز می‌کند! پول… اِ، بخت هم همراهش وزوز می‌کند."

msgid "Ich bin der Gau… äh, der Mann-Verkäufer. Ich verkaufe Mann… …Ausrüstung! Ja, genau. Ich verkaufe Ausrüstung."
msgstr "من کلاه‌بر… اِه، فروشنده‌ام. من… …تجهیزات می‌فروشم! آره، دقیقاً. تجهیزات می‌فروشم."

msgid "Ich steck ihn dir rein. Kostenlos! Das Reinstecken, mein ich."
msgstr "من برایت می‌گذارمش. مجانی! منظورم گذاشتنش است."

msgid "Ich warte hier. Sicher ist sicher."
msgstr "من همین‌جا منتظر می‌مانم. احتیاط شرط عقل است."

msgid "Im Dungeon drückst du %s. Gluck, gluck, und zwei Herzen sind wieder da."
msgstr "در سیاه‌چال %s را فشار می‌دهی. قلپ، قلپ، و دو قلب برمی‌گردد."

msgid "Im Dungeon: %s trinkt ihn"
msgstr "در سیاه‌چال: %s برای نوشیدن"

msgid "Im Glutschlund wohnt ein Drache. Sein Herz glüht. Bring es mir, und ich … ich bin sehr, sehr dankbar. Ehrlich!"
msgstr "در گلوگاه آتش اژدهایی زندگی می‌کند. قلبش می‌درخشد. برایم بیاورش و من… خیلی خیلی ممنون می‌شوم. راست می‌گویم!"

msgid "Im Moor trägt der Endboss einen Irrlicht-Opal. Hübsch. Sehr hübsch. Bring ihn mir, ich … verwahre ihn. Ganz legal!"
msgstr "در مرداب، غول آخر یک عقیق شبتاب دارد. قشنگ. خیلی قشنگ. برایم بیاورش، من… نگهش می‌دارم. کاملاً قانونی!"

msgid "Im Vulkan brodelt die Lava, ganz unten steht ein Tor. Egon war nie dort. Sagt er. Seine Stiefel sind aber angesengt."
msgstr "در آتشفشان گدازه می‌جوشد و ته آن دروازه‌ای است. اگون هرگز آنجا نبوده. خودش این‌طور می‌گوید. ولی چکمه‌هایش سوخته است."

msgid "In den Dungeon nimmst du kein Gold mit. Unten kauft dir mein Kollege Beute ab, fast so ehrlich wie ich."
msgstr "به سیاه‌چال طلا نمی‌بری. آن پایین همکارم غنیمتت را می‌خرد، تقریباً به صداقت من."

msgid "Inventar"
msgstr "کوله‌پشتی"

msgid "Inventar im Dungeon"
msgstr "کیف در سیاه‌چال"

msgid "Inventar voll!"
msgstr "کوله‌پشتی پر است!"

msgid "Inventar: das nimmst du mit in den Dungeon"
msgstr "کیف: این را با خودت به سیاه‌چال می‌بری"

msgid "Irrlicht"
msgstr "آتش سرگردان"

msgid "Irrlicht-Glut"
msgstr "اخگر آتش سرگردان"

msgid "Irrlicht-Opal"
msgstr "عقیق شبتاب"

msgid "Irrlichtkönigin"
msgstr "ملکه آتش‌های سرگردان"

msgid "Items"
msgstr "آیتم‌ها"

msgid "Jadefigur"
msgstr "پیکره یشم"

msgid "Jagdbogen"
msgstr "کمان شکار"

msgid "Jagdgrund"
msgstr "شکارگاه"

msgid "Je weiter der Schuss fliegt, desto mehr Schaden"
msgstr "هرچه تیر دورتر برود، آسیب بیشتر است"

msgid "Jede Münze gibt 2 Gold mehr."
msgstr "هر سکه ۲ طلای بیشتر می‌دهد."

msgid "Jeder Treffer jagt Gegnern Angst ein"
msgstr "هر ضربه دشمنان را می‌ترساند"

msgid "Jeder Treffer macht dich auf dieser Ebene stärker"
msgstr "هر ضربه‌ای که می‌خوری تو را در این طبقه قوی‌تر می‌کند"

msgid "Jeder weitere Dreh heute: %d %% von R1 zu den selteneren Stufen (höchstens %d %%)."
msgstr "هر چرخش بیشتر امروز: %d %% از R1 به سطح‌های کمیاب‌تر (حداکثر %d %%)."

msgid "Jeder zweite Schuss ist viel stärker"
msgstr "هر تیر دوم خیلی قوی‌تر است"

msgid "Jetzt zum Glutschlund, Partner. Da ist es wenigstens warm."
msgstr "حالا برویم گلوگاه آتش، رفیق. لااقل آنجا گرم است."

msgid "Kalt! Kalt! Aber schön. Wie meine Preise."
msgstr "سرد! سرد! ولی قشنگ. مثل قیمت‌های من."

msgid "Kamille"
msgstr "بابونه"

msgid "Kampf"
msgstr "نبرد"

msgid "Kampfhand"
msgstr "دست جنگجو"

msgid "Kann ab jetzt im Dungeon auftauchen"
msgstr "از حالا ممکن است در سیاه‌چال پیدا شود"

msgid "Kapuze"

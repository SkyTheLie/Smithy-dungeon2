msgstr "چشم‌های اگون گرد می‌شود."

msgid "Egons Glutrubin"
msgstr "یاقوت اخگر اگون"

msgid "Egons Laden"
msgstr "مغازهٔ اگون"

msgid "Egons Laterne ging nach einer Stunde aus. Garantie: eine Stunde."
msgstr "فانوس اگون بعد از یک ساعت خاموش شد. ضمانت: یک ساعت."

msgid "Eigene"
msgstr "دلخواه"

msgid "Eigene Explosionen heilen dich"
msgstr "انفجارهای خودت تو را شفا می‌دهند"

msgid "Ein Berg aus Eis, oben tobt der Sturm. Unterwegs Wölfe, Harpyien und ein Greif. Egon empfiehlt warme Socken."
msgstr "کوهی از یخ که بالایش طوفان می‌غرد. در راه گرگ‌ها، هارپی‌ها و یک شیردال. اگون جوراب گرم توصیه می‌کند."

msgid "Ein Bernstein, drei Bomben, drei Schlüssel"
msgstr "یک کهربا، سه بمب، سه کلید"

msgid "Ein Fass ohne Boden. Fast ohne."
msgstr "بشکه‌ای بی‌ته. تقریباً."

msgid "Ein Feuerball kreist um dich und blockt Schüsse"
msgstr "یک گوی آتش دورت می‌چرخد و گلوله‌ها را دفع می‌کند"


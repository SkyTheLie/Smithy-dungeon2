msgstr "قفل: اول %s را تمام کن."

msgid "Gesperrt: erst Egons Quest „%s“ erledigen."
msgstr "قفل: اول مأموریت اگون «%s» را انجام بده."

msgid "Gesprengte Fessel"
msgstr "زنجیر شکسته"

msgid "Getauscht ist getauscht! Kein Umtausch. Äh … kein Rücktausch."
msgstr "معامله معامله است! پس‌گرفتن نداریم. اِ… پس‌دادن هم نداریم."

msgid "Getroffene Gegner brennen weiter"
msgstr "دشمنان آسیب‌دیده به سوختن ادامه می‌دهند"

msgid "Getroffene Gegner fliehen vor dir"
msgstr "دشمنان آسیب‌دیده از تو فرار می‌کنند"

msgid "Getroffene Gegner frieren ein"
msgstr "دشمنان آسیب‌دیده یخ می‌زنند"

msgid "Getroffene Gegner frieren kurz ein"
msgstr "دشمنان آسیب‌دیده لحظه‌ای یخ می‌زنند"

msgid "Getroffene Gegner torkeln herum"
msgstr "دشمنان آسیب‌دیده تلوتلو می‌خورند"

msgid "Getroffene Gegner werden langsam und vergiftet"
msgstr "دشمنان آسیب‌دیده کند و مسموم می‌شوند"

msgid "Getroffene Gegner werden langsamer"
msgstr "دشمنان آسیب‌دیده کند می‌شوند"

msgid "Getroffene Gegner werden vergiftet"
msgstr "دشمنان آسیب‌دیده مسموم می‌شوند"

msgid "Gewinne %d Runs"
msgstr "%d بار برنده شو"

msgid "Gewinne einen Run"
msgstr "یک بار برنده شو"

msgid "Gewinne in unter %d Minuten"
msgstr "در کمتر از %d دقیقه برنده شو"

msgid "Gewöhnlich"
msgstr "معمولی"

msgid "Gezählt wird alles zu Hause: Lager, Inventar und Behälter."
msgstr "همه‌چیز در خانه حساب می‌شود: انبار، کوله و ظرف‌ها."

msgid "Ghul"
msgstr "غول"

msgid "Gib her, gib her! Bei mir ist er sicher. Sicherer als dein Gold in der Dose. Ehrlich!"
msgstr "بده، بده! پیش من امن است. امن‌تر از طلای تو در قوطی. صادقانه!"

msgid "Giftratte"
msgstr "موش سمی"

msgid "Giftschleim"
msgstr "لجن سمی"

msgid "Giftstab"
msgstr "عصای زهر"

msgid "Giftzahn"
msgstr "دندان زهری"

msgid "Glatt, grün und noch ein bisschen warm."
msgstr "صاف، سبز و هنوز کمی گرم."

msgid "Gleich hinter Egons Laden geht es hinunter. Ganz unten wartet ein Boss, und angeblich ein Schatz. Sagt Egon."
msgstr "درست پشت مغازهٔ اگون راه به پایین می‌رود. آن پایین یک غول منتظر است، و ظاهراً یک گنج. اگون این‌طور می‌گوید."

msgid "Gleich unten haust ein Boss, und der hat einen Rubin. Bring ihn mir! Der gehört mir nämlich. Also… fast. Ehrlich!"
msgstr "همین پایین یک رئیس زندگی می‌کند که یک یاقوت دارد. برایم بیاورش! آخر مال من است. خب… تقریباً. صادقانه!"

msgid "Glutdrache"
msgstr "اژدهای اخگر"

msgid "Glutessenz"
msgstr "جوهر اخگر"

msgid "Glutgeist"
msgstr "روح اخگر"

msgid "Glutkern"

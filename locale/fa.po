msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: fa\n"

msgid "%d Gold"
msgstr "%d طلا"

msgid "%d Herzen"
msgstr "%d قلب"

msgid "%d Skillpunkte"
msgstr "%d امتیاز مهارت"

msgid "%s: ab Stufe %d"
msgstr "%s: از سطح %d"

msgid "%s: nach %s"
msgstr "%s: پس از %s"

msgid "3 % Chance auf R3 bei Egon."
msgstr "۳٪ شانس R3 پیش اگون."

msgid "300 Gold mehr sind in der Dose sicher."
msgstr "۳۰۰ طلای بیشتر در قوطی امن است."

msgid "5 % mehr Chance auf R2 bei Egon."
msgstr "۵٪ شانس بیشتر برای R2 پیش اگون."

msgid "Ab Spielerstufe %d"
msgstr "از سطح بازیکن %d"

msgid "Ab Stufe %d"
msgstr "از سطح %d"

msgid "Ab jetzt liegen öfter Tränke auf meinem Tisch. Zum Freundschaftspreis, versteht sich."
msgstr "از این به بعد بیشتر وقت‌ها روی میزم معجون هست. البته با قیمت دوستانه."

msgid "Abbrechen"
msgstr "لغو"

msgid "Aber doch nicht so, ganz ohne Ausrüstung. Komm, schau dir erst meinen Laden an."
msgstr "ولی نه این‌طوری، بدون هیچ تجهیزاتی. بیا، اول یه نگاهی به مغازه‌ام بنداز."

msgid "Abgeben"
msgstr "تحویل"

msgid "Abschließbar. Theoretisch."
msgstr "قفل‌شدنی. در تئوری."

msgid "Abstand"
msgstr "فاصله"

msgid "Ach ja, Schlüssel! Die findest du da unten, aber sie zerbrechen, sobald du den Dungeon verlässt."
msgstr "آه راستی، کلیدها! آن پایین پیدایشان می‌کنی، ولی به محض اینکه از سیاه‌چال بیرون بیایی می‌شکنند."

msgid "Acht Bomben"
msgstr "هشت بمب"

msgid "Alle Items abgelegt"
msgstr "همه آیتم‌ها رها شدند"

msgid "Alle Items ablegen"
msgstr "رها کردن همه آیتم‌ها"

msgid "Alle Rucksäcke sind angebaut. Mehr gibt es im Skillbaum."
msgstr "همه کوله‌ها وصل شده‌اند. بیشترش در درخت مهارت."

msgid "Alle Werte ein bisschen hoch"
msgstr "همه ویژگی‌ها کمی بالاتر"

msgid "Alle paar Besiegten heilst du ein halbes Herz"
msgstr "هر چند دشمن که شکست دهی نیم قلب شفا می‌گیری"

msgid "Alles im Laden kostet die Hälfte"
msgstr "همه چیز در مغازه نصف قیمت است"

msgid "Also lieber ausgeben, Partner. Am besten bei mir!"
msgstr "پس بهتره خرجش کنی، رفیق. ترجیحاً پیش من!"

msgid "Am Dungeon der Glut"
msgstr "کنار سیاه‌چال اخگر"

msgid "Am Ende zerplatzt jeder Schuss in vier Funken"
msgstr "هر تیر در پایان به چهار جرقه می‌ترکد"

msgid "Am Frostgipfel"
msgstr "کنار قلهٔ یخ"

msgid "Am Glutschlund"
msgstr "کنار گلوگاه آتش"

msgid "Am Moor der Irrlichter"
msgstr "کنار مرداب شبتاب‌ها"

msgid "Am Seil rausgeklettert, wie ein Held! Aber… wo ist mein Rubin?"
msgstr "مثل یک قهرمان با طناب بالا آمدی! ولی… یاقوت من کجاست؟"

msgid "Amethyst"
msgstr "آمتیست"

msgid "An der Wispernden Wiese"
msgstr "کنار چمنزار نجواگر"

msgid "Angriffstempo"
msgstr "سرعت حمله"

msgid "Ankauf"
msgstr "خرید"

msgid "Ans Licht"
msgstr "به سوی نور"

msgid "Anzeige"
msgstr "نمایش"

msgid "Arena-Amulett"
msgstr "طلسم میدان"

msgid "Arenaherz"
msgstr "قلب میدان"

msgid "Asche"
msgstr "خاکستر"

msgid "Audio"
msgstr "صدا"

msgid "Auf der Wiese bewacht der Endboss einen Kristall. Er summt, sagt man. Bring ihn mir. Ich brauch was zum Summen. Ehrlich!"
msgstr "در چمنزار، غول آخر از یک کریستال نگهبانی می‌کند. می‌گویند وزوز می‌کند. برایم بیاورش. یک چیز وزوزی لازم دارم. راست می‌گویم!"

msgid "Auf zur Wiese, Partner. Ich hab gehört, da wächst Gold. Oder Gras."
msgstr "برویم چمنزار، رفیق. شنیده‌ام آنجا طلا می‌روید. یا علف."

msgid "Aufgeladene Riesenglut schlägt ein und explodiert"
msgstr "اخگر عظیم شارژشده فرود می‌آید و منفجر می‌شود"

msgid "Aufladen, loslassen: ein gewaltiger Feuerstrahl"
msgstr "شارژ کن، رها کن: یک پرتو آتش عظیم"

msgid "Aufwind"
msgstr "باد بالارونده"

msgid "Aus"
msgstr "خاموش"

msgid "Aus dem Dungeon flüchten? Du nimmst alles mit, was du trägst."
msgstr "از سیاه‌چال فرار کنی؟ هرچه همراهت است را نگه می‌داری."

msgid "Aus der Beute der Banditen. Jetzt deine."
msgstr "از غنیمت راهزنان. حالا مال توست."

msgid "Ausgang"
msgstr "خروجی"

msgid "Ausrüstung"
msgstr "تجهیزات"

msgid "Ausweichen"
msgstr "جاخالی"

msgid "Axt statt Feuerbällen: schwerer Schwung, Gegner bluten"
msgstr "تبر به جای گلوله آتشین: ضربه سنگین، دشمنان خونریزی می‌کنند"

msgid "Bandit-Schildträger"
msgstr "راهزن سپردار"

msgid "Bandit-Schütze"
msgstr "راهزن کماندار"

msgid "Banditenlager"
msgstr "اردوگاه راهزنان"

msgid "Beenden"
msgstr "خروج"

msgid "Behälter für %s"
msgstr "ظرف برای %s"

msgid "Beim Treffer zerplatzt der Schuss in vier Funken"
msgstr "هنگام برخورد، گلوله به چهار جرقه تبدیل می‌شود"

msgid "Beine"
msgstr "پاها"

msgid "Belegt: %d/%d"
msgstr "پر: %d/%d"

msgid "Belohnung: der nächste Dungeon und %d Gold"
msgstr "پاداش: سیاه‌چال بعدی و %d طلا"

msgid "Bergfalke"
msgstr "شاهین کوهی"

msgid "Bernstein"
msgstr "کهربا"

msgid "Beschläge aus Kupfer, Platz für einen Rubin."
msgstr "یراق مسی، جا برای یک یاقوت."

msgid "Besiege %d Gegner (%d / %d)"
msgstr "%d دشمن را شکست بده (%d / %d)"

msgid "Besiege: %s"
msgstr "شکست بده: %s"

msgid "Besiegt: %d / %d"
msgstr "شکست‌خورده: %d / %d"

msgid "Besiegte Gegner: %d"
msgstr "دشمنان شکست‌خورده: %d"

msgid "Betreten"
msgstr "ورود"

msgid "Beute aus dem Dungeon bleibt hier. Ins Lager ziehen, auf den Tisch ziehen (verkaufen) oder wieder mitnehmen. Rucksäcke aus dem Lager an den Rand ziehen (R dreht)."
msgstr "غنیمت سیاه‌چال اینجا می‌ماند. به انبار بکش، روی میز بکش (فروش) یا دوباره با خودت ببر. کوله‌ها را از انبار به لبه بکش (R می‌چرخاند)."

msgid "Beute kaufe ich dir ab: Rechtsklick im Inventar, dann liegt sie oben bei meinem Ankauf. Faire Preise. Ehrlich!"
msgstr "غنیمت را از تو می‌خرم: در کوله راست‌کلیک کن، می‌رود بالا پیش خرید من. قیمت منصفانه. صادقانه!"

msgid "Beute kaufe ich dir ab: Zieh sie einfach auf meinen Tisch. Faire Preise. Ehrlich!"
msgstr "غنیمتت را می‌خرم: فقط بکشش روی میزم. قیمت منصفانه. راست می‌گویم!"

msgid "Beute: %s"
msgstr "غنیمت: %s"

msgid "Blasebalg"
msgstr "دم آهنگری"

msgid "Blau"
msgstr "آبی"

msgid "Blau wie Gletschereis."
msgstr "آبی مثل یخ یخچال."

msgid "Blaues Herz"
msgstr "قلب آبی"

msgid "Blutphiole"
msgstr "شیشه خون"

msgid "Bogenschütze"
msgstr "کماندار"

msgid "Bombe"
msgstr "بمب"

msgid "Bomben schießen beim Explodieren Feuerbälle"
msgstr "بمب‌ها هنگام انفجار گلوله آتشین شلیک می‌کنند"

msgid "Bomben zerplatzen in kleine Bomben"
msgstr "بمب‌ها به بمب‌های کوچک تقسیم می‌شوند"

msgid "Bombengürtel"
msgstr "کمربند بمب"

msgid "Boss"
msgstr "رئیس"

msgid "Brakk der Brecher"
msgstr "براک درهم‌شکن"

msgid "Brandöl"
msgstr "روغن آتش"

msgid "Braucht: %s"
msgstr "نیاز دارد: %s"

msgid "Brennend und langsam: mehr Schaden"
msgstr "سوزان و کند: آسیب بیشتر"

msgid "Brennende, explodierende Schüsse"
msgstr "تیرهای سوزان و منفجرشونده"

msgid "Brennende, langsame Gegner und zwei blaue Herzen"
msgstr "دشمنان سوزان و کند، و دو قلب آبی"

msgid "Brennt gut in jeder Esse."
msgstr "در هر کوره‌ای خوب می‌سوزد."

msgid "Bring Egon den Stein vom Endboss (Quests), dann öffnet sich der nächste Dungeon."
msgstr "سنگ غول آخر را برای اگون بیاور (مأموریت‌ها) تا سیاه‌چال بعدی باز شود."

msgid "Bronze"
msgstr "برنز"

msgid "Bronze-Beinschienen"
msgstr "ساق‌بند برنزی"

msgid "Bronze-Bogen"
msgstr "کمان برنزی"

msgid "Bronze-Brustplatte"
msgstr "زره سینه برنزی"

msgid "Bronze-Handschuhe"
msgstr "دستکش برنزی"

msgid "Bronze-Helm"
msgstr "کلاه‌خود برنزی"

msgid "Bronze-Schwert"
msgstr "شمشیر برنزی"

msgid "Bronze-Stiefel"
msgstr "چکمه برنزی"

msgid "Bronze-Zauberstab"
msgstr "عصای برنزی"

msgid "Bronzebogen"
msgstr "کمان برنزی"

msgid "Bronzeschild"
msgstr "سپر برنزی"

msgid "Brotkanone"
msgstr "توپ نان"

msgid "Brotregen"
msgstr "باران نان"

msgid "Brust"
msgstr "سینه"

msgid "Bumerang-Haken"
msgstr "قلاب بومرنگی"

msgid "Chancen auf dem Tisch:"
msgstr "شانس‌های روی میز:"

msgid "Cyan"
msgstr "فیروزه‌ای"

msgid "Da hinten geht's in den Dungeon der Glut. Manche kommen sogar wieder raus!"
msgstr "اون پشت راه سیاه‌چال اخگره. بعضی‌ها حتی برمی‌گردن بیرون!"

msgid "Da passt das nicht hin, Partner. Mach erst Platz."
msgstr "آنجا جا نمی‌شود، رفیق. اول جا باز کن."

msgid "Dafür reicht dein Gold nicht"
msgstr "طلایت برای این کافی نیست"

msgid "Dafür reicht dein Gold nicht, Partner. Leider, leider."
msgstr "طلات برای این کافی نیست، رفیق. حیف، حیف."

msgid "Dafür wird die Ware mit jedem Dreh besser. Steht auf dem Balken, ehrlich!"
msgstr "در عوض، کالا با هر چرخش بهتر می‌شود. روی نوار نوشته، راست می‌گویم!"

msgid "Daran hängt noch ein anderer Rucksack."
msgstr "کولهٔ دیگری هنوز به این وصل است."

msgid "Darin steckt ein kleines Krabbeltier."
msgstr "یک حشره‌ی کوچک داخلش گیر افتاده."

msgid "Darin tanzt ein kleines Licht. Egon will ihn haben."
msgstr "نور کوچکی درونش می‌رقصد. اگون آن را می‌خواهد."

msgid "Darin wohnt fast ein ganzer Laden."
msgstr "تقریباً یک مغازهٔ کامل تویش جا می‌شود."

msgid "Darüber… sagen wir, hier gibt es Ratten. Große Ratten. Mit Händen."
msgstr "بیشتر از آن… بگذار بگوییم اینجا موش هست. موش‌های بزرگ. با دست."

msgid "Das Fell eines Riesen aus Eis."
msgstr "پوست یک غول یخی."

msgid "Das Gold des Runs. Stirbst du, ist es weg, außer im sicheren Platz."
msgstr "طلای این دور. اگر بمیری از دست می‌رود، مگر در خانه‌ی امن."

msgid "Das Gras raschelt. Das Gras raschelt immer. Bis es beißt."
msgstr "علف خش‌خش می‌کند. علف همیشه خش‌خش می‌کند. تا وقتی که گاز بگیرد."

msgid "Das Herz des Drachen"
msgstr "قلب اژدها"

msgid "Das Lager bekommt %d Spalten mehr. Für immer."
msgstr "انبار %d ستون بیشتر می‌گیرد. برای همیشه."

msgid "Das kann man nicht anziehen, Partner. Glaub mir, ich hab's versucht."
msgstr "این پوشیدنی نیست، رفیق. باور کن، امتحان کردم."

msgid "Das kostet zu viel Leben"
msgstr "این زندگی زیادی می‌گیرد"

msgid "Das? Das kauf ich nicht. Das will ich geschenkt! Äh … als Quest."
msgstr "این؟ این را نمی‌خرم. هدیه می‌خواهمش! اِ… به‌عنوان مأموریت."

msgid "Deckkraft"
msgstr "شفافیت"

msgid "Defensiv"
msgstr "دفاعی"

msgid "Dein Gold. Zu Hause sicher in der Dose; im Dungeon ist es beim Tod weg, außer im sicheren Platz."
msgstr "طلای تو. در خانه داخل قوطی امن است؛ در سیاه‌چال با مرگ از دست می‌رود، مگر در خانه‌ی امن."

msgid "Dein Relikt hat den Geist aufgegeben. Passiert. Ich hätte da zufällig ein neues… Freundschaftspreis!"
msgstr "یادگارت جان داد. پیش میاد. اتفاقاً یه دونه‌ی نو دارم… قیمت دوستانه!"

msgid "Dein ganzes Gold liegt rechts in deiner Dose. Bis 200 Gold ist es da sicher."
msgstr "همهٔ طلاهات توی قوطی سمت راسته. تا ۲۰۰ طلا اونجا امنه."

msgid "Deine Feuerbälle zerstören Gegner-Schüsse"
msgstr "گلوله‌های آتشین تو تیرهای دشمن را نابود می‌کنند"

msgid "Deine Items"
msgstr "آیتم‌های تو"

msgid "Deine Schüsse verfolgen Gegner"
msgstr "گلوله‌هایت دشمن را دنبال می‌کنند"

msgid "Den Quest-Stein hierher ziehen"
msgstr "سنگ مأموریت را اینجا بکش"

msgid "Den Stein aus dem Lager auf den Quest-Platz oben rechts ziehen oder hier abgeben."
msgstr "سنگ را از انبار به جای مأموریت بالا سمت راست بکش یا همین‌جا تحویل بده."

msgid "Den ersten Boss besiegt und am Seil hinausgeklettert."
msgstr "اولین رئیس را شکست دادی و با طناب بیرون آمدی."

msgid "Den gibt's aufs Haus. Ein toter Kunde kauft ja nichts mehr. Ehrlich!"
msgstr "این یکی مهمان من. مشتری مُرده که چیزی نمی‌خرد. راست می‌گویم!"

msgid "Der Balken über dem Hebel zeigt, was drin sein kann: grau ist gewöhnlich, grün solide und so weiter. Je erfahrener du bist, desto bunter wird's."
msgstr "نوار بالای اهرم نشان می‌دهد چه چیزی ممکن است بیاید: خاکستری معمولی، سبز محکم و غیره. هرچه باتجربه‌تر، رنگارنگ‌تر."

msgid "Der Boss hatte einen, ich weiß es! Bring ihn mir, wenn du einen findest. Ich warte. Ungeduldig."
msgstr "رئیس یکی داشت، می‌دانم! اگر پیدا کردی برایم بیاور. منتظرم. بی‌صبرانه."

msgid "Der Endboss am Frostgipfel hat einen Frost-Aquamarin. Bring ihn Egon."
msgstr "غول آخر قلهٔ یخ یک زبرجد یخی دارد. آن را برای اگون بیاور."

msgid "Der Endboss der Wispernden Wiese bewacht einen Wiesenkristall. Bring ihn Egon."
msgstr "غول آخر چمنزار نجواگر از کریستال چمنزار نگهبانی می‌کند. آن را برای اگون بیاور."

msgid "Der Endboss im Dungeon der Glut hütet einen Glutrubin. Bring ihn Egon."
msgstr "غول آخر سیاه‌چال اخگر یک یاقوت اخگر دارد. آن را برای اگون بیاور."

msgid "Der Endboss im Moor der Irrlichter trägt einen Irrlicht-Opal. Bring ihn Egon."
msgstr "غول آخر مرداب شبتاب‌ها یک عقیق شبتاب دارد. آن را برای اگون بیاور."

msgid "Der Feuerstrahl biegt sich zum Gegner"
msgstr "پرتو آتش به سمت دشمن خم می‌شود"

msgid "Der Glutrubin! Echt! Also … ich hab nie gezweifelt."
msgstr "یاقوت اخگر! واقعی! خب… من هیچ‌وقت شک نکردم."

msgid "Der Händler im Dungeon zahlt 2 Gold mehr für jede Beute."
msgstr "فروشندهٔ سیاه‌چال برای هر غنیمت ۲ طلا بیشتر می‌دهد."

msgid "Der Händler kauft Beute: Tab, Rechtsklick"
msgstr "فروشنده غنیمت می‌خرد: Tab، کلیک راست"

msgid "Der Opal! Er leuchtet! Fast so hell wie meine Zukunft."
msgstr "عقیق! می‌درخشد! تقریباً به روشنی آینده‌ام."

msgid "Der Rubin gehört mir! … Gehörte."
msgstr "یاقوت مال من است! … بود."

msgid "Der Stein liegt in deinem Inventar!"
msgstr "سنگ در کیف توست!"

msgid "Der Stein liegt in deinem Lager!"
msgstr "سنگ در انبار توست!"

msgid "Der Stein nimmt dein Opfer an"
msgstr "سنگ قربانی تو را می‌پذیرد"

msgid "Der Vulkandrache im Glutschlund hat ein Herz aus Glut. Bring es Egon."
msgstr "اژدهای آتشفشان در گلوگاه آتش قلبی از اخگر دارد. آن را برای اگون بیاور."

msgid "Der Weg nach unten ist frei!"
msgstr "راه پایین باز شد!"

msgid "Der Wildhüter"
msgstr "شکاربان"

msgid "Der einzige auch, aber das sagen wir keinem."
msgstr "تنها مشتری هم هستی، ولی این را به کسی نمی‌گوییم."

msgid "Der sichere Platz wird eine Spalte breiter."
msgstr "جای امن یک ستون پهن‌تر می‌شود."

msgid "Diamant"
msgstr "الماس"

msgid "Diamantherz"
msgstr "قلب الماس"

msgid "Dick, weich und eiskalt."
msgstr "ضخیم، نرم و یخ‌زده."

msgid "Dicke"
msgstr "ضخامت"

msgid "Dicke Haut"
msgstr "پوست کلفت"

msgid "Die Fenstergröße gilt nur im Fenster-Modus."
msgstr "اندازه‌ی پنجره فقط در حالت پنجره‌ای اعمال می‌شود."

msgid "Die Tür ist offen. Geh in den nächsten Raum."
msgstr "در باز است. به اتاق بعدی برو."

msgid "Die Waffe des Bogenschützen: Pfeile aufladen und loslassen, weit und stark"
msgstr "سلاح کماندار: تیر را پر کن و رها کن، دور و قوی"

msgid "Die Waffe des Kriegers: ein Schwertschwung trifft alle vor dir"
msgstr "سلاح جنگجو: یک ضربه‌ی شمشیر به همه‌ی جلوی تو می‌خورد"

msgid "Die Waffe des Magiers: schießt Feuerbälle"
msgstr "سلاح جادوگر: گلوله‌های آتشین شلیک می‌کند"

msgid "Diebeshand"
msgstr "دست دزد"

msgid "Dietrich"
msgstr "شاه‌کلید"

msgid "Distelkrähe"
msgstr "کلاغ خارزار"

msgid "Doppelschuss"
msgstr "شلیک دوتایی"

msgid "Dornenpanzer"
msgstr "زره خاردار"

msgid "Dose"
msgstr "قوطی"

msgid "Dose: %d Gold. Bis %d ist es sicher."
msgstr "قوطی: %d طلا. تا %d امن است."

msgid "Dose: Gold hierher ziehen"
msgstr "قوطی: طلا را اینجا بکش"

msgid "Dose: hier liegt dein ganzes Gold"
msgstr "قوطی: همهٔ طلاهات اینجاست"

msgid "Drache"
msgstr "اژدها"

msgid "Drachenatem"
msgstr "نفس اژدها"

msgid "Drachenhaut"
msgstr "پوست اژدها"

msgid "Drachenherz"
msgstr "قلب اژدها"

msgid "Drachenleder"
msgstr "چرم اژدها"

msgid "Drachenmantel"
msgstr "ردای اژدها"

msgid "Drei Funken folgen dir und schießen"
msgstr "سه جرقه دنبالت می‌آیند و شلیک می‌کنند"

msgid "Drei Schlüssel, Rabatt im Laden"
msgstr "سه کلید، تخفیف در مغازه"

msgid "Drei blaue Herzen"
msgstr "سه قلب آبی"

msgid "Drei blaue Herzen und manchmal ausweichen"
msgstr "سه قلب آبی و گاهی جاخالی"

msgid "Dreifachschuss"
msgstr "شلیک سه‌تایی"

msgid "Dreizack-Rune"
msgstr "رون سه‌شاخه"


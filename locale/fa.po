msgstr "تیرهای بزرگ و سنگین با پس‌زنی زیاد"

msgid "Großer Heiltrank"
msgstr "معجون شفای بزرگ"

msgid "Grubenhacke"
msgstr "کلنگ معدن"

msgid "Gruftgespenst"
msgstr "شبح دخمه"

msgid "Gruftschild"
msgstr "سپر دخمه"

msgid "Größere Bomben und drei Bomben"
msgstr "بمب‌های بزرگ‌تر و سه بمب"

msgid "Größere Bomben, und keine tut dir weh"
msgstr "بمب‌های بزرگ‌تر، و هیچ‌کدام به تو آسیب نمی‌زنند"

msgid "Größere Dose"
msgstr "قوطی بزرگ‌تر"

msgid "Größere Feuerbälle, mehr Schaden"
msgstr "گلوله‌های آتشین بزرگ‌تر، آسیب بیشتر"


msgid ""
msgstr ""
"Content-Type: text/plain; charset=UTF-8\n"
"Language: es\n"

msgid "%d Gold"
msgstr "%d de oro"

msgid "%d Herzen"
msgstr "%d corazones"

msgid "%d Skillpunkte"
msgstr "%d puntos de habilidad"

msgid "%s: ab Stufe %d"
msgstr "%s: desde el nivel %d"

msgid "%s: nach %s"
msgstr "%s: después de %s"

msgid "3 % Chance auf R3 bei Egon."
msgstr "3 % de probabilidad de R3 donde Egon."

msgid "300 Gold mehr sind in der Dose sicher."
msgstr "300 de oro más están a salvo en la lata."

msgid "5 % mehr Chance auf R2 bei Egon."
msgstr "5 % más de probabilidad de R2 donde Egon."

msgid "Ab Spielerstufe %d"
msgstr "Desde el nivel de jugador %d"

msgid "Ab Stufe %d"
msgstr "Desde el nivel %d"

msgid "Ab jetzt liegen öfter Tränke auf meinem Tisch. Zum Freundschaftspreis, versteht sich."
msgstr "A partir de ahora habrá pociones en mi mesa a menudo. A precio de amigo, claro."

msgid "Abbrechen"
msgstr "Cancelar"

msgid "Aber doch nicht so, ganz ohne Ausrüstung. Komm, schau dir erst meinen Laden an."
msgstr "Pero así no, sin nada de equipo. Ven, mira primero mi tienda."

msgid "Abgeben"
msgstr "Entregar"

msgid "Abschließbar. Theoretisch."
msgstr "Con cerradura. En teoría."

msgid "Abstand"
msgstr "Separación"

msgid "Ach ja, Schlüssel! Die findest du da unten, aber sie zerbrechen, sobald du den Dungeon verlässt."
msgstr "¡Ah, sí, las llaves! Las encontrarás ahí abajo, pero se rompen en cuanto sales de la mazmorra."

msgid "Acht Bomben"
msgstr "Ocho bombas"

msgid "Alle Items abgelegt"
msgstr "Todos los objetos soltados"

msgid "Alle Items ablegen"
msgstr "Soltar todos los objetos"

msgid "Alle Rucksäcke sind angebaut. Mehr gibt es im Skillbaum."
msgstr "Todas las mochilas están acopladas. Hay más en el árbol de habilidades."

msgid "Alle Werte ein bisschen hoch"
msgstr "Todas las estadísticas suben un poco"

msgid "Alle paar Besiegten heilst du ein halbes Herz"
msgstr "Cada pocos enemigos derrotados curas medio corazón"

msgid "Alles im Laden kostet die Hälfte"
msgstr "Todo en la tienda cuesta la mitad"

msgid "Also lieber ausgeben, Partner. Am besten bei mir!"
msgstr "Así que mejor gástalo, socio. ¡A ser posible, conmigo!"

msgid "Am Dungeon der Glut"
msgstr "Junto a la Mazmorra de las Brasas"

msgid "Am Ende zerplatzt jeder Schuss in vier Funken"
msgstr "Al final cada disparo estalla en cuatro chispas"

msgid "Am Frostgipfel"
msgstr "En el Pico Helado"

msgid "Am Glutschlund"
msgstr "En las Fauces Ardientes"

msgid "Am Moor der Irrlichter"
msgstr "Junto al Pantano de los Fuegos Fatuos"

msgid "Am Seil rausgeklettert, wie ein Held! Aber… wo ist mein Rubin?"
msgstr "¡Saliste trepando por la cuerda como un héroe! Pero… ¿dónde está mi rubí?"

msgid "Amethyst"
msgstr "Amatista"

msgid "An der Wispernden Wiese"
msgstr "Junto a la Pradera Susurrante"

msgid "Anführer: %s"
msgstr "Cabecilla: %s"

msgid "Angriffstempo"
msgstr "Velocidad de ataque"

msgid "Ankauf"
msgstr "Compra"

msgid "Ans Licht"
msgstr "Hacia la luz"

msgid "Anzeige"
msgstr "Pantalla"

msgid "Arena-Amulett"
msgstr "Amuleto de la arena"

msgid "Arenaherz"
msgstr "Corazón de la arena"

msgid "Asche"
msgstr "Ceniza"

msgid "Audio"
msgstr "Audio"

msgid "Auf der Wiese bewacht der Endboss einen Kristall. Er summt, sagt man. Bring ihn mir. Ich brauch was zum Summen. Ehrlich!"
msgstr "En la pradera el jefe final guarda un cristal. Dicen que zumba. Tráemelo. Necesito algo que zumbe. ¡En serio!"

msgid "Auf zur Wiese, Partner. Ich hab gehört, da wächst Gold. Oder Gras."
msgstr "A la pradera, socio. Dicen que allí crece oro. O hierba."

msgid "Aufgeladene Riesenglut schlägt ein und explodiert"
msgstr "Las brasas gigantes cargadas impactan y explotan"

msgid "Aufladen, loslassen: ein gewaltiger Feuerstrahl"
msgstr "Carga, suelta: un rayo de fuego enorme"

msgid "Aufwind"
msgstr "Corriente ascendente"

msgid "Aus"
msgstr "Desactivado"

msgid "Aus dem Dungeon flüchten? Du nimmst alles mit, was du trägst."
msgstr "¿Huir de la mazmorra? Te llevas todo lo que cargas."

msgid "Aus der Beute der Banditen. Jetzt deine."
msgstr "Del botín de los bandidos. Ahora es tuyo."

msgid "Ausgang"
msgstr "Salida"

msgid "Ausrüstung"
msgstr "Equipo"

msgid "Ausweichen"
msgstr "Esquivar"

msgid "Axt statt Feuerbällen: schwerer Schwung, Gegner bluten"
msgstr "Un hacha en vez de bolas de fuego: golpe pesado, los enemigos sangran"

msgid "Bandit-Schildträger"
msgstr "Bandido escudero"

msgid "Bandit-Schütze"
msgstr "Bandido arquero"

msgid "Banditenlager"
msgstr "Campamento bandido"

msgid "Beenden"
msgstr "Salir"

msgid "Behälter für %s"
msgstr "Contenedor para %s"

msgid "Beim Treffer zerplatzt der Schuss in vier Funken"
msgstr "Al impactar, el disparo estalla en cuatro chispas"

msgid "Beine"
msgstr "Piernas"

msgid "Belegt: %d/%d"
msgstr "Ocupado: %d/%d"

msgid "Belohnung: der nächste Dungeon und %d Gold"
msgstr "Recompensa: la siguiente mazmorra y %d de oro"

msgid "Bergfalke"
msgstr "Halcón de montaña"

msgid "Bernstein"
msgstr "Ámbar"

msgid "Beschläge aus Kupfer, Platz für einen Rubin."
msgstr "Herrajes de cobre, cabe un rubí."

msgid "Besiege %d Gegner (%d / %d)"
msgstr "Derrota a %d enemigos (%d / %d)"

msgid "Besiege: %s"
msgstr "Derrota a: %s"

msgid "Besiegt: %d / %d"
msgstr "Derrotados: %d / %d"

msgid "Besiegte Gegner: %d"
msgstr "Enemigos derrotados: %d"

msgid "Betreten"
msgstr "Entrar"

msgid "Beute aus dem Dungeon bleibt hier. Ins Lager ziehen, auf den Tisch ziehen (verkaufen) oder wieder mitnehmen. Rucksäcke aus dem Lager an den Rand ziehen (R dreht)."
msgstr "El botín de la mazmorra se queda aquí. Arrástralo al almacén, a la mesa (vender) o llévatelo otra vez. Arrastra mochilas del almacén al borde (R gira)."

msgid "Beute kaufe ich dir ab: Rechtsklick im Inventar, dann liegt sie oben bei meinem Ankauf. Faire Preise. Ehrlich!"
msgstr "Te compro el botín: clic derecho en el inventario y va a mi compra arriba. Precios justos. ¡De verdad!"

msgid "Beute kaufe ich dir ab: Zieh sie einfach auf meinen Tisch. Faire Preise. Ehrlich!"
msgstr "Te compro el botín: arrástralo a mi mesa. Precios justos. ¡En serio!"

msgid "Beute: %s"
msgstr "Botín: %s"

msgid "Blasebalg"
msgstr "Fuelle"

msgid "Blau"
msgstr "Azul"

msgid "Blau wie Gletschereis."
msgstr "Azul como el hielo de un glaciar."

msgid "Blaues Herz"
msgstr "Corazón azul"

msgid "Blutphiole"
msgstr "Vial de sangre"

msgid "Bogenschütze"
msgstr "Arquero"

msgid "Bombe"
msgstr "Bomba"

msgid "Bomben schießen beim Explodieren Feuerbälle"
msgstr "Las bombas disparan bolas de fuego al explotar"

msgid "Bomben zerplatzen in kleine Bomben"
msgstr "Las bombas estallan en bombitas"

msgid "Bombengürtel"
msgstr "Cinturón de bombas"

msgid "Boss"
msgstr "Jefe"

msgid "Brakk der Brecher"
msgstr "Brakk el Rompedor"

msgid "Brandöl"
msgstr "Aceite ardiente"

msgid "Braucht: %s"
msgstr "Necesita: %s"

msgid "Brennend und langsam: mehr Schaden"
msgstr "Ardiendo y lento: más daño"

msgid "Brennende, explodierende Schüsse"
msgstr "Disparos ardientes que explotan"

msgid "Brennende, langsame Gegner und zwei blaue Herzen"
msgstr "Enemigos ardiendo y lentos, y dos corazones azules"

msgid "Brennt gut in jeder Esse."
msgstr "Arde bien en cualquier fragua."

msgid "Bring Egon den Stein vom Endboss (Quests), dann öffnet sich der nächste Dungeon."
msgstr "Lleva a Egon la piedra del jefe final (Misiones) y se abrirá la siguiente mazmorra."

msgid "Bronze"
msgstr "Bronce"

msgid "Bronze-Beinschienen"
msgstr "Grebas de bronce"

msgid "Bronze-Bogen"
msgstr "Arco de bronce"

msgid "Bronze-Brustplatte"
msgstr "Peto de bronce"

msgid "Bronze-Handschuhe"
msgstr "Guantes de bronce"

msgid "Bronze-Helm"
msgstr "Casco de bronce"

msgid "Bronze-Schwert"
msgstr "Espada de bronce"

msgid "Bronze-Stiefel"
msgstr "Botas de bronce"

msgid "Bronze-Zauberstab"
msgstr "Varita de bronce"

msgid "Bronzebogen"
msgstr "Arco de bronce"

msgid "Bronzeschild"
msgstr "Escudo de bronce"

msgid "Brotkanone"
msgstr "Cañón de pan"

msgid "Brotregen"
msgstr "Lluvia de pan"

msgid "Brust"
msgstr "Pecho"

msgid "Bumerang-Haken"
msgstr "Gancho bumerán"

msgid "Chancen auf dem Tisch:"
msgstr "Probabilidades en la mesa:"

msgid "Cyan"
msgstr "Cian"

msgid "Da hinten geht's in den Dungeon der Glut. Manche kommen sogar wieder raus!"
msgstr "Ahí detrás se entra a la Mazmorra de las Brasas. ¡Algunos hasta salen!"

msgid "Da passt das nicht hin, Partner. Mach erst Platz."
msgstr "Eso no cabe ahí, socio. Haz sitio primero."

msgid "Dafür reicht dein Gold nicht"
msgstr "No tienes oro suficiente para eso"

msgid "Dafür reicht dein Gold nicht, Partner. Leider, leider."
msgstr "No te alcanza el oro, socio. Qué pena, qué pena."

msgid "Dafür wird die Ware mit jedem Dreh besser. Steht auf dem Balken, ehrlich!"
msgstr "Pero la mercancía mejora con cada giro. Lo pone en la barra, ¡de verdad!"

msgid "Daran hängt noch ein anderer Rucksack."
msgstr "Otra mochila sigue colgada de esta."

msgid "Darin steckt ein kleines Krabbeltier."
msgstr "Dentro hay un bichito atrapado."

msgid "Darin tanzt ein kleines Licht. Egon will ihn haben."
msgstr "Dentro baila una lucecita. Egon la quiere."

msgid "Darin wohnt fast ein ganzer Laden."
msgstr "Dentro cabe casi una tienda entera."

msgid "Darüber… sagen wir, hier gibt es Ratten. Große Ratten. Mit Händen."
msgstr "Por encima… digamos que aquí hay ratas. Ratas grandes. Con manos."

msgid "Das Fell eines Riesen aus Eis."
msgstr "La piel de un gigante de hielo."

msgid "Das Gold des Runs. Stirbst du, ist es weg, außer im sicheren Platz."
msgstr "El oro de esta partida. Si mueres, se pierde, salvo en el espacio seguro."

msgid "Das Gras raschelt. Das Gras raschelt immer. Bis es beißt."
msgstr "La hierba cruje. La hierba siempre cruje. Hasta que muerde."

msgid "Das Herz des Drachen"
msgstr "El corazón del dragón"

msgid "Das Lager bekommt %d Spalten mehr. Für immer."
msgstr "El almacén gana %d columnas más. Para siempre."

msgid "Das kann man nicht anziehen, Partner. Glaub mir, ich hab's versucht."
msgstr "Eso no se puede poner, socio. Créeme, lo he intentado."

msgid "Das kostet zu viel Leben"
msgstr "Eso cuesta demasiada vida"

msgid "Das? Das kauf ich nicht. Das will ich geschenkt! Äh … als Quest."
msgstr "¿Eso? No lo compro. ¡Lo quiero regalado! Eh… como misión."

msgid "Deckkraft"
msgstr "Opacidad"

msgid "Defensiv"
msgstr "Defensivo"

msgid "Dein Gold. Zu Hause sicher in der Dose; im Dungeon ist es beim Tod weg, außer im sicheren Platz."
msgstr "Tu oro. En casa, seguro en la lata; en la mazmorra se pierde al morir, salvo en el espacio seguro."

msgid "Dein Relikt hat den Geist aufgegeben. Passiert. Ich hätte da zufällig ein neues… Freundschaftspreis!"
msgstr "Tu reliquia ha dicho adiós. Pasa. Casualmente tengo una nueva… ¡precio de amigo!"

msgid "Dein ganzes Gold liegt rechts in deiner Dose. Bis 200 Gold ist es da sicher."
msgstr "Todo tu oro está en tu lata, a la derecha. Hasta 200 de oro está a salvo."

msgid "Deine Feuerbälle zerstören Gegner-Schüsse"
msgstr "Tus bolas de fuego destruyen los disparos enemigos"

msgid "Deine Items"
msgstr "Tus objetos"

msgid "Deine Schüsse verfolgen Gegner"
msgstr "Tus disparos persiguen a los enemigos"

msgid "Den Quest-Stein hierher ziehen"
msgstr "Arrastra aquí la piedra de la misión"

msgid "Den Stein aus dem Lager auf den Quest-Platz oben rechts ziehen oder hier abgeben."
msgstr "Arrastra la piedra del almacén al lugar de misión arriba a la derecha, o entrégala aquí."

msgid "Den ersten Boss besiegt und am Seil hinausgeklettert."
msgstr "Venciste al primer jefe y saliste trepando por la cuerda."

msgid "Den gibt's aufs Haus. Ein toter Kunde kauft ja nichts mehr. Ehrlich!"
msgstr "Este va por cuenta de la casa. Un cliente muerto ya no compra nada. ¡De verdad!"

msgid "Der Balken über dem Hebel zeigt, was drin sein kann: grau ist gewöhnlich, grün solide und so weiter. Je erfahrener du bist, desto bunter wird's."
msgstr "La barra sobre la palanca muestra lo que puede salir: gris es común, verde sólido, etc. Cuanta más experiencia tengas, más colores."

msgid "Der Boss hatte einen, ich weiß es! Bring ihn mir, wenn du einen findest. Ich warte. Ungeduldig."
msgstr "¡El jefe tenía uno, lo sé! Tráemelo si encuentras uno. Esperaré. Con impaciencia."

msgid "Der Endboss am Frostgipfel hat einen Frost-Aquamarin. Bring ihn Egon."
msgstr "El jefe final del Pico Helado tiene una aguamarina helada. Llévasela a Egon."

msgid "Der Endboss der Wispernden Wiese bewacht einen Wiesenkristall. Bring ihn Egon."
msgstr "El jefe final de la Pradera Susurrante guarda un cristal de pradera. Llévaselo a Egon."

msgid "Der Endboss im Dungeon der Glut hütet einen Glutrubin. Bring ihn Egon."
msgstr "El jefe final de la Mazmorra de las Brasas guarda un rubí de brasa. Llévaselo a Egon."

msgid "Der Endboss im Moor der Irrlichter trägt einen Irrlicht-Opal. Bring ihn Egon."
msgstr "El jefe final del Pantano de los Fuegos Fatuos lleva un ópalo fatuo. Llévaselo a Egon."

msgid "Der Feuerstrahl biegt sich zum Gegner"
msgstr "El rayo de fuego se curva hacia el enemigo"

msgid "Der Glutrubin! Echt! Also … ich hab nie gezweifelt."
msgstr "¡El rubí de brasa! ¡De verdad! Bueno… nunca lo dudé."

msgid "Der Händler im Dungeon zahlt 2 Gold mehr für jede Beute."
msgstr "El mercader de la mazmorra paga 2 de oro más por cada botín."

msgid "Der Händler kauft Beute: Tab, Rechtsklick"
msgstr "El mercader compra botín: Tab, clic derecho"

msgid "Der Opal! Er leuchtet! Fast so hell wie meine Zukunft."
msgstr "¡El ópalo! ¡Brilla! Casi tanto como mi futuro."

msgid "Der Rubin gehört mir! … Gehörte."
msgstr "¡El rubí es mío! … Era."

msgid "Der Stein liegt in deinem Inventar!"
msgstr "¡La piedra está en tu inventario!"

msgid "Der Stein liegt in deinem Lager!"
msgstr "¡La piedra está en tu almacén!"

msgid "Der Stein nimmt dein Opfer an"
msgstr "La piedra acepta tu sacrificio"

msgid "Der Vulkandrache im Glutschlund hat ein Herz aus Glut. Bring es Egon."
msgstr "El dragón volcánico de las Fauces Ardientes tiene un corazón de brasas. Llévaselo a Egon."

msgid "Der Weg nach unten ist frei!"
msgstr "¡El camino hacia abajo está libre!"

msgid "Der Wildhüter"
msgstr "El Guardabosques"

msgid "Der einzige auch, aber das sagen wir keinem."
msgstr "El único también, pero eso no se lo decimos a nadie."

msgid "Der sichere Platz wird eine Spalte breiter."
msgstr "El lugar seguro gana una columna."

msgid "Diamant"
msgstr "Diamante"

msgid "Diamantherz"
msgstr "Corazón de diamante"

msgid "Dick, weich und eiskalt."
msgstr "Grueso, suave y helado."

msgid "Dicke"
msgstr "Grosor"

msgid "Dicke Haut"
msgstr "Piel gruesa"

msgid "Die Fenstergröße gilt nur im Fenster-Modus."
msgstr "El tamaño de ventana solo se aplica en modo ventana."

msgid "Die Tür ist offen. Geh in den nächsten Raum."
msgstr "La puerta está abierta. Entra en la siguiente sala."

msgid "Die Waffe des Bogenschützen: Pfeile aufladen und loslassen, weit und stark"
msgstr "El arma del arquero: carga flechas y suéltalas, lejos y fuerte"

msgid "Die Waffe des Kriegers: ein Schwertschwung trifft alle vor dir"
msgstr "El arma del guerrero: un tajo golpea a todos frente a ti"

msgid "Die Waffe des Magiers: schießt Feuerbälle"
msgstr "El arma del mago: dispara bolas de fuego"

msgid "Diebeshand"
msgstr "Mano de ladrón"

msgid "Dietrich"
msgstr "Ganzúa"

msgid "Distelkrähe"
msgstr "Cuervo Cardo"

msgid "Doppelschuss"
msgstr "Disparo doble"

msgid "Dornenpanzer"
msgstr "Armadura de espinas"

msgid "Dose"
msgstr "Lata"

msgid "Dose: %d Gold. Bis %d ist es sicher."
msgstr "Lata: %d de oro. Seguro hasta %d."

msgid "Dose: Gold hierher ziehen"
msgstr "Lata: arrastra el oro aquí"

msgid "Dose: hier liegt dein ganzes Gold"
msgstr "Lata: aquí está todo tu oro"

msgid "Drache"
msgstr "Dragón"

msgid "Drachenatem"
msgstr "Aliento de dragón"

msgid "Drachenhaut"
msgstr "Piel de dragón"

msgid "Drachenherz"
msgstr "Corazón de dragón"

msgid "Drachenleder"
msgstr "Cuero de dragón"

msgid "Drachenmantel"
msgstr "Capa de dragón"

msgid "Drei Funken folgen dir und schießen"
msgstr "Tres chispas te siguen y disparan"

msgid "Drei Schlüssel, Rabatt im Laden"
msgstr "Tres llaves, descuento en la tienda"

msgid "Drei blaue Herzen"
msgstr "Tres corazones azules"

msgid "Drei blaue Herzen und manchmal ausweichen"
msgstr "Tres corazones azules y a veces esquivas"

msgid "Dreifachschuss"
msgstr "Disparo triple"

msgid "Dreizack-Rune"
msgstr "Runa del tridente"

msgid "Dreißig Münzen und zehn Schlüssel"
msgstr "Treinta monedas y diez llaves"

msgid "Du bist gefallen"
msgstr "Has caído"

msgid "Du bist schon gesund"
msgstr "Ya estás sano"

msgid "Du brauchst einen Schlüssel"
msgstr "Necesitas una llave"

msgid "Du fliegst und bist nach Treffern länger geschützt"
msgstr "Vuelas y estás protegido más tiempo tras los golpes"

msgid "Du fliegst und schießt schneller"
msgstr "Vuelas y disparas más rápido"

msgid "Du fliegst über Fallen und Abgründe, Schaden +1"
msgstr "Vuelas sobre trampas y abismos, daño +1"

msgid "Du fliegst über Fallen und Abgründe, zwei blaue Herzen"
msgstr "Vuelas sobre trampas y abismos, dos corazones azules"

msgid "Du fliegst, Schüsse fliegen schneller und weiter"
msgstr "Vuelas, los disparos van más rápido y más lejos"

msgid "Du fliegst, Tempo hoch, Schüsse stoßen Gegner weg"
msgstr "Vuelas, más velocidad, los disparos empujan a los enemigos"

msgid "Du hast den Dungeon bezwungen!"
msgstr "¡Has conquistado la mazmorra!"

msgid "Du hast nicht genug Leben"
msgstr "No tienes suficiente vida"

msgid "Du läufst schneller"
msgstr "Corres más rápido"

msgid "Du schießt Brotlaibe. Getroffene Gegner vergessen dich und rennen weg"
msgstr "Disparas hogazas de pan. Los enemigos alcanzados te olvidan y huyen"

msgid "Du schießt auch nach hinten"
msgstr "También disparas hacia atrás"

msgid "Du schießt etwas schneller."
msgstr "Disparas un poco más rápido."

msgid "Du schießt schneller"
msgstr "Disparas más rápido"

msgid "Du wirfst Bomben statt Feuerbällen"
msgstr "Lanzas bombas en vez de bolas de fuego"

msgid "Du wirfst Wurfsterne, getroffene Gegner bluten"
msgstr "Lanzas estrellas arrojadizas, los enemigos alcanzados sangran"

msgid "Du wirst größer: mehr Herzen und Schaden, leichter zu treffen"
msgstr "Te haces más grande: más corazones y daño, más fácil de alcanzar"

msgid "Du wirst kleiner und schneller"
msgstr "Te haces más pequeño y rápido"

msgid "Du wirst kleiner: schwerer zu treffen, schneller"
msgstr "Te encoges: más difícil de alcanzar, más rápido"

msgid "Du wirst viel größer und stärker, aber langsamer"
msgstr "Te haces mucho más grande y fuerte, pero más lento"

msgid "Du wirst winzig und manchmal weichst du aus"
msgstr "Te vuelves diminuto y a veces esquivas"

msgid "Du wirst zu Nebel: du fliegst und weichst manchmal aus"
msgstr "Te conviertes en niebla: vuelas y a veces esquivas"

msgid "Du wirst zum Geist: du schwebst durch Steine, deine Schüsse auch"
msgstr "Te conviertes en fantasma: atraviesas rocas flotando, y tus disparos también"

msgid "Dungeon der Glut"
msgstr "Mazmorra de las Brasas"

msgid "Dungeon-Brett"
msgstr "Tablón de mazmorras"

msgid "Dungeons"
msgstr "Mazmorras"

msgid "Dunkle Flügel"
msgstr "Alas oscuras"

msgid "Dunkler Ritter"
msgstr "Caballero oscuro"

msgid "Dunkler Schütze"
msgstr "Arquero oscuro"

msgid "Dunkler Zauberstab"
msgstr "Varita oscura"

msgid "Durch Gegner hindurch und von Wand zu Wand"
msgstr "A través de enemigos y de pared a pared"

msgid "Durch Steine, und manchmal fliehen Gegner"
msgstr "A través de rocas, y a veces los enemigos huyen"

msgid "Durchschlag, Abprallen und Zerplatzen"
msgstr "Perfora, rebota y estalla"

msgid "Dämon"
msgstr "Demonio"

msgid "Dünne Haut aus einem Fledermausflügel."
msgstr "Piel fina del ala de un murciélago."

msgid "E: Bombe · Tab: Inventar · M: Karte · Esc: Pause"
msgstr "E: bomba · Tab: inventario · M: mapa · Esc: pausa"

msgid "EXP: +%d"
msgstr "EXP: +%d"

msgid "Ebene %d"
msgstr "Piso %d"

msgid "Ebene: %d"
msgstr "Piso: %d"

msgid "Effekte"
msgstr "Efectos"

msgid "Egon Ehrlich, sehr erfreut. Ehrlich ist mein Name, ehrlich mein Geschäft. Ehrlich!"
msgstr "Egon Honrado, encantado. Honrado es mi nombre, honrado mi negocio. ¡De verdad!"

msgid "Egon hat gerade keinen Auftrag."
msgstr "Egon no tiene ningún encargo ahora."

msgid "Egon hat gesagt, hier unten ist es sicher. Egon hat gelogen. – B."
msgstr "Egon dijo que aquí abajo es seguro. Egon mintió. – B."

msgid "Egon könnte klauen!"
msgstr "¡Egon podría robar!"

msgid "Egon war nie hier, sagt er. Von wem sind dann die angesengten Stiefelspuren?"
msgstr "Egon nunca estuvo aquí, dice. ¿Y de quién son estas huellas de botas chamuscadas?"

msgid "Egons Augen werden ganz groß."
msgstr "A Egon se le ponen los ojos como platos."

msgid "Egons Glutrubin"
msgstr "El rubí de brasa de Egon"

msgid "Egons Laden"
msgstr "La tienda de Egon"

msgid "Egons Laterne ging nach einer Stunde aus. Garantie: eine Stunde."
msgstr "La linterna de Egon se apagó al cabo de una hora. Garantía: una hora."

msgid "Eigene"
msgstr "Personalizado"

msgid "Eigene Explosionen heilen dich"
msgstr "Tus propias explosiones te curan"

msgid "Ein Anführer!"
